# Build output
bin/
obj/
artifacts/
TestResults/
*.user
*.suo
.vs/
.idea/
*.swp

# Local runtime data of Agent Studio. The daily journal (.agentstudio/bitacora/) and the Markdown memory
# (.agentstudio/memory/) ARE versioned; databases and captured evidence are not.
.agentstudio/*.db
.agentstudio/*.db-shm
.agentstudio/*.db-wal
.agentstudio/evidence/
.agentstudio/tmp/
*.db
*.db-shm
*.db-wal

# Never commit credentials
*.pfx
*.snk
.env
.env.*

# Git worktrees created for parallel agents
.claude/worktrees/

# Monaco editor resources: downloaded by tools/assets/fetch-monaco.ps1, never versioned
src/AgentStudio.Desktop/Assets/monaco/

# xterm.js is downloaded by tools/assets/fetch-xterm.ps1 (MIT), never versioned
src/AgentStudio.Desktop/Assets/xterm/
