<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway harness for the D6 spike (docs/adr/0015-lienzo-nodify.md). It lives outside AgentStudio.slnx and is
       never built by it. The root Directory.Packages.props would enforce central versions, so the harness opts out
       and pins its own. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>NodifySpike</RootNamespace>
    <AssemblyName>NodifySpike</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nodify" Version="7.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentStudio.Domain\AgentStudio.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real design tokens of the app: the Desktop file itself is compiled into the harness, not copied. -->
    <Page Include="..\..\src\AgentStudio.Desktop\Themes\Dark.xaml" Link="Themes\AppDark.xaml" />
  </ItemGroup>

</Project>
