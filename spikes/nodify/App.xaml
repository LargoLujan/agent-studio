<Application x:Class="NodifySpike.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 1. The real tokens of the app: src/AgentStudio.Desktop/Themes/Dark.xaml, compiled in from the Desktop project. -->
        <ResourceDictionary Source="Themes/AppDark.xaml"/>
        <!-- 2. Nodify: its controls and its own dark colours. 3. Its focus visuals, which Dark.xaml does not merge.
             The Nodify colour keys are then repainted from the app tokens in App.OnStartup (NodifyThemeTokens.Apply). -->
        <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Dark.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/FocusVisual.xaml"/>
        <!-- 4. Status colours and brushes. 5. Canvas templates and styles. -->
        <ResourceDictionary Source="Themes/StatusColors.xaml"/>
        <ResourceDictionary Source="Themes/CanvasStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
