<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="https://miroiu.github.io/nodify"
                    xmlns:vm="clr-namespace:NodifySpike.ViewModels"
                    xmlns:views="clr-namespace:NodifySpike.Views">

  <!--
    Everything the canvas needs on top of Nodify's themed controls. The patterns WP6 reuses are marked [P1]..[P4]
    (see docs/adr/0015-lienzo-nodify.md).
  -->

  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  <views:StatusToBrushConverter x:Key="StatusToBrush"/>
  <views:HasTextToVisibilityConverter x:Key="HasTextToVisibility"/>

  <!-- [P1] Connector styles. Nodify only updates Anchor while IsConnected is true, so both are bound here, once, for every
       connector of every node, and the node template does not have to repeat them. The branch outputs of a Condition
       are coloured Sí = success, No = error, and labelled through Header. -->
  <Style TargetType="{x:Type nodify:NodeInput}" BasedOn="{StaticResource {x:Type nodify:NodeInput}}">
    <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}"/>
    <Setter Property="IsConnected" Value="{Binding IsConnected}"/>
    <Setter Property="Header" Value="{Binding Label}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
  </Style>

  <Style TargetType="{x:Type nodify:NodeOutput}" BasedOn="{StaticResource {x:Type nodify:NodeOutput}}">
    <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}"/>
    <Setter Property="IsConnected" Value="{Binding IsConnected}"/>
    <Setter Property="Header" Value="{Binding Label}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Branch}" Value="yes">
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Branch}" Value="no">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Node parts: header = id and kind, content = title, footer = status chip (dot and text; the dot repeats the border). -->
  <DataTemplate x:Key="NodeHeaderTemplate" DataType="{x:Type vm:NodeViewModel}">
    <DockPanel LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" Text="{Binding Id}" Margin="0,0,8,0" FontFamily="{StaticResource MonoFont}"
                 FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBlock Text="{Binding KindLabel}" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </DataTemplate>

  <DataTemplate x:Key="NodeTitleTemplate">
    <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" FontWeight="SemiBold" MaxWidth="150"
               TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
  </DataTemplate>

  <DataTemplate x:Key="NodeFooterTemplate" DataType="{x:Type vm:NodeViewModel}">
    <StackPanel Orientation="Horizontal">
      <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"
               Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
      <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap"/>
    </StackPanel>
  </DataTemplate>

  <!-- [P2] Node shell: the whole node border carries the status colour; Debate is dimmed. The selection frame belongs to
       the ItemContainer and is blue, so a selected node shows both. -->
  <Style x:Key="NodeShell" TargetType="{x:Type nodify:Node}" BasedOn="{StaticResource {x:Type nodify:Node}}">
    <Setter Property="MinWidth" Value="220"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
    <Setter Property="ContentPadding" Value="10,6"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Header" Value="{Binding}"/>
    <Setter Property="HeaderTemplate" Value="{StaticResource NodeHeaderTemplate}"/>
    <Setter Property="ContentTemplate" Value="{StaticResource NodeTitleTemplate}"/>
    <Setter Property="Footer" Value="{Binding}"/>
    <Setter Property="FooterTemplate" Value="{StaticResource NodeFooterTemplate}"/>
    <Setter Property="Input" Value="{Binding Inputs}"/>
    <Setter Property="Output" Value="{Binding Outputs}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsDisabled}" Value="True">
        <Setter Property="Opacity" Value="0.5"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Skipped">
        <Setter Property="Opacity" Value="0.6"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <DataTemplate DataType="{x:Type vm:NodeViewModel}">
    <nodify:Node Style="{StaticResource NodeShell}" Content="{Binding Title}"/>
  </DataTemplate>

  <!-- [P3] Wires: the Sí and No wires of a Condition are coloured and labelled; a selected wire is thicker and blue. -->
  <Style x:Key="Wire" TargetType="{x:Type nodify:Connection}" BasedOn="{StaticResource {x:Type nodify:Connection}}">
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="Text" Value="{Binding Source.Label}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="TextBackground" Value="{StaticResource BackgroundBrush}"/>
    <Setter Property="nodify:BaseConnection.IsSelectable" Value="True"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Branch}" Value="yes">
        <Setter Property="Stroke" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Branch}" Value="no">
        <Setter Property="Stroke" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
      </DataTrigger>
      <Trigger Property="nodify:BaseConnection.IsSelected" Value="True">
        <Setter Property="Stroke" Value="{StaticResource AccentHoverBrush}"/>
        <Setter Property="Fill" Value="{StaticResource AccentHoverBrush}"/>
        <Setter Property="StrokeThickness" Value="4"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="WireTemplate" DataType="{x:Type vm:ConnectionViewModel}">
    <nodify:Connection Style="{StaticResource Wire}" Source="{Binding Source.Anchor}" Target="{Binding Target.Anchor}"/>
  </DataTemplate>

  <!-- [P4] Pending connection: while dragging, Nodify writes Source and PreviewTarget into the view model (one way to
       source). The view model answers with PreviewText/IsPreviewError, drawn next to the cursor; the wire turns red when
       the drop would be refused. The drop itself goes through NodifyEditor.ConnectionCompletedCommand. -->
  <ControlTemplate x:Key="PendingWireControlTemplate" TargetType="{x:Type nodify:PendingConnection}">
    <Canvas>
      <nodify:LineConnection Source="{TemplateBinding SourceAnchor}" Target="{TemplateBinding TargetAnchor}"
                             Stroke="{TemplateBinding Stroke}" StrokeThickness="{TemplateBinding StrokeThickness}"
                             StrokeDashArray="{TemplateBinding StrokeDashArray}" Direction="{TemplateBinding Direction}"
                             Spacing="0" ArrowSize="0 0" SourceOffsetMode="None" TargetOffsetMode="None"/>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
              Canvas.Left="{Binding TargetAnchor.X, RelativeSource={RelativeSource TemplatedParent}}"
              Canvas.Top="{Binding TargetAnchor.Y, RelativeSource={RelativeSource TemplatedParent}}"
              Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HasTextToVisibility}}"
              CornerRadius="4" Margin="16">
        <ContentPresenter/>
      </Border>
    </Canvas>
  </ControlTemplate>

  <Style x:Key="PendingWire" TargetType="{x:Type nodify:PendingConnection}" BasedOn="{StaticResource {x:Type nodify:PendingConnection}}">
    <Setter Property="Template" Value="{StaticResource PendingWireControlTemplate}"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="Padding" Value="8,4"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsPreviewError}" Value="True">
        <Setter Property="Stroke" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="PendingWireTemplate" DataType="{x:Type vm:PendingConnectionViewModel}">
    <nodify:PendingConnection Style="{StaticResource PendingWire}" IsTabStop="False" IsHitTestVisible="False"
                              Source="{Binding Source, Mode=OneWayToSource}"
                              PreviewTarget="{Binding PreviewTarget, Mode=OneWayToSource}"
                              Content="{Binding PreviewText}"
                              EnablePreview="True" EnableSnapping="True" AllowOnlyConnectors="True">
      <nodify:PendingConnection.ContentTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" TextWrapping="NoWrap"/>
        </DataTemplate>
      </nodify:PendingConnection.ContentTemplate>
    </nodify:PendingConnection>
  </DataTemplate>

</ResourceDictionary>
