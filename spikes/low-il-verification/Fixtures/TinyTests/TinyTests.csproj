<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tiny xUnit v3 (Microsoft.Testing.Platform) project copied into the Low-IL work folder by the harness. It is NOT
       part of AgentStudio.slnx and opts out of central package versions. Versions match the repo (verified 2026-10-15).
       The EvilBeforeBuild target stands in for an agent-authored MSBuild target that tries to write outside the sandbox;
       the harness enables it with -p:EnableEvilTarget=true -p:EvilPath=<path>. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="EvilBeforeBuild" BeforeTargets="Build" Condition="'$(EnableEvilTarget)' == 'true'">
    <Message Importance="high" Text="EVIL target attempting to write $(EvilPath)" />
    <WriteLinesToFile File="$(EvilPath)" Lines="pwned by MSBuild BeforeTargets=Build" Overwrite="true" />
    <Message Importance="high" Text="EVIL target wrote $(EvilPath)" />
  </Target>

</Project>
