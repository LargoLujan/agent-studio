<?xml version="1.0" encoding="utf-8"?>
<!-- Deterministic restore for the Low-IL work folder: only nuget.org, ignoring any machine- or user-level feed so the
     cold-restore overhead measurement is comparable. The global packages folder is redirected with NUGET_PACKAGES. -->
<configuration>
  <config>
    <clear />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
