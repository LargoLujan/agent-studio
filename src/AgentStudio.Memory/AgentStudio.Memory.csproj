<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgentStudio.Memory</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentStudio.Application\AgentStudio.Application.csproj" />
  </ItemGroup>

  <!-- The names of the categories (MemoryLabels, SemanticLabels and the titles of the export) are internal: the test of every
       category reads them, so a category added without its name fails there and not when a person records one. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentStudio.Tests" />
  </ItemGroup>

</Project>
