<UserControl x:Class="AgentStudio.Desktop.Controls.Info.InfoButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False" VerticalAlignment="Center">
    <!-- The ⓘ button of a complex section (docs/17 D-54): a small button next to the title of the section that opens a small
         window with «Qué es esto», «Qué puedes hacer aquí» and, when the help has an article for it (Phase 14), «Más ayuda». A
         click, Intro or Espacio opens it; Esc closes it and gives the focus back to the button. It covers nothing needed to go
         on: it is not modal, and it closes when the person clicks elsewhere. Every text comes from the resources by the key of
         the section (InfoKey); only the tokens of the theme are used. -->
    <Grid>
        <ToggleButton x:Name="Toggle" Width="22" Height="22" Padding="0" Cursor="Hand"
                      FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                      FocusVisualStyle="{StaticResource {x:Static SystemParameters.FocusVisualStyleKey}}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <TextBlock x:Name="Glyph" Text="&#xE946;"/>
        </ToggleButton>

        <Popup x:Name="Bubble" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" Focusable="False"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border x:Name="Card" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10" MaxWidth="360" Focusable="True"
                    FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock x:Name="WhatHeading" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WhatText" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ActionsHeading" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <ItemsControl x:Name="ActionsList" Margin="0,4,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <BulletDecorator Margin="0,2,0,0">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                    </BulletDecorator.Bullet>
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding}"/>
                                </BulletDecorator>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="MoreHelp" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Visibility="Collapsed" Click="OnMoreHelp"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
