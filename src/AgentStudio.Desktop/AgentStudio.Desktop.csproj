<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows SDK of build 22000 (docs/16 D-13, ADR-0037): its projection brings UserConsentVerifierInterop, with which
       a desktop window asks Windows Hello, and that interop needs Windows 11 (build 22000) to run. Only this project and
       the test project, which references it, target a version of the SDK: the domain, the contracts and the modules stay
       in net10.0 (ADR-0001). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AgentStudio.Desktop</RootNamespace>
    <AssemblyTitle>Agent Studio</AssemblyTitle>
  </PropertyGroup>

  <!-- The icon in the notification area (docs/16 D-14, ADR-0036): System.Windows.Forms.NotifyIcon, part of the desktop
       shared framework the app already runs on, so no package and no file more in the output. Only Background/NotifyIconTray
       uses Windows Forms: the global usings the SDK adds for it would make MessageBox, Application, Color or Point ambiguous
       with WPF's all over the project, so they are removed. -->
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dirkster.AvalonDock" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Nodify" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
  </ItemGroup>

  <!-- The corpus of the help (docs/17 D-55): Help/<language>/<id>.md, embedded as «Help.<language>.<id>.md» (HelpCorpus reads them). -->
  <ItemGroup>
    <None Remove="Help\**" />
    <EmbeddedResource Include="Help\**\*.md" LogicalName="Help.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The texts of the interface (docs/17 D-47, ADR-0054): Resources/Strings.resx in Spanish of Spain, the source language, and
       a satellite per language (Strings.en.resx…), embedded as usual. The packages of a phase add their own area files,
       Resources/<Area>Strings.resx, so no two of them share a file: the text provider finds every one by that name
       (Localization/ResourceTextProvider). Each gets a typed class (AgentStudio.Desktop.Resources.<Area>Strings), generated by
       MSBuild into obj, with no designer file in the repository. It is generated before the markup compilation, because the
       temporary assembly of WPF compiles the code before the resources of the build are generated; a satellite
       (<Area>Strings.<lang>.resx) gets none. -->
  <PropertyGroup>
    <NeutralLanguage>es-ES</NeutralLanguage>
    <TypedStringsDirectory>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\TypedStrings\</TypedStringsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <TypedStrings Include="Resources\*Strings.resx" />
  </ItemGroup>

  <Target Name="GenerateTypedStrings" BeforeTargets="MarkupCompilePass1;CoreCompile"
          Inputs="@(TypedStrings)" Outputs="@(TypedStrings->'$(TypedStringsDirectory)%(Filename).Designer.cs')">
    <MakeDir Directories="$(TypedStringsDirectory)" />
    <GenerateResource Sources="@(TypedStrings)" OutputResources="$(TypedStringsDirectory)%(TypedStrings.Filename).resources"
                      StronglyTypedLanguage="CSharp" StronglyTypedNamespace="AgentStudio.Desktop.Resources"
                      StronglyTypedManifestPrefix="AgentStudio.Desktop.Resources" StronglyTypedClassName="%(TypedStrings.Filename)"
                      StronglyTypedFileName="$(TypedStringsDirectory)%(TypedStrings.Filename).Designer.cs" PublicClass="true"
                      ExecuteAsTool="false" />
  </Target>

  <!-- The temporary assembly of WPF receives the items of compilation of the build, in its own form: whatever form the typed
       classes arrived in, they are taken out and added once, by their full path. -->
  <Target Name="IncludeTypedStrings" BeforeTargets="MarkupCompilePass1;CoreCompile" DependsOnTargets="GenerateTypedStrings">
    <ItemGroup>
      <_TypedStringsCompiled Include="@(Compile)"
                             Condition="$([System.String]::Copy('%(Compile.Identity)').Contains('TypedStrings')) and $([System.String]::Copy('%(Compile.Identity)').EndsWith('Strings.Designer.cs'))" />
      <Compile Remove="@(_TypedStringsCompiled)" />
      <Compile Include="@(TypedStrings->'$(TypedStringsDirectory)%(Filename).Designer.cs')" />
    </ItemGroup>
  </Target>

  <!-- Editor assets: the page is versioned; Monaco is downloaded (see tools/assets/fetch-monaco.ps1). -->
  <PropertyGroup>
    <MonacoFetchScript>$(MSBuildThisFileDirectory)..\..\tools\assets\fetch-monaco.ps1</MonacoFetchScript>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);AS0001</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\editor\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="FetchMonaco" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildThisFileDirectory)Assets\monaco\vs\loader.js')">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MonacoFetchScript)&quot;"
          ContinueOnError="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="MonacoFetchExitCode" />
    </Exec>
    <Warning Code="AS0001" Condition="'$(MonacoFetchExitCode)' != '0'"
             Text="Could not download the Monaco editor resources (exit code $(MonacoFetchExitCode)). The code editor will show 'Editor no disponible' until you run tools/assets/fetch-monaco.ps1 (needs pwsh and network access)." />
  </Target>

  <!-- Monaco is generated, so it is added after the (possible) download rather than through a static glob. -->
  <Target Name="IncludeMonacoContent" AfterTargets="FetchMonaco" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Content Include="Assets\monaco\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Terminal (xterm.js in WebView2). The page ships in Assets\terminal; xterm itself is downloaded (MIT, not versioned)
       by tools\assets\fetch-xterm.ps1 into Assets\xterm and copied next to the page as Assets\terminal\xterm\. -->
  <PropertyGroup>
    <XtermAssetsDir>$(MSBuildThisFileDirectory)Assets\xterm\</XtermAssetsDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\terminal\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="FetchXtermAssets" BeforeTargets="BeforeBuild" Condition="!Exists('$(XtermAssetsDir)xterm.js')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\assets\fetch-xterm.ps1&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ContinueOnError="true" />
    <Message Importance="high" Condition="!Exists('$(XtermAssetsDir)xterm.js')"
             Text="xterm assets could not be downloaded; the terminal will show an error at runtime. Run tools\assets\fetch-xterm.ps1." />
  </Target>

  <!-- Evaluated at execution time so files downloaded by the target above are included in the very first build. -->
  <Target Name="IncludeXtermAssets" BeforeTargets="AssignTargetPaths" DependsOnTargets="FetchXtermAssets">
    <ItemGroup>
      <XtermAssetFile Include="$(XtermAssetsDir)**" />
      <Content Include="@(XtermAssetFile)" Link="Assets\terminal\xterm\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\AgentStudio.Application\AgentStudio.Application.csproj" />
    <ProjectReference Include="..\AgentStudio.Orchestration\AgentStudio.Orchestration.csproj" />
    <ProjectReference Include="..\AgentStudio.Debate\AgentStudio.Debate.csproj" />
    <ProjectReference Include="..\AgentStudio.Observability\AgentStudio.Observability.csproj" />
    <ProjectReference Include="..\AgentStudio.Memory\AgentStudio.Memory.csproj" />
    <ProjectReference Include="..\AgentStudio.Security\AgentStudio.Security.csproj" />
    <ProjectReference Include="..\AgentStudio.Providers\AgentStudio.Providers.csproj" />
    <ProjectReference Include="..\AgentStudio.Infrastructure\AgentStudio.Infrastructure.csproj" />
  </ItemGroup>

  <!-- The read-only MCP server of the assisted skill recommender (docs/14 D-30) ships next to the app, where
       SkillsScreenServices.DefaultServerExecutable expects it: referencing the executable project copies its apphost,
       its runtimeconfig, its deps.json and its dependencies into the output, as the test project already does. No code
       of the app uses its types: Claude Code launches it over stdio from an auxiliary read-only run. -->
  <ItemGroup>
    <ProjectReference Include="..\AgentStudio.SkillsMcp\AgentStudio.SkillsMcp.csproj" />
  </ItemGroup>

  <!-- The analysis process of Auto Graph (Phase 6, docs/20 D-18; ADR-0062) ships next to the app the same way: referencing the
       executable project copies its apphost, its runtimeconfig, its deps.json and its dependencies (Roslyn) into the output. No
       code of the app uses its types: the host launches it at low integrity over a copy of a commit. -->
  <ItemGroup>
    <ProjectReference Include="..\AgentStudio.GraphWorker\AgentStudio.GraphWorker.csproj" />
  </ItemGroup>

</Project>
