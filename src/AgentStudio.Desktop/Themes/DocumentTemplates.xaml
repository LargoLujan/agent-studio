<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:AgentStudio.Desktop.ViewModels"
                    xmlns:views="clr-namespace:AgentStudio.Desktop.Views"
                    xmlns:orchestrator="clr-namespace:AgentStudio.Desktop.Orchestrator"
                    xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
                    xmlns:skills="clr-namespace:AgentStudio.Desktop.Skills"
                    xmlns:skillsViews="clr-namespace:AgentStudio.Desktop.Views.Skills"
                    xmlns:observability="clr-namespace:AgentStudio.Desktop.Observability"
                    xmlns:observabilityViews="clr-namespace:AgentStudio.Desktop.Views.Observability"
                    xmlns:memory="clr-namespace:AgentStudio.Desktop.Memory"
                    xmlns:memoryViews="clr-namespace:AgentStudio.Desktop.Views.Memory"
                    xmlns:debate="clr-namespace:AgentStudio.Desktop.Debate"
                    xmlns:debateViews="clr-namespace:AgentStudio.Desktop.Views.Debate"
                    xmlns:audit="clr-namespace:AgentStudio.Desktop.Audit"
                    xmlns:auditViews="clr-namespace:AgentStudio.Desktop.Views.Audit"
                    xmlns:settings="clr-namespace:AgentStudio.Desktop.Settings"
                    xmlns:settingsViews="clr-namespace:AgentStudio.Desktop.Views.Settings">

    <!-- One DataTemplate per document ViewModel type. Application-level so floating windows find them too.
         FileEditorView shows Monaco and falls back to the read-only viewer when a file cannot be edited. -->
    <DataTemplate DataType="{x:Type vm:WelcomeDocumentViewModel}">
        <views:WelcomeView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FileDocumentViewModel}">
        <views:FileEditorView/>
    </DataTemplate>

    <!-- The orchestrator canvas, plan review and run monitor (its templates and colours: Themes/Nodify.xaml). -->
    <DataTemplate DataType="{x:Type orchestrator:OrchestratorDocumentViewModel}">
        <orchestratorViews:OrchestratorView/>
    </DataTemplate>

    <!-- Phase 4 (docs/14 section 9): the skills catalog, the usage with the quota, and the memory with the daily summary. -->
    <DataTemplate DataType="{x:Type skills:SkillsDocumentViewModel}">
        <skillsViews:SkillsView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type observability:UsageDashboardViewModel}">
        <observabilityViews:UsageDashboardView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type memory:MemoryViewModel}">
        <memoryViews:MemoryView/>
    </DataTemplate>

    <!-- Phase 5 (docs/15 section 4.10): «Debates» (room, history, new debate, verdict cards) and «Auditoría». -->
    <DataTemplate DataType="{x:Type debate:DebatesDocumentViewModel}">
        <debateViews:DebatesView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type audit:ProjectAuditDocumentViewModel}">
        <auditViews:ProjectAuditView/>
    </DataTemplate>

    <!-- «Ajustes» (docs/03 §5.2): «Contexto y cuota», «Trabajo desatendido» and «Windows Hello y bloqueo», with one «Guardar». -->
    <DataTemplate DataType="{x:Type settings:SettingsDocumentViewModel}">
        <settingsViews:SettingsView/>
    </DataTemplate>
</ResourceDictionary>
