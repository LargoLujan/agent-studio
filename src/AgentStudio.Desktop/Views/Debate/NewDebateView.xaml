<UserControl x:Class="AgentStudio.Desktop.Views.Debate.NewDebateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:debate="clr-namespace:AgentStudio.Desktop.Debate"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=debate:NewDebateViewModel}">
    <!-- «Nuevo debate» (docs/15 D-41 and D-06): mode, question, criteria (with the methods the mode admits) or the
         requirements the subject brings, subject, participants of the template with their role, judges and the
         disposition, explained (a waiver in the warning colour), limits; «Preparar» writes nothing and «Abrir debate»
         asks your approval of exactly what is shown. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Form.BoolToVisibility"/>
        <orchestratorViews:NullToVisibilityConverter x:Key="Form.NotNullToVisibility"/>
        <Style x:Key="Form.Warning" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding JudgingHintIsWarning}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource SurfaceBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="12,10,12,12">
            <TextBlock Style="{StaticResource SectionTitleText}" Text="Nuevo debate"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Modo"/>
            <ComboBox HorizontalAlignment="Left" MinWidth="260" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label" AutomationProperties.Name="Modo del debate"/>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding ModeHelp}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Pregunta (literal: es lo que reciben los participantes y el juez)"/>
            <TextBox Style="{StaticResource MultilineFieldTextBox}" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pregunta del debate"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Objeto"/>
            <WrapPanel>
                <ComboBox MinWidth="240" Margin="0,0,8,0" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" DisplayMemberPath="Label" AutomationProperties.Name="Objeto del debate"/>
                <ComboBox MinWidth="240" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Label" AutomationProperties.Name="Ejecución que se debate"
                          Visibility="{Binding ShowsRuns, Converter={StaticResource Form.BoolToVisibility}}"/>
            </WrapPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Requisitos"/>
            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding RequirementsText}"/>
            <StackPanel Visibility="{Binding WritesCriteria, Converter={StaticResource Form.BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Criteria}" Focusable="False" AutomationProperties.Name="Criterios">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type debate:DebateCriterionViewModel}">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyText}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding Id}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Id, StringFormat='Texto del criterio {0}'}"/>
                                <ComboBox Grid.Column="2" MinWidth="170" Margin="8,0,0,0" ItemsSource="{Binding MethodOptions}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Label"
                                          AutomationProperties.Name="{Binding Id, StringFormat='Cómo se comprueba {0}'}"/>
                                <CheckBox Grid.Column="3" Style="{StaticResource FieldCheckBox}" Margin="8,0,0,0" VerticalAlignment="Center" Content="Obligatorio" IsChecked="{Binding IsMandatory}"/>
                                <Button Grid.Column="4" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Content="Quitar"
                                        Command="{Binding DataContext.RemoveCriterionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Id, StringFormat='Quitar {0}'}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="Añadir criterio" Command="{Binding AddCriterionCommand}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Participantes de la plantilla (de solo lectura, sin escritura, shell, red, MCP ni skills)"/>
            <ItemsControl ItemsSource="{Binding Participants}" Focusable="False" AutomationProperties.Name="Participantes">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type debate:ParticipantChoiceViewModel}">
                        <DockPanel Margin="0,2,0,2">
                            <ComboBox DockPanel.Dock="Right" MinWidth="140" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="{Binding Name, StringFormat='Papel de {0}'}"/>
                            <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding IsIncluded}" AutomationProperties.Name="{Binding Name}">
                                <TextBlock Style="{StaticResource BodyText}" FontSize="12">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                    <Run Text="·" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                            </CheckBox>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Jueces candidatos (no participan)"/>
            <ItemsControl ItemsSource="{Binding Judges}" Focusable="False" AutomationProperties.Name="Jueces">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type debate:JudgeChoiceViewModel}">
                        <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding IsIncluded}" AutomationProperties.Name="{Binding Name}">
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12">
                                <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                <Run Text="·" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Disposición del juicio"/>
            <ComboBox HorizontalAlignment="Left" MinWidth="220" ItemsSource="{Binding JudgingKinds}" SelectedItem="{Binding SelectedJudging}" DisplayMemberPath="Label" AutomationProperties.Name="Disposición del juicio"/>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding JudgingHelp}"/>
            <TextBlock Style="{StaticResource Form.Warning}" Margin="0,2,0,0" Text="{Binding JudgingHint}" AutomationProperties.LiveSetting="Polite"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Límites (el primero que se alcanza manda el debate a juicio)"/>
            <WrapPanel>
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" Text="Rondas"/>
                <TextBox Style="{StaticResource FieldTextBox}" Width="60" Margin="0,0,16,0" Text="{Binding MaxRounds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rondas como mucho"/>
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" Text="Minutos"/>
                <TextBox Style="{StaticResource FieldTextBox}" Width="60" Margin="0,0,16,0" Text="{Binding MaxMinutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Minutos como mucho"/>
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" Text="Tokens"/>
                <TextBox Style="{StaticResource FieldTextBox}" Width="110" Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tokens como mucho"/>
            </WrapPanel>

            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Problems}" Focusable="False" Visibility="{Binding HasProblems, Converter={StaticResource Form.BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource ProblemText}" Text="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Preparar" Command="{Binding PrepareCommand}"
                    ToolTip="Pide al coordinador la configuración exacta y la estimación. No gasta cuota ni escribe nada."/>

            <!-- What you approve. -->
            <Border Style="{StaticResource InnerCard}" Padding="10,8" Margin="0,8,0,0" Visibility="{Binding HasProposal, Converter={StaticResource Form.BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding ArrangementText}"/>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}" Text="{Binding WaiverText}"
                               Visibility="{Binding WaiverText, Converter={StaticResource Form.NotNullToVisibility}}" AutomationProperties.Name="Dispensa"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding ProducersText}" Visibility="{Binding ProducersText, Converter={StaticResource Form.NotNullToVisibility}}"/>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,4,0,0" Text="{Binding EstimateText}"/>
                    <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ProposalProblems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ProblemText}" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding ApprovalText, StringFormat='Aprobación que se te pedirá: {0}'}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Text="{Binding ProposalHash}"/>
                    <Button Style="{StaticResource ToolbarPrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Abrir debate" Command="{Binding OpenCommand}"
                            ToolTip="Te pide aprobación, atada a lo que ves aquí. Cambiar algo después la anula."/>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,6,0,0" Text="{Binding StatusMessage, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Style="{StaticResource ErrorText}" Margin="0,4,0,0" Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
