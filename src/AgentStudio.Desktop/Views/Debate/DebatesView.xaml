<UserControl x:Class="AgentStudio.Desktop.Views.Debate.DebatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:debate="clr-namespace:AgentStudio.Desktop.Debate"
             xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Debate"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=debate:DebatesDocumentViewModel}">
    <!-- «Debates» (docs/15 D-41, Ctrl+Shift+D): the history of the project's debates (from replaying the log, filtered
         by mode, «Reanudar» on an interrupted one), «Nuevo debate», the challenge of a verdict and the room. What is
         missing in the composition is listed at the top. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Debates.BoolToVisibility"/>
        <orchestratorViews:ToneToBrushConverter x:Key="Debates.ToneToBrush"/>
        <orchestratorViews:NullToVisibilityConverter x:Key="Debates.NotNullToVisibility"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButton}" Content="Volver al debate en curso" Command="{Binding BackToLiveCommand}"
                                Visibility="{Binding ShowsAnotherThanLive, Converter={StaticResource Debates.BoolToVisibility}}"/>
                        <Button Style="{StaticResource ToolbarButton}" Content="Actualizar" Command="{Binding RefreshCommand}"/>
                        <Button Style="{StaticResource ToolbarPrimaryButton}" Content="Nuevo debate" Command="{Binding ShowNewDebateCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Text="{Binding Title}"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Notices}" Focusable="False" AutomationProperties.Name="Avisos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding StatusMessage, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300"/>
                <ColumnDefinition Width="5*" MinWidth="460"/>
            </Grid.ColumnDefinitions>

            <!-- History. -->
            <DockPanel Grid.Column="0" Margin="12,10,12,12">
                <ComboBox DockPanel.Dock="Top" HorizontalAlignment="Left" MinWidth="200" Margin="0,0,0,8" ItemsSource="{Binding ModeFilters}" SelectedItem="{Binding SelectedFilter}"
                          DisplayMemberPath="Label" AutomationProperties.Name="Filtrar por modo"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding History}" Focusable="False" AutomationProperties.Name="Historial de debates">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type debate:DebateHistoryItem}">
                                <Border Style="{StaticResource InnerCard}" Padding="10,8" AutomationProperties.Name="{Binding StateText}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,4,6,0" VerticalAlignment="Top" Fill="{Binding Tone, Converter={StaticResource Debates.ToneToBrush}}"/>
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12">
                                                <Run Text="{Binding When, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding ModeText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding StateText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource BodyText}" Margin="0,2,0,0" Text="{Binding QuestionText}"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding DecisionText}" Visibility="{Binding DecisionText, Converter={StaticResource Debates.NotNullToVisibility}}"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding ChallengeText}" Visibility="{Binding ChallengeText, Converter={StaticResource Debates.NotNullToVisibility}}"/>
                                        <TextBlock Style="{StaticResource ProblemText}" Text="{Binding ProblemsText}" Visibility="{Binding ProblemsText, Converter={StaticResource Debates.NotNullToVisibility}}"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Text="{Binding Debate}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Style="{StaticResource ToolbarButton}" Content="Abrir"
                                                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Debate, StringFormat='Abrir el debate {0}'}"/>
                                            <Button Style="{StaticResource ToolbarButton}" Content="Reanudar"
                                                    Visibility="{Binding CanResume, Converter={StaticResource Debates.BoolToVisibility}}"
                                                    Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    ToolTip="Gasta cuota: te pide aprobación. Los turnos abiertos se cierran como interrumpidos y lo anunciado no se repite."
                                                    AutomationProperties.Name="{Binding Debate, StringFormat='Reanudar el debate {0}'}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- The part on screen: the form, the challenge or the room. -->
            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <views:NewDebateView DataContext="{Binding NewDebate}"
                                         Visibility="{Binding DataContext.ShowsNewDebate, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Debates.BoolToVisibility}, FallbackValue=Collapsed}"/>
                    <views:ChallengeFormView DataContext="{Binding Challenge}"
                                             Visibility="{Binding DataContext.ShowsChallenge, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Debates.BoolToVisibility}, FallbackValue=Collapsed}"/>
                    <views:DebateRoomView DataContext="{Binding Room}"
                                          Visibility="{Binding DataContext.ShowsRoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Debates.BoolToVisibility}, FallbackValue=Collapsed}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="16" TextWrapping="Wrap"
                               Visibility="{Binding ShowsNothing, Converter={StaticResource Debates.BoolToVisibility}}"
                               Text="Abre un debate del historial o pulsa «Nuevo debate». Un debate gasta cuota de tus suscripciones: «Abrir debate» te enseña antes la configuración exacta y la estimación, y te pide aprobación."/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
