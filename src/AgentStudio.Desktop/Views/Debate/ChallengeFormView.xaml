<UserControl x:Class="AgentStudio.Desktop.Views.Debate.ChallengeFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:debate="clr-namespace:AgentStudio.Desktop.Debate"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=debate:ChallengeFormViewModel}">
    <!-- «Impugnar» (docs/15 D-38 and D-39): your reasons (a note of yours) and the adversarial revision they open, on the
         requirements of the challenged verdict, judged by another judge that the service picks. Nothing is recorded until
         «Impugnar», which asks your approval. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Challenge.BoolToVisibility"/>
        <orchestratorViews:ToneToBrushConverter x:Key="Challenge.ToneToBrush"/>
        <orchestratorViews:NullToVisibilityConverter x:Key="Challenge.NotNullToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource SurfaceBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="12,10,12,12">
            <DockPanel>
                <info:InfoButton DockPanel.Dock="Right" InfoKey="Info_Challenge" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Debate_ChallengeView_Title}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" Text="{Binding VerdictText}" Visibility="{Binding VerdictText, Converter={StaticResource Challenge.NotNullToVisibility}}"/>
            <DockPanel Margin="0,4,0,0" Visibility="{Binding ChallengeText, Converter={StaticResource Challenge.NotNullToVisibility}}">
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,5,6,0" VerticalAlignment="Top" Fill="{Binding ChallengeTone, Converter={StaticResource Challenge.ToneToBrush}}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding ChallengeText}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding RequirementsText}" Visibility="{Binding RequirementsText, Converter={StaticResource Challenge.NotNullToVisibility}}"/>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                       Text="{l:T Debate_ChallengeView_Explain}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Debate_ChallengeView_Reasons}"/>
            <TextBox Style="{StaticResource MultilineFieldTextBox}" Text="{Binding Reasons, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Debate_ChallengeView_ReasonsName}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Debate_ChallengeView_Question}"/>
            <TextBox Style="{StaticResource MultilineFieldTextBox}" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Debate_ChallengeView_Question}"/>

            <WrapPanel Margin="0,4,0,0">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Debate_ChallengeView_Proponent}"/>
                    <ComboBox MinWidth="280" ItemsSource="{Binding Candidates}" SelectedItem="{Binding Proponent}" DisplayMemberPath="Label" AutomationProperties.Name="{l:T Debate_Role_Proponent}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Debate_ChallengeView_Critic}"/>
                    <ComboBox MinWidth="280" ItemsSource="{Binding Candidates}" SelectedItem="{Binding Critic}" DisplayMemberPath="Label" AutomationProperties.Name="{l:T Debate_Role_Critic}"/>
                </StackPanel>
            </WrapPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Debate_ChallengeView_Judges}"/>
            <ItemsControl ItemsSource="{Binding Judges}" Focusable="False" AutomationProperties.Name="{l:T Debate_Form_Judges}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type debate:JudgeChoiceViewModel}">
                        <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding IsIncluded}" AutomationProperties.Name="{Binding Name}">
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12">
                                <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                <Run Text="·" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Debate_Form_Limits}"/>
            <WrapPanel>
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:T Debate_Form_Rounds}"/>
                <TextBox Style="{StaticResource FieldTextBox}" Width="60" Margin="0,0,16,0" Text="{Binding MaxRounds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Debate_Form_RoundsName}"/>
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:T Debate_Form_Minutes}"/>
                <TextBox Style="{StaticResource FieldTextBox}" Width="60" Margin="0,0,16,0" Text="{Binding MaxMinutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Debate_Form_MinutesName}"/>
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:T Debate_Form_Tokens}"/>
                <TextBox Style="{StaticResource FieldTextBox}" Width="110" Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Debate_Form_TokensName}"/>
            </WrapPanel>

            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Problems}" Focusable="False" Visibility="{Binding HasProblems, Converter={StaticResource Challenge.BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource ProblemText}" Text="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:T Debate_Form_Prepare}" Command="{Binding PrepareCommand}"
                    ToolTip="{l:T Debate_ChallengeView_PrepareHint}"/>

            <Border Style="{StaticResource InnerCard}" Padding="10,8" Margin="0,8,0,0" Visibility="{Binding HasProposal, Converter={StaticResource Challenge.BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding ArrangementText}"/>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}" Text="{Binding WaiverText}"
                               Visibility="{Binding WaiverText, Converter={StaticResource Challenge.NotNullToVisibility}}"/>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,4,0,0" Text="{Binding EstimateText}"/>
                    <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ProposalProblems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ProblemText}" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding ApprovalLine}"/>
                    <Button Style="{StaticResource ToolbarPrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:T Debate_ChallengeView_Challenge}" Command="{Binding ChallengeCommand}"
                            ToolTip="{l:T Debate_ChallengeView_ChallengeHint}"/>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,6,0,0" Text="{Binding StatusMessage, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Style="{StaticResource ErrorText}" Margin="0,4,0,0" Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
