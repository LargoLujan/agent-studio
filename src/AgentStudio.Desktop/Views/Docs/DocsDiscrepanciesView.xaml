<UserControl x:Class="AgentStudio.Desktop.Views.Docs.DocsDiscrepanciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:docs="clr-namespace:AgentStudio.Desktop.Docs"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=docs:DocsDiscrepanciesSection}">
    <!-- «Discrepancias» (docs/20 D-27 to D-30, F6-11): what does not agree in the project, found without an AI, grouped by kind. Each one says where it is and offers what to do:
         open the file, regenerate the diagram, go to «Trabajo». It shows what is saved and never starts the analysis by itself. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Docs.BoolToVisibility"/>
        <orchestratorViews:FalseToVisibilityConverter x:Key="Docs.InverseBoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Text="{Binding Title}"/>
                <info:InfoButton InfoKey="Info_Docs_Discrepancies" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:T Docs_Disc_Intro}"/>

            <TextBlock Style="{StaticResource OptionalSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:T Docs_NoProject}"
                       Visibility="{Binding HasProject, Converter={StaticResource Docs.InverseBoolToVisibility}}"/>
            <TextBlock Style="{StaticResource OptionalSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding UnavailableText}"
                       Visibility="{Binding IsAvailable, Converter={StaticResource Docs.InverseBoolToVisibility}}"/>
            <TextBlock Style="{StaticResource OptionalSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Notice, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Style="{StaticResource OptionalSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Message, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Error, TargetNullValue=''}" AutomationProperties.LiveSetting="Assertive"/>

            <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsAvailable, Converter={StaticResource Docs.BoolToVisibility}}">
                <Button Style="{StaticResource ToolbarButton}" Content="{l:T Docs_Disc_Calculate}" ToolTip="{l:T Docs_Disc_Calculate_Hint}" Command="{Binding CalculateCommand}"/>
                <Button Style="{StaticResource ToolbarButton}" Content="{l:T Docs_Disc_Refresh}" ToolTip="{l:T Docs_Disc_Refresh_Hint}" Command="{Binding RefreshCommand}"/>
            </WrapPanel>

            <!-- Nothing is saved for this version of the project: it says so and does not calculate by itself. -->
            <TextBlock Style="{StaticResource OptionalSecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{l:T Docs_Disc_NotCalculated}"
                       Visibility="{Binding NeedsCalculation, Converter={StaticResource Docs.BoolToVisibility}}"/>
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding DescribesText}"
                       Visibility="{Binding HasResult, Converter={StaticResource Docs.BoolToVisibility}}"/>
            <TextBlock Style="{StaticResource OptionalSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:T Docs_Disc_Clean}"
                       Visibility="{Binding IsClean, Converter={StaticResource Docs.BoolToVisibility}}"/>

            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,6,0,0" AutomationProperties.Name="{l:T Docs_Disc_List_Name}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type docs:FindingRowItem}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,10,0,2" Text="{Binding GroupTitle}"
                                       Visibility="{Binding HasGroupTitle, Converter={StaticResource Docs.BoolToVisibility}}"/>
                            <Border Style="{StaticResource InnerCard}" Padding="10,6" Margin="0,2">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding Text}"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Location}"
                                               Visibility="{Binding HasLocation, Converter={StaticResource Docs.BoolToVisibility}}"/>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Style="{StaticResource ToolbarButton}" Content="{l:T Docs_Disc_OpenFile}" AutomationProperties.Name="{Binding OpenFileName}"
                                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanOpenFile, Converter={StaticResource Docs.BoolToVisibility}}"/>
                                        <Button Style="{StaticResource ToolbarButton}" Content="{l:T Docs_Disc_Regenerate}" AutomationProperties.Name="{Binding RegenerateName}"
                                                Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanRegenerate, Converter={StaticResource Docs.BoolToVisibility}}"/>
                                        <Button Style="{StaticResource ToolbarButton}" Content="{l:T Docs_Disc_Board}" AutomationProperties.Name="{Binding BoardName}"
                                                Command="{Binding DataContext.GoToBoardCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                Visibility="{Binding CanGoToBoard, Converter={StaticResource Docs.BoolToVisibility}}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
