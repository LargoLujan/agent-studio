<UserControl x:Class="AgentStudio.Desktop.Views.Panels.TestsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:panels="clr-namespace:AgentStudio.Desktop.Panels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=panels:TestsPanelViewModel}"
             AutomationProperties.Name="{l:T Panels_Tests_Title}">
    <!-- The panel «Pruebas» (docs/17 D-45, F13-18): the verifications the system captured, and «Ejecutar las pruebas de HEAD» when the
         shell composes it. -->
    <DockPanel Background="{StaticResource SurfaceBrush}">
        <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
            <info:InfoButton DockPanel.Dock="Right" InfoKey="Info_Tests" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{l:T Panels_Tests_RunHead}" Command="{Binding RunHeadTestsCommand}"
                    ToolTip="{l:T Panels_Tests_RunHeadHint}" ToolTipService.ShowOnDisabled="True"
                    Visibility="{Binding CanRunHead, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Summary}" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,4">
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding HeadSummary}"
                       Visibility="{Binding HeadSummary, Converter={StaticResource Orchestrator.NotNullToVisibility}}"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Style="{StaticResource ErrorText}" TextWrapping="Wrap" Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive"/>
            <ItemsControl ItemsSource="{Binding HeadRows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type panels:TestRunRow}">
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding AccessibleName}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <ListBox ItemsSource="{Binding Rows}" Background="{StaticResource BackgroundBrush}" BorderThickness="0" Margin="12,0,12,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:T Panels_Tests_Title}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type panels:TestRunRow}">
                    <StackPanel Margin="0,2" AutomationProperties.Name="{Binding AccessibleName}">
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap">
                            <Run Text="{Binding StateText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="·"/>
                            <Run Text="{Binding Task, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                            <Run Text="{Binding Title, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Counters}"/>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Text="{Binding Error}"
                                   Visibility="{Binding Error, Converter={StaticResource Orchestrator.NotNullToVisibility}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
