<UserControl x:Class="AgentStudio.Desktop.Views.Panels.ProblemsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:panels="clr-namespace:AgentStudio.Desktop.Panels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=panels:ProblemsPanelViewModel}"
             AutomationProperties.Name="{l:T Panels_Problems_Title}">
    <!-- The panel «Problemas» of the bottom zone (docs/17 D-45, F13-18): what the analyzer and the validator see, and why each task failed. -->
    <DockPanel Background="{StaticResource SurfaceBrush}">
        <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
            <info:InfoButton DockPanel.Dock="Right" InfoKey="Info_Problems" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Summary}" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding Rows}" Background="{StaticResource BackgroundBrush}" BorderThickness="0" Margin="12,0,12,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:T Panels_Problems_Title}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type panels:ProblemRow}">
                    <StackPanel Margin="0,2" AutomationProperties.Name="{Binding AccessibleName}">
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap">
                            <Run Text="{Binding SeverityText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="·"/>
                            <Run Text="{Binding Where, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                            <Run Text="{Binding Text, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Detail}"
                                   Visibility="{Binding Detail, Converter={StaticResource Orchestrator.NotNullToVisibility}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
