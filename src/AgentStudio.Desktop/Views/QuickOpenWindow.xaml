<Window x:Class="AgentStudio.Desktop.Views.QuickOpenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AgentStudio.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:QuickOpenViewModel}"
        Title="Ir al fichero" Width="640" SizeToContent="Height" MaxHeight="480"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Background="{StaticResource SurfaceBrush}"
        PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="Ir al fichero">
    <!-- A window of its own, not an overlay: the editor and the terminal are WebView2 (an HWND), and WPF content can
         never be drawn over an HWND. MainWindow owns it, shows it while QuickOpenViewModel.IsOpen and closes it when
         it turns false. Keyboard: the search box keeps the focus; Up/Down/Enter/Esc are mapped in code-behind. -->
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SecondaryText}" Margin="14,10,14,0"
                       Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

            <Grid Grid.Row="1" Margin="12,8,12,8">
                <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource UiFont}" FontSize="14"
                         Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                         Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                         AutomationProperties.Name="Buscar fichero" AutomationProperties.HelpText="Escribe parte de la ruta del fichero">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8,6">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <!-- Placeholder: shown while the box is empty; it never takes the mouse. -->
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Text="Escribe parte de la ruta del fichero…" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ListBox x:Name="ResultList" Grid.Row="2" MaxHeight="320"
                     ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}"
                     Focusable="False" IsTabStop="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnSelectionChanged" MouseLeftButtonUp="OnListMouseLeftButtonUp"
                     AutomationProperties.Name="Ficheros encontrados">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Padding" Value="14,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding RelativePath}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:QuickOpenItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold"/>
                            <!-- Dimmed relative to the row's own colour, so it stays readable on the selected row. -->
                            <TextBlock Grid.Column="1" Text="{Binding Directory}" Margin="10,0,0,0" Opacity="0.7"
                                       FontFamily="{StaticResource UiFont}" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Margin="14,8,14,10">
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding Notice}" AutomationProperties.Name="Estado de la búsqueda"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,4,0,0" Text="{Binding TruncationNotice}"
                           Foreground="{StaticResource WarningBrush}" AutomationProperties.Name="Aviso de índice incompleto"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                           Text="↑ ↓ para moverte · Intro para elegir · Esc para cerrar"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
