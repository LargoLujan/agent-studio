<UserControl x:Class="AgentStudio.Desktop.Views.Orchestrator.NodePropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:canvas="clr-namespace:AgentStudio.Desktop.Orchestrator.Canvas"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=canvas:NodeEditorViewModel}">
    <!-- Properties of the selected node: every field of its TaskSpec the canvas does not draw. Read-only while a run
         follows the plan. Every field updates the node as it is typed, so the validator follows. -->
    <StackPanel IsEnabled="{Binding IsEditable}">
        <TextBlock Style="{StaticResource SectionTitleText}" Text="{Binding Header}"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" Text="{l:T Orchestrator_Props_ReadOnly}"
                   Visibility="{Binding IsReadOnly, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Title}"/>
        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{l:T Orchestrator_Props_TitleName}"/>

        <StackPanel Visibility="{Binding ShowsAgent, Converter={StaticResource Orchestrator.BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Agent}"/>
            <ComboBox ItemsSource="{Binding AgentOptions}" SelectedItem="{Binding SelectedAgent}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{l:T Orchestrator_Props_Agent}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Objective}"/>
        <TextBox Style="{StaticResource MultilineFieldTextBox}" Text="{Binding Objective, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{l:T Orchestrator_Props_Objective}"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Instructions}"/>
        <TextBox Style="{StaticResource MultilineFieldTextBox}" Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{l:T Orchestrator_Props_Instructions}"/>

        <StackPanel Visibility="{Binding ShowsWorkspace, Converter={StaticResource Orchestrator.BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Workspace}"/>
            <ComboBox ItemsSource="{Binding WorkspaceOptions}" SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{l:T Orchestrator_Props_Workspace}"/>
        </StackPanel>

        <StackPanel Visibility="{Binding ShowsWriteScope, Converter={StaticResource Orchestrator.BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_WriteScope}"/>
            <TextBox Style="{StaticResource MultilineFieldTextBox}" FontFamily="{StaticResource MonoFont}"
                     Text="{Binding WriteScopeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Orchestrator_Props_WriteScopeName}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Covers}"/>
        <TextBlock Text="{l:T Orchestrator_Props_NoRequirements}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CoverOptions.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding CoverOptions}" Focusable="False" AutomationProperties.Name="{l:T Orchestrator_Props_Covers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type canvas:CheckOption}">
                    <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding IsChecked}">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Visibility="{Binding ShowsSteps, Converter={StaticResource Orchestrator.BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Steps}"/>
            <ItemsControl ItemsSource="{Binding StepOptions}" Focusable="False" AutomationProperties.Name="{l:T Orchestrator_Props_StepsName}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type canvas:CheckOption}">
                        <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding IsChecked}">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Visibility="{Binding ShowsTool, Converter={StaticResource Orchestrator.BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Tool}"/>
            <ComboBox ItemsSource="{Binding ToolOptions}" SelectedItem="{Binding SelectedTool}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{l:T Orchestrator_Props_Tool_Name}"/>
        </StackPanel>

        <StackPanel Visibility="{Binding ShowsCondition, Converter={StaticResource Orchestrator.BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Condition}"/>
            <ComboBox ItemsSource="{Binding PredicateKindOptions}" SelectedItem="{Binding SelectedPredicateKind}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{l:T Orchestrator_Props_ConditionName}"/>
            <StackPanel Visibility="{Binding PredicateNeedsTask, Converter={StaticResource Orchestrator.BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_ConditionTask}"/>
                <ComboBox ItemsSource="{Binding PredicateTaskOptions}" SelectedItem="{Binding SelectedPredicateTask}" DisplayMemberPath="Label"
                          AutomationProperties.Name="{l:T Orchestrator_Props_ConditionTaskName}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding PredicateNeedsKeyAndValue, Converter={StaticResource Orchestrator.BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_OutputKeyValue}"/>
                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding PredicateKey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Orchestrator_Props_OutputKeyName}"/>
                <TextBox Style="{StaticResource FieldTextBox}" Margin="0,6,0,0" Text="{Binding PredicateValue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Orchestrator_Props_OutputValueName}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding PredicateNeedsPrefix, Converter={StaticResource Orchestrator.BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_PathPrefix}"/>
                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource MonoFont}"
                         Text="{Binding PredicatePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Orchestrator_Props_PathPrefixName}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{l:T Orchestrator_Props_BranchHint}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_WhenStarts}"/>
        <ComboBox ItemsSource="{Binding JoinOptions}" SelectedItem="{Binding SelectedJoin}" DisplayMemberPath="Label"
                  AutomationProperties.Name="{l:T Orchestrator_Props_WhenStartsName}"/>

        <StackPanel Visibility="{Binding HasExtraDependencies, Converter={StaticResource Orchestrator.BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_ExtraDependencies}"/>
            <ItemsControl ItemsSource="{Binding ExtraDependencyTexts}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource ProblemText}" Text="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{l:T Orchestrator_Props_RemoveExtra}"
                    Command="{Binding RemoveExtraDependenciesCommand}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Retries}"/>
        <TextBox Style="{StaticResource FieldTextBox}" Width="90" HorizontalAlignment="Left"
                 Text="{Binding MaxRetriesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Orchestrator_Props_Retries}"/>
        <TextBlock Style="{StaticResource ErrorText}" FontSize="12" Text="{Binding RetriesError}"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Props_Timeout}"/>
        <TextBox Style="{StaticResource FieldTextBox}" Width="90" HorizontalAlignment="Left"
                 Text="{Binding TimeoutMinutesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Orchestrator_Props_TimeoutName}"/>
        <TextBlock Style="{StaticResource ErrorText}" FontSize="12" Text="{Binding TimeoutError}"/>
    </StackPanel>
</UserControl>
