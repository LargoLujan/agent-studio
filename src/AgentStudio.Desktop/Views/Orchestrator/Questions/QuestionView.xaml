<UserControl x:Class="AgentStudio.Desktop.Views.Orchestrator.Questions.QuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:questions="clr-namespace:AgentStudio.Desktop.Orchestrator.Questions"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=questions:QuestionViewModel}">
    <!-- The question of an agent (docs/17 D-31, F13-14). It is not modal. The text of the agent is always inside a frame that says
         it was written by the agent: a label cannot pass for a button of the system. The cost of each option has its origin, or
         says why there is none. Arrows choose, the button «Responder» answers (nothing is chosen and no button is the default: Intro never answers for the person) and Esc decides later
         («Decidir más tarde» is the cancel button, which never cancels the task). -->
    <Border Background="{StaticResource SurfaceBrush}" Padding="22,18" MinWidth="460" MaxWidth="640">
        <StackPanel>
            <DockPanel>
                <info:InfoButton DockPanel.Dock="Right" InfoKey="Info_Question" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="{Binding Title}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive"/>
            </DockPanel>

            <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,12,0,0"
                    AutomationProperties.Name="{Binding Frame}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Frame}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" Text="{Binding Text}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Text="{Binding Why}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,10,0,0" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                <ItemsControl ItemsSource="{Binding Options}" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type questions:QuestionOptionViewModel}">
                            <RadioButton GroupName="QuestionChoice" Margin="0,6,0,0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding AccessibleName}">
                                <StackPanel Margin="4,0,0,0">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="360" Text="{Binding Label}"/>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource BodyText}" FontSize="12" Margin="12,0,0,0"
                                                   Foreground="{StaticResource SuccessBrush}" Text="{Binding RecommendedText}"
                                                   Visibility="{Binding RecommendedText, Converter={StaticResource Orchestrator.NotNullToVisibility}}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" TextWrapping="Wrap" Text="{Binding Detail}"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding EffortText}"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Cost.Text}" ToolTip="{Binding Cost.Detail}"/>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Only when the agent allows it (allowOther): the person's own answer instead of an option. -->
                <StackPanel Visibility="{Binding AllowOther, Converter={StaticResource Orchestrator.BoolToVisibility}}">
                    <RadioButton GroupName="QuestionChoice" Margin="0,10,0,0" IsChecked="{Binding IsOtherSelected, Mode=TwoWay}"
                                 Content="{l:T Monitor_Question_OtherLabel}" AutomationProperties.Name="{l:T Monitor_Question_OtherLabel}"/>
                    <TextBox Style="{StaticResource FieldTextBox}" Margin="22,4,0,0" MaxLength="2000"
                             Text="{Binding OtherText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsOtherSelected}"
                             AutomationProperties.Name="{l:T Monitor_Question_OtherHint}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding DataNotice}"/>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding NoGrantText}"/>
            <TextBlock Style="{StaticResource ErrorText}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ErrorMessage}"
                       AutomationProperties.LiveSetting="Assertive"/>

            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:T Monitor_Question_Answer}" Margin="8,0,0,0"
                        Command="{Binding AnswerCommand}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T Monitor_Question_Defer}"
                        IsCancel="True" Command="{Binding DeferCommand}"/>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
