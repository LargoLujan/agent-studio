<UserControl x:Class="AgentStudio.Desktop.Views.Orchestrator.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:canvas="clr-namespace:AgentStudio.Desktop.Orchestrator.Canvas"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=canvas:CanvasViewModel}">
    <!-- The canvas: bindings only (ADR-0015). Nodify draws; CanvasViewModel owns the nodes, wires, selection and
         viewport. The node, wire and pending-wire templates are in Themes/Nodify.xaml. -->
    <UserControl.Resources>
        <!-- Grid behind the nodes: a tiled drawing whose transform follows the viewport, so it pans and zooms with the graph. -->
        <GeometryDrawing x:Key="SmallGridGeometry" Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z"
                         Brush="{StaticResource NodifyEditor.SelectionRectangleBackgroundBrush}"/>
        <DrawingBrush x:Key="GridBrush" TileMode="Tile" ViewportUnits="Absolute" Viewport="0 0 20 20"
                      Transform="{Binding ViewportTransform, ElementName=Editor}"
                      Drawing="{StaticResource SmallGridGeometry}"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: create nodes and act on the selection and the view. -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="12,8,12,2">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Crear nodo" Style="{StaticResource SecondaryText}" VerticalAlignment="Top" Margin="0,7,10,0"/>
                <ItemsControl ItemsSource="{Binding Palette}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type canvas:PaletteItem}">
                            <Button Style="{StaticResource ToolbarButton}" Content="{Binding Label}" ToolTip="{Binding Hint}"
                                    ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Hint}"
                                    Command="{Binding DataContext.AddNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Kind}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource ToolbarButton}" Content="Eliminar selección (Supr)" Margin="12,0,6,6"
                        Command="{Binding DeleteSelectionCommand}"/>
                <!-- Frames every node, never below a zoom whose words can be read (CanvasViewModel.MinFitZoom). -->
                <Button Style="{StaticResource ToolbarButton}" Content="Ajustar vista" Command="{Binding FitViewCommand}"
                        ToolTip="Encuadra todos los nodos con un zoom en el que se leen; un plan más grande se ve desde su esquina"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Acercar" Command="{x:Static nodify:EditorCommands.ZoomIn}"
                        CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Alejar" Command="{x:Static nodify:EditorCommands.ZoomOut}"
                        CommandTarget="{Binding ElementName=Editor}"/>
            </WrapPanel>
        </Border>

        <!-- The editor. Wires are dragged from an output to an input; Supr deletes the selection; the right button pans. -->
        <Grid Grid.Row="1">
            <nodify:NodifyEditor x:Name="Editor"
                                 ItemsSource="{Binding Nodes}"
                                 Connections="{Binding Connections}"
                                 SelectedItems="{Binding SelectedNodes}"
                                 SelectedConnections="{Binding SelectedConnections}"
                                 PendingConnection="{Binding PendingConnection}"
                                 PendingConnectionTemplate="{StaticResource PendingWireTemplate}"
                                 ConnectionTemplate="{StaticResource WireTemplate}"
                                 ConnectionCompletedCommand="{Binding ConnectCommand}"
                                 DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                 RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                                 ItemsDragCompletedCommand="{Binding SaveLayoutCommand}"
                                 ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                                 ViewportSize="{Binding ViewportSize, Mode=OneWayToSource}"
                                 ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                                 GridCellSize="10"
                                 Background="{StaticResource GridBrush}"
                                 Focusable="True" IsTabStop="True"
                                 AutomationProperties.Name="Lienzo del orquestador">
                <nodify:NodifyEditor.ItemContainerStyle>
                    <Style TargetType="{x:Type nodify:ItemContainer}" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}"/>
                        <!-- The size Nodify measured: a new node is placed where it overlaps none, and the fit frames them all. -->
                        <Setter Property="ActualSize" Value="{Binding Size, Mode=OneWayToSource}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                    </Style>
                </nodify:NodifyEditor.ItemContainerStyle>
                <nodify:NodifyEditor.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}"/>
                </nodify:NodifyEditor.InputBindings>
            </nodify:NodifyEditor>

            <!-- Empty canvas: what to do first. -->
            <TextBlock Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" MaxWidth="420" IsHitTestVisible="False"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                       Text="El plan está vacío. Crea nodos con la barra de arriba o pide un plan al orquestador, y únelos arrastrando de una salida a una entrada."/>

            <!-- Message banner: a refused connection (the cycle path) or a confirmation; announced by screen readers. -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="14,8" CornerRadius="6"
                    BorderThickness="1" Background="{StaticResource SurfaceRaisedBrush}"
                    Visibility="{Binding HasNotice, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                    AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding NoticeText}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NoticeKind}" Value="Error">
                                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding NoticeText}" Style="{StaticResource BodyText}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource GhostButton}" Content="Cerrar" Margin="14,0,0,0" Padding="8,2" FontSize="12"
                            Command="{Binding DismissNoticeCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar: counts, zoom and the status legend (the colour of a node is also its footer text). -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Nodes.Count, StringFormat='Nodos: {0}'}" Style="{StaticResource SecondaryText}" Margin="0,0,18,0"/>
                <TextBlock Text="{Binding Connections.Count, StringFormat='Conexiones: {0}'}" Style="{StaticResource SecondaryText}" Margin="0,0,18,0"/>
                <TextBlock Text="{Binding ZoomText, StringFormat='Zoom: {0}'}" Style="{StaticResource SecondaryText}" Margin="0,0,24,0"/>
                <ItemsControl ItemsSource="{Binding StatusLegend}" Focusable="False" AutomationProperties.Name="Leyenda de estados">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type canvas:StatusLegendItem}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Ellipse Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource Orchestrator.StatusToBrush}}"/>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryText}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
