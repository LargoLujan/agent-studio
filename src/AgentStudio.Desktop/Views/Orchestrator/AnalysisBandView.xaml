<UserControl x:Class="AgentStudio.Desktop.Views.Orchestrator.AnalysisBandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:canvas="clr-namespace:AgentStudio.Desktop.Orchestrator.Canvas"
             xmlns:team="clr-namespace:AgentStudio.Desktop.Orchestrator.Team"
             xmlns:preparation="clr-namespace:AgentStudio.Desktop.Orchestrator.Preparation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=team:VisualBuilder}"
             AutomationProperties.Name="{l:T Canvas_Analysis_Title}">
    <!-- The band of the analysis of the assembly (docs/17 D-18 to D-21): what can already be known while the person assembles,
         with the fix of one click of each finding and Ctrl+Z and Ctrl+Y over them; the errors prevent approving, the suggestions
         are folded. Under it, «Revisar el orden con el orquestador», which spends quota: it asks first, with the estimate in front,
         and what it suggests is applied only by a click. Bindings only. -->
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
        <StackPanel>
            <DockPanel Margin="0,0,0,4">
                <info:InfoButton DockPanel.Dock="Right" InfoKey="Info_Canvas_Analysis" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{l:T Canvas_Analysis_Redo}" Command="{Binding Band.RedoCommand}" Margin="6,0,6,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{l:T Canvas_Analysis_Undo}" Command="{Binding Band.UndoCommand}" Margin="6,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleText}" Margin="0,0,12,0" VerticalAlignment="Center" Text="{l:T Canvas_Analysis_Title}"/>
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Band.Summary}"
                           AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
            <CheckBox Margin="0,0,0,4" IsChecked="{Binding Band.ShowSuggestions}">
                <TextBlock Text="{l:T Canvas_Analysis_ShowSuggestions}" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Style="{StaticResource ProblemText}" Margin="0,0,0,4" Text="{Binding Band.ApprovalRefusal}"
                       Visibility="{Binding Band.ApprovalRefusal, Converter={StaticResource Orchestrator.NotNullToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
            <Button Style="{StaticResource ToolbarButton}" Content="{l:T Canvas_Analysis_Retry}" Command="{Binding Band.RetryCommand}" HorizontalAlignment="Left" Margin="0,0,0,4"
                    Visibility="{Binding Band.IsFailed, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding Band.Notice}"
                       Visibility="{Binding Band.Notice, Converter={StaticResource Orchestrator.NotNullToVisibility}}"
                       AutomationProperties.LiveSetting="Polite"/>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Band.Visible}" Focusable="False" AutomationProperties.Name="{l:T Canvas_Analysis_Title}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type canvas:FindingItemViewModel}">
                            <DockPanel Margin="0,0,0,4" AutomationProperties.Name="{Binding AutomationName}">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding SeverityIcon}" Margin="0,0,8,0" VerticalAlignment="Top" MinWidth="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Content="{Binding ButtonText}"
                                        Command="{Binding ApplyFixCommand}" Visibility="{Binding HasFix, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                                        ToolTip="{Binding Consequence}"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding Text}"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Consequence}"
                                               Visibility="{Binding Consequence, Converter={StaticResource Orchestrator.NotNullToVisibility}}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" Text="{l:T Canvas_Analysis_NeverSpends}"/>

            <!-- «Revisar el orden»: spends quota, so it asks first. -->
            <StackPanel x:Name="OrderPanel" Margin="0,8,0,0" DataContext="{Binding OrderReview}">
                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding OfferText}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding UnavailableText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource ToolbarButton}" Content="{l:T Canvas_Order_Button}" Command="{Binding AskCommand}" HorizontalAlignment="Left"
                        Visibility="{Binding IsAvailable, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
                <Border Margin="0,6,0,0" Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource WarningBrush}"
                        Background="{StaticResource SurfaceRaisedBrush}" DataContext="{Binding Consent}"
                        Visibility="{Binding IsOpen, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                        AutomationProperties.Name="{l:T Canvas_Consent_Title}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Canvas_Consent_Title}"/>
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding Description}"/>
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding EstimateText}" AutomationProperties.LiveSetting="Polite"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource ToolbarPrimaryButton}" Content="{l:T Canvas_Consent_Confirm}"
                                    Command="{Binding DataContext.ConfirmCommand, ElementName=OrderPanel}"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="{l:T Canvas_Consent_Cancel}"
                                    Command="{Binding DataContext.CancelCommand, ElementName=OrderPanel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Status}"
                           Visibility="{Binding Status, Converter={StaticResource Orchestrator.NotNullToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type preparation:OrderSuggestionItemViewModel}">
                            <DockPanel Margin="0,4,0,0" AutomationProperties.Name="{Binding AutomationName}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Content="{Binding ButtonText}"
                                        Command="{Binding ApplyCommand}" Visibility="{Binding CanApply, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding Text}"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                                        <Run Text="{l:T Canvas_Order_NoteOf}"/><Run Text=": "/><Run Text="{Binding Reason, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
