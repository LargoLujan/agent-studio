<Window x:Class="AgentStudio.Desktop.Views.Orchestrator.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
        xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
        Title="{l:T Orchestrator_Approval_WindowTitle}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" UseLayoutRounding="True"
        AutomationProperties.Name="{l:T Orchestrator_Approval_WindowName}">
    <!-- Modal window of WpfApprovalDialog. Its DataContext is the question; the buttons close it through the view model. -->
    <views:ApprovalView/>
</Window>
