<UserControl x:Class="AgentStudio.Desktop.Views.Orchestrator.OrchestratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:orchestrator="clr-namespace:AgentStudio.Desktop.Orchestrator"
             xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             xmlns:lockviews="clr-namespace:AgentStudio.Desktop.Views.Lock"
             xmlns:controls="clr-namespace:AgentStudio.Desktop.Controls"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=orchestrator:OrchestratorDocumentViewModel}">
    <!-- The «Orquestador» tab: engine status, the preparation (request, frozen requirements, agents, verification
         profile), the plan under review (validation, approval, run), the canvas with the properties of the selected node,
         and the monitor of the run with the previous runs. The tab fills its pane; only when the pane is shorter than what
         the bands and the least height of the canvas and the monitor need does it scroll, so neither is ever cut off. -->
    <UserControl.Resources>
        <views:SumConverter x:Key="Orchestrator.Sum"/>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                  Background="{StaticResource BackgroundBrush}">
        <Grid x:Name="Layout" Background="{StaticResource BackgroundBrush}" Height="{Binding ViewportHeight, ElementName=Scroller}">
            <!-- The bands as tall as their content, plus the least of the canvas (260), the splitter (4) and the bottom (260). -->
            <Grid.MinHeight>
                <MultiBinding Converter="{StaticResource Orchestrator.Sum}" ConverterParameter="524">
                    <Binding ElementName="StatusBand" Path="ActualHeight"/>
                    <Binding ElementName="PreparationBand" Path="ActualHeight"/>
                    <Binding ElementName="ReviewBand" Path="ActualHeight"/>
                </MultiBinding>
            </Grid.MinHeight>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*" MinHeight="260"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="260"/>
            </Grid.RowDefinitions>

            <!-- Engine and project status: what is missing is said, never filled in. -->
            <Border x:Name="StatusBand" Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="12,8">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="12,0,0,0" VerticalAlignment="Top" Content="{l:T Orchestrator_Review_Reload}"
                                ToolTip="{l:T Orchestrator_Review_ReloadHelp}"
                                Command="{Binding ReloadCommand}"/>
                        <WrapPanel>
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding EngineTone, Converter={StaticResource Orchestrator.ToneToBrush}}"/>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"
                                       Text="{Binding EngineStatus}" AutomationProperties.Name="{l:T Orchestrator_Review_EngineName}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}" Text="{Binding ProjectRoot}"/>
                        </WrapPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Missing}" Margin="18,4,0,0" Focusable="False"
                                  Visibility="{Binding HasMissing, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                                  AutomationProperties.Name="{l:T Orchestrator_Review_MissingName}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The decision log cannot be trusted (ADR-0010): why, and, for a history no anchor recognises at this
                         location, the person's only way forward. -->
                    <StackPanel Margin="18,6,0,0" Visibility="{Binding HasIntegrityProblem, Converter={StaticResource Orchestrator.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource ErrorText}" TextWrapping="Wrap" Text="{Binding IntegrityProblem}"
                                   AutomationProperties.Name="{l:T Orchestrator_Review_IntegrityName}"
                                   AutomationProperties.LiveSetting="Assertive"/>
                        <Button Style="{StaticResource ToolbarButton}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Content="{l:T Orchestrator_Review_AcceptHistory}"
                                ToolTip="{l:T Orchestrator_Review_AcceptHistoryHelp}"
                                Visibility="{Binding CanAcceptHistory, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                                Command="{Binding AcceptHistoryCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The request, the requirements, the agents and the verification profile. -->
            <views:PreparationView x:Name="PreparationBand" Grid.Row="1"/>

            <!-- The plan under review. Its summary and «Pedir plan» share a row while there is room; where the plan stands
                 takes the whole width, so it never shrinks to a sliver whatever the buttons need; the buttons wrap. -->
            <Border x:Name="ReviewBand" Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="12,8">
                <StackPanel>
                    <views:AdaptiveColumnsPanel ColumnSpacing="12" RowSpacing="6">
                        <DockPanel views:AdaptiveColumnsPanel.Weight="3" MinWidth="240">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource SecondaryText}" Margin="0,5,8,0"
                                       VerticalAlignment="Top" Text="{l:T Orchestrator_Review_PlanSummary}"/>
                            <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding PlanSummary, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{l:T Orchestrator_Review_PlanSummary}"/>
                        </DockPanel>
                        <WrapPanel MinWidth="250" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource ToolbarButton}" Content="{l:T Orchestrator_Review_RequestPlan}" Command="{Binding RequestPlanCommand}"
                                    ToolTip="{l:T Orchestrator_Review_RequestPlanHelp}"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="{l:T Orchestrator_Review_CancelPlanning}" Command="{Binding CancelPlanningCommand}"/>
                        </WrapPanel>
                    </views:AdaptiveColumnsPanel>

                    <!-- Where the plan stands, in words that wrap within the whole band. -->
                    <WrapPanel x:Name="PlanState" Margin="0,4,0,0">
                        <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{Binding ValidationTone, Converter={StaticResource Orchestrator.ToneToBrush}}"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,16,0" Text="{Binding ValidationText}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,16,0" Text="{Binding ApprovalText}"
                                   AutomationProperties.Name="{l:T Orchestrator_Review_ApprovalName}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Style="{StaticResource OptionalSecondaryText}" VerticalAlignment="Center"
                                   Text="{Binding ExecuteBlockers, Converter={x:Static views:FormatTextConverter.Instance}, ConverterParameter=Orchestrator_Review_ToRun}"/>
                    </WrapPanel>
                    <!-- Part of what «Aprobar plan» approves: the steps that run the agents' code with the user's rights (ADR-0017). -->
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}" Text="{Binding IsolationWarning}"
                               Visibility="{Binding HasIsolationWarning, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                               AutomationProperties.Name="{l:T Orchestrator_Review_IsolationName}" AutomationProperties.LiveSetting="Polite"/>
                    <!-- B10: a valid plan whose writing no integration reviewed by the judge takes in cannot be delivered. -->
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}" Text="{Binding DeliveryWarning}"
                               Visibility="{Binding HasDeliveryWarning, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                               AutomationProperties.Name="{l:T Orchestrator_Review_DeliveryWarningName}" AutomationProperties.LiveSetting="Polite"/>
                    <!-- «Aprobar plan» without Windows Hello on this computer: the button decided alone (docs/16 D-13). -->
                    <lockviews:HelloNoticeView/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource Orchestrator.BoolToVisibility}}">
                        <ProgressBar Style="{StaticResource AccentProgress}" Width="120" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding BusyText}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource ErrorText}" Margin="0,4,0,0" Text="{Binding ErrorMessage}"/>

                    <!-- The decision on the plan and the run. -->
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource ToolbarButton}" Content="{l:T Orchestrator_Review_Validate}" Command="{Binding ValidateCommand}"/>
                        <Button Style="{StaticResource ToolbarButton}" Content="{l:T Orchestrator_Review_Approve}" Command="{Binding ApproveCommand}"/>
                        <Button Style="{StaticResource ToolbarButton}" Content="{l:T Orchestrator_Review_Reject}" Command="{Binding RejectCommand}"/>
                        <!-- The consent of the next run (docs/16 D-39, decision 4 (a)): off by default, it goes into its header. -->
                        <CheckBox Style="{StaticResource FieldCheckBox}" Margin="6,0,12,6" VerticalAlignment="Center"
                                  Content="{x:Static orchestrator:OrchestratorDocumentViewModel.ResumeConsentLabel}"
                                  IsChecked="{Binding AutoResumeConsent}" IsEnabled="{Binding CanChooseResumeConsent}"
                                  ToolTip="{x:Static orchestrator:OrchestratorDocumentViewModel.ResumeConsentToolTip}"
                                  ToolTipService.ShowOnDisabled="True"
                                  AutomationProperties.HelpText="{x:Static orchestrator:OrchestratorDocumentViewModel.ResumeConsentToolTip}"/>
                        <info:InfoButton InfoKey="Info_ResumeConsent" Margin="0,0,12,6" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ToolbarPrimaryButton}" Content="{l:T Orchestrator_Review_Execute}" Command="{Binding ExecuteCommand}"
                                ToolTip="{Binding ExecuteBlockers}" ToolTipService.ShowOnDisabled="True"/>
                        <Button Style="{StaticResource ToolbarButton}" Content="{l:T Orchestrator_Review_EditPlan}" Command="{Binding EditPlanCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Canvas | properties and plan details. -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="220" MaxWidth="480"/>
                </Grid.ColumnDefinitions>
                <views:CanvasView Grid.Column="0" DataContext="{Binding Canvas}"/>
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"
                              ResizeBehavior="PreviousAndNext" Focusable="False"/>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,12">
                            <views:TeamPanelView DataContext="{Binding Builder.Editor}"
                                                 Visibility="{Binding DataContext.Canvas.IsTeamLayer, RelativeSource={RelativeSource AncestorType=views:OrchestratorView}, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
                            <StackPanel Visibility="{Binding Canvas.IsPlanLayer, Converter={StaticResource Orchestrator.BoolToVisibility}}">
                            <ContentControl Content="{Binding Editor}" Focusable="False"
                                            Visibility="{Binding Editor, Converter={StaticResource Orchestrator.NotNullToVisibility}}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <views:NodePropertiesView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                       Visibility="{Binding Editor, Converter={StaticResource Orchestrator.NullToVisibility}}"
                                       Text="{l:T Orchestrator_Review_SelectNode}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,20,0,4" Text="{l:T Orchestrator_Review_Problems}"
                                       Visibility="{Binding ShowValidation, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding Problems}" Focusable="False" AutomationProperties.Name="{l:T Orchestrator_Review_Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type orchestrator:PlanProblem}">
                                        <Button Style="{StaticResource GhostButton}" BorderThickness="0" Padding="4,3" Margin="0,0,0,2"
                                                HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.SelectProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Text}">
                                            <TextBlock Style="{StaticResource ProblemText}" Text="{Binding Text}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,20,0,0" Visibility="{Binding Proposal, Converter={StaticResource Orchestrator.NotNullToVisibility}}">
                                <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,0,0,4" Text="{l:T Orchestrator_Review_Proposal}"/>
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProposalStatus}" AutomationProperties.LiveSetting="Polite"/>
                                <!-- The orchestrator asked instead of planning (docs/17 D-28): its questions open as windows, and this opens them again. -->
                                <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{l:T Shell_Planner_Answer}"
                                        Command="{Binding OpenPlannerQuestionsCommand}" ToolTip="{l:T Shell_Planner_AnswerHelp}"
                                        AutomationProperties.Name="{l:T Shell_Planner_Answer}" AutomationProperties.HelpText="{l:T Shell_Planner_AnswerHelp}"
                                        Visibility="{Binding HasPlannerQuestions, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Orchestrator_Review_Risks}"/>
                                <ItemsControl ItemsSource="{Binding Risks}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding StringFormat='• {0}'}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,0,0,4" Text="{l:T Orchestrator_Review_Activity}"/>
                                <!-- Its context while it plans (docs/18 P3), step by step, with its origin and level. -->
                                <controls:MetricBar Margin="0,0,0,6" TrackWidth="110" Reading="{Binding PlanningContext}"
                                                    Visibility="{Binding PlanningContext, Converter={StaticResource Orchestrator.NotNullToVisibility}}"/>
                                <TextBlock Text="{l:T Orchestrator_Review_NothingYet}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlanningActivity.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding PlanningActivity}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Focusable="False"/>

            <!-- Run monitor | previous runs: side by side while both have room, the list under the monitor otherwise. -->
            <views:AdaptiveColumnsPanel x:Name="BottomColumns" Grid.Row="5" FillHeight="True" ColumnSpacing="0" RowSpacing="0">
                <views:RunMonitorView DataContext="{Binding Monitor}" views:AdaptiveColumnsPanel.Weight="3" views:AdaptiveColumnsPanel.RowWeight="2" MinWidth="420"/>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,0,0" Padding="12,10" views:AdaptiveColumnsPanel.Weight="1" MinWidth="240">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitleText}" Margin="0,0,0,2" Text="{l:T Orchestrator_Runs_Title}"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"
                                   Text="{l:T Orchestrator_Runs_Hint}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{l:T Orchestrator_Runs_None}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviousRuns.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding PreviousRuns}" AutomationProperties.Name="{l:T Orchestrator_Runs_Title}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type orchestrator:RunListItem}">
                                        <!-- The run the monitor shows is marked: raised, with an accent edge and the words. -->
                                        <Border BorderThickness="3,0,0,1" Padding="8,6" Margin="0,0,0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsViewed}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <WrapPanel>
                                                    <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Fill="{Binding PhaseTone, Converter={StaticResource Orchestrator.ToneToBrush}}"/>
                                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,8,0" Text="{Binding PhaseLabel}"/>
                                                    <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Text="{Binding When}"/>
                                                </WrapPanel>
                                                <TextBlock Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           Text="{Binding Summary.Summary}" ToolTip="{Binding Summary.Summary}"/>
                                                <TextBlock Style="{StaticResource SecondaryText}" FontFamily="{StaticResource MonoFont}" Text="{Binding Summary.Id}"/>
                                                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Text="{l:T Orchestrator_Runs_Viewed}"
                                                           Visibility="{Binding IsViewed, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
                                                <WrapPanel Margin="0,4,0,0">
                                                    <Button Style="{StaticResource ToolbarButton}" Content="{l:T Orchestrator_Runs_View}"
                                                            ToolTip="{l:T Orchestrator_Runs_ViewHelp}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            Visibility="{Binding CanView, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                                                            Command="{Binding DataContext.ViewRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Summary.Id, Converter={x:Static views:FormatTextConverter.Instance}, ConverterParameter=Orchestrator_Runs_ViewName}"/>
                                                    <Button Style="{StaticResource ToolbarButton}" Content="{l:T Orchestrator_Runs_Resume}"
                                                            ToolTip="{l:T Orchestrator_Runs_ResumeHelp}"
                                                            Visibility="{Binding CanResume, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                                                            Command="{Binding DataContext.ResumeRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Summary.Id, Converter={x:Static views:FormatTextConverter.Instance}, ConverterParameter=Orchestrator_Runs_ResumeName}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </views:AdaptiveColumnsPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
