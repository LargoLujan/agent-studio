<UserControl x:Class="AgentStudio.Desktop.Views.Orchestrator.RunMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:monitor="clr-namespace:AgentStudio.Desktop.Orchestrator.Monitor"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             xmlns:debateViews="clr-namespace:AgentStudio.Desktop.Views.Debate"
             xmlns:controls="clr-namespace:AgentStudio.Desktop.Controls"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:questions="clr-namespace:AgentStudio.Desktop.Orchestrator.Questions"
             xmlns:consumption="clr-namespace:AgentStudio.Desktop.Views.Observability.Analysis"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=monitor:RunMonitorViewModel}">
    <!-- The monitor of a run: phase, graph health, tasks (with queue, block reason and last activity), activity log and
         evidence. Every line is what the run reported; the commands ask the run and wait for it to say what happened.
         «Entregar a mi rama» asks the delivery service, which checks the run and asks your approval before git.
         Phase 5 (docs/15 D-43): once the run ended, the auditor of the orchestrator, its request to replan, the card of the
         review's verdict with «Impugnar» and where its challenge stands; the whole band is collapsed until there is one. -->
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Phase, commands and health. The phase and the commands share a row while there is room; the commands wrap. -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel>
                <orchestratorViews:AdaptiveColumnsPanel ColumnSpacing="12" RowSpacing="4">
                    <WrapPanel orchestratorViews:AdaptiveColumnsPanel.Weight="1" MinWidth="240" VerticalAlignment="Top" Margin="0,4,0,0">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{Binding PhaseTone, Converter={StaticResource Orchestrator.ToneToBrush}}"/>
                        <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,0,12,0" Text="{Binding PhaseLabel}"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Fase de la ejecución"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,12,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" Text="{Binding RunId}"/>
                        <info:InfoButton InfoKey="Info_Monitor" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <!-- The budget of the run (docs/18 P3): the agent runs used against its maximum, measured by Agent Studio. -->
                        <controls:MetricBar VerticalAlignment="Center" TrackWidth="90" Reading="{Binding BudgetBar}"
                                            Visibility="{Binding IsAttached, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
                    </WrapPanel>
                    <WrapPanel orchestratorViews:AdaptiveColumnsPanel.Weight="1.2" MinWidth="260" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <!-- A run read back from its log takes no command: only its delivery and «Cerrar». -->
                        <Button Style="{StaticResource ToolbarButton}" Content="Pausar" Command="{Binding PauseCommand}"
                                Visibility="{Binding IsInspecting, Converter={StaticResource Orchestrator.FalseToVisibility}}"/>
                        <Button Style="{StaticResource ToolbarButton}" Content="Reanudar" Command="{Binding ResumeCommand}"
                                Visibility="{Binding IsInspecting, Converter={StaticResource Orchestrator.FalseToVisibility}}"/>
                        <Button Style="{StaticResource ToolbarButton}" Content="Cancelar ejecución" Command="{Binding CancelCommand}"
                                Visibility="{Binding IsInspecting, Converter={StaticResource Orchestrator.FalseToVisibility}}"/>
                        <!-- Enabled only for a finished run the delivery service found ready; it asks your approval first. -->
                        <Button Style="{StaticResource ToolbarPrimaryButton}" Content="Entregar a mi rama" Command="{Binding DeliverCommand}"
                                ToolTip="Lleva con --ff-only la integración que aprobó el juez a la rama que tienes activa. Antes te pide aprobación."
                                ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="Entregar a mi rama"
                                AutomationProperties.HelpText="{Binding DeliveryMessage}"/>
                        <Button Style="{StaticResource ToolbarButton}" Content="Cerrar" Command="{Binding CloseInspectionCommand}"
                                ToolTip="Deja de ver esta ejecución y vuelve a tu borrador en el lienzo"
                                Visibility="{Binding IsInspecting, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                                AutomationProperties.Name="Cerrar la ejecución que estás viendo"/>
                    </WrapPanel>
                </orchestratorViews:AdaptiveColumnsPanel>
                <!-- The words are the accessible name: a reader of the screen reads them whole. -->
                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="18,2,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding InspectionText}" FontStyle="Italic"
                           Visibility="{Binding IsInspecting, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
                <!-- The run looked at was delivered already: where, when, and what delivering it again does. -->
                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="18,2,0,0" Foreground="{StaticResource WarningBrush}"
                           Text="{Binding PreviousDelivery}"
                           Visibility="{Binding PreviousDelivery, Converter={StaticResource Orchestrator.HasTextToVisibility}}"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="18,2,0,0" Text="{Binding PhaseDetail}"/>
                <!-- Whether the run has the consent of its header to resume by itself (docs/16 D-39); hidden while not known. -->
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="18,2,0,0" TextWrapping="Wrap"
                           Text="{Binding ResumeConsentText, TargetNullValue=''}"
                           AutomationProperties.Name="Consentimiento para reanudarse sola"/>
                <!-- V35: the summary of the result only when it says more than the detail of the phase (the engine sends both). -->
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="18,2,0,0" Text="{Binding ResultSummaryText}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="18,2,0,0" TextWrapping="Wrap"
                           Text="{Binding DeliveryMessage, TargetNullValue=''}"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Entrega a tu rama"/>
                <TextBlock Style="{StaticResource ErrorText}" Margin="0,6,0,0" Text="{Binding ErrorMessage}"/>
                <TextBlock Style="{StaticResource ProblemText}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" Text="{Binding DeadlockText}"
                           Visibility="{Binding ShowsDeadlockAlert, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                           AutomationProperties.LiveSetting="Assertive"/>
                <WrapPanel Margin="0,6,0,0" Visibility="{Binding IsAttached, Converter={StaticResource Orchestrator.BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,16,0" Text="{Binding HealthSummary}"/>
                    <ItemsControl ItemsSource="{Binding HealthLines}" Focusable="False" AutomationProperties.Name="Salud del grafo">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,16,0" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
                <!-- Phase 13 (docs/17 D-12, D-14, D-17; F13-6 to F13-8): the quota of the account, one bar per window with its origin;
                     the questions the agents ask and wait for; and one card per agent with its state and its bars. A change of state
                     is announced (assertive for a question or a block, polite for the rest). -->
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Visibility="{Binding IsAttached, Converter={StaticResource Orchestrator.BoolToVisibility}}">
                <StackPanel>
                <ItemsControl ItemsSource="{Binding QuotaBars}" Focusable="False" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MetricBar Margin="0,0,16,2" TrackWidth="90" Reading="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding PendingQuestions}" Focusable="False" Margin="0,8,0,0"
                              Visibility="{Binding HasPendingQuestions, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                              AutomationProperties.Name="{l:T Monitor_Question_Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type questions:QuestionViewModel}">
                            <Border BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6"
                                    AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.LiveSetting="Assertive">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarPrimaryButton}" VerticalAlignment="Center" Margin="8,0,0,0"
                                            Content="{l:T Monitor_Question_Open}"
                                            Command="{Binding DataContext.OpenQuestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Text="{Binding Text}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                </StackPanel>
                </ScrollViewer>

                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding IsAttached, Converter={StaticResource Orchestrator.FalseToVisibility}}"
                           Text="Sin ejecución. Valida y aprueba un plan y pulsa «Ejecutar», reanuda una ejecución interrumpida o abre una anterior con «Ver»."/>
            </StackPanel>
        </Border>

        <!-- The review of the finished run (docs/15 D-33 to D-35, D-40 and D-43). -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8"
                Visibility="{Binding HasReviewSection, Converter={StaticResource Orchestrator.BoolToVisibility}}">
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <DockPanel Visibility="{Binding AuditSummary, Converter={StaticResource Orchestrator.NotNullToVisibility}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource ToolbarButton}" Content="Auditar de nuevo" Command="{Binding AuditAgainCommand}"
                                    ToolTip="El auditor determinista vuelve a revisar el registro: no gasta cuota y no repite lo ya anotado."/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Comprobar de nuevo" Command="{Binding RefreshReviewCommand}"
                                    ToolTip="Lee otra vez el veredicto, su impugnación y si la ejecución se puede entregar."/>
                        </StackPanel>
                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,4,8,0" VerticalAlignment="Top"
                                 Fill="{Binding AuditTone, Converter={StaticResource Orchestrator.ToneToBrush}}"/>
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding AuditSummary}"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Auditor del orquestador"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding AuditFindings}" Focusable="False" Margin="18,4,0,0" AutomationProperties.Name="Hallazgos del auditor">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type monitor:AuditFindingRow}">
                                <DockPanel Margin="0,2,0,2">
                                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,5,6,0" VerticalAlignment="Top"
                                             Fill="{Binding Tone, Converter={StaticResource Orchestrator.ToneToBrush}}"/>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}" FontSize="12">
                                            <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding Check, Mode=OneWay}"/>
                                            <Run Text="·" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text="{Binding Code, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Message}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding ReplanText, Converter={StaticResource Orchestrator.NotNullToVisibility}}">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}" Text="{Binding ReplanText}"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Petición de replanificar"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Style="{StaticResource ToolbarButton}" Content="Preparar ejecución de seguimiento" Command="{Binding PrepareFollowUpCommand}"
                                    ToolTip="Pone en el lienzo un plan vacío que sigue a esta ejecución, con los hallazgos como datos. Planificas y apruebas tú."/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Descartar la petición" Command="{Binding DismissReplanCommand}"
                                    ToolTip="Te pide aprobación (replan.dismiss): la entrega deja de esperar por la petición; los hallazgos siguen en el registro."/>
                        </StackPanel>
                    </StackPanel>
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding ChallengeText, Converter={StaticResource Orchestrator.NotNullToVisibility}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarPrimaryButton}" Content="Aceptar la revisión" Command="{Binding AcceptRevisionCommand}"
                                Visibility="{Binding RevisionVerdictId, Converter={StaticResource Orchestrator.NotNullToVisibility}}"
                                ToolTip="Una revisión que da la vuelta hacia una aprobación solo cuenta si la aceptas expresamente (verdict.revision.accept)."/>
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,5,8,0" VerticalAlignment="Top"
                                 Fill="{Binding ChallengeTone, Converter={StaticResource Orchestrator.ToneToBrush}}"/>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12" Text="{Binding ChallengeText}" AutomationProperties.Name="Impugnación del veredicto"/>
                    </DockPanel>
                    <debateViews:VerdictCardView Margin="0,8,0,0" DataContext="{Binding ReviewCard}" Visibility="{Binding Converter={StaticResource Orchestrator.NotNullToVisibility}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- The analysis of the consumption of the run (docs/17 D-34 and D-35, F13-15): collapsed until the shell composes the analyzer
             and a run with its project is on screen. -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8"
                Visibility="{Binding Consumption.IsAvailable, Converter={StaticResource Orchestrator.BoolToVisibility}}">
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <consumption:ConsumptionAnalysisView DataContext="{Binding Consumption}"/>
            </ScrollViewer>
        </Border>

        <!-- Tasks | activity | evidence: in columns while they fit, the tasks over the other two when narrower, one under
             another when narrower still; they share the height of the monitor. -->
        <orchestratorViews:AdaptiveColumnsPanel x:Name="Lists" Grid.Row="3" Margin="12,8,12,10" FillHeight="True" ColumnSpacing="12" RowSpacing="8">

            <!-- Phase 13 (docs/17 D-12, D-14, D-17; F13-6 to F13-8): one card per agent with its state and its bars, each with its origin. A
                 change of state is announced (assertive for a question or a block, polite for the rest). -->
            <DockPanel orchestratorViews:AdaptiveColumnsPanel.Weight="3" MinWidth="230">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="{l:T Monitor_Agents_Title}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding AgentCards}" Focusable="False" AutomationProperties.Name="{l:T Monitor_Agents_Title}"
                                  Visibility="{Binding IsAttached, Converter={StaticResource Orchestrator.BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type monitor:AgentCardViewModel}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6"
                                        AutomationProperties.Name="{Binding AccessibleName}"
                                        AutomationProperties.LiveSetting="{Binding LiveSetting}"
                                        ToolTip="{Binding RunsText}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding Tone, Converter={StaticResource Orchestrator.ToneToBrush}}"/>
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}"/>
                                            <TextBlock Style="{StaticResource SecondaryText}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}"/>
                                        </StackPanel>
                                        <controls:MetricBar Margin="0,2,0,0" TrackWidth="80" IsCompact="True" Reading="{Binding ContextBar}"/>
                                        <controls:MetricBar Margin="0,1,0,0" TrackWidth="80" IsCompact="True" Reading="{Binding PartsBar}"
                                                            Visibility="{Binding PartsBar, Converter={StaticResource Orchestrator.NotNullToVisibility}}"/>
                                        <controls:MetricBar Margin="0,1,0,0" TrackWidth="80" IsCompact="True" Reading="{Binding ConsumptionBar}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <DockPanel orchestratorViews:AdaptiveColumnsPanel.Weight="5" MinWidth="240">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="Tareas"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Tasks}" AutomationProperties.Name="Tareas de la ejecución">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type monitor:MonitorTaskViewModel}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5"
                                        AutomationProperties.Name="{Binding StatusLabel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Margin="0,5,8,0" VerticalAlignment="Top"
                                                 Fill="{Binding Status, Converter={StaticResource Orchestrator.StatusToBrush}}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{Binding Id, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding StatusLabel, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding AttemptText, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding EvidenceText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <!-- B7: why the task is where it is (the reason of its last transition, or of its last
                                                 failure while it is tried again) and, for a verification step that failed, the
                                                 main line of the error in its evidence. Briefly: the evidence keeps it all. -->
                                            <TextBlock FontSize="12" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding ReasonText}" ToolTip="{Binding ReasonText}"
                                                       Visibility="{Binding ReasonText, Converter={StaticResource Orchestrator.HasTextToVisibility}}"
                                                       AutomationProperties.Name="{Binding ReasonText, StringFormat='Motivo: {0}'}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Blocked">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="AwaitingApproval">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding FailureLine}" ToolTip="{Binding FailureLine}"
                                                       Visibility="{Binding ShowsFailureLine, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                                                       AutomationProperties.Name="{Binding FailureLine, StringFormat='Error del paso: {0}'}"/>
                                            <TextBlock Style="{StaticResource OptionalSecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding LastActivity}"/>
                                            <!-- The context of the latest step of the attempt (docs/14 D-12, docs/18 P3), always for a task
                                                 that runs an agent: the bar with its percentage, origin and level (an empty track that says
                                                 why when there is none), and under it the tokens against the window, the model and the
                                                 compactions of the CLI. Then the tokens the CLI reported at the end of the last attempt. -->
                                            <controls:MetricBar Margin="0,3,0,0" TrackWidth="120" Reading="{Binding ContextBar}"
                                                                Visibility="{Binding ContextBar, Converter={StaticResource Orchestrator.NotNullToVisibility}}"
                                                                AutomationProperties.Name="{Binding Context}"/>
                                            <TextBlock Style="{StaticResource OptionalSecondaryText}" TextWrapping="Wrap" Text="{Binding ContextDetail}"/>
                                            <TextBlock Style="{StaticResource OptionalSecondaryText}" TextWrapping="Wrap" Text="{Binding TokensText, TargetNullValue=''}"/>
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}"
                                                       Visibility="{Binding PendingApproval, Converter={StaticResource Orchestrator.NotNullToVisibility}}"
                                                       Text="{Binding PendingApproval, StringFormat='Espera tu aprobación: {0}'}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top">
                                            <Button Style="{StaticResource ToolbarButton}"
                                                    Content="Reintentar"
                                                    Visibility="{Binding IsBlocked, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                                                    Command="{Binding DataContext.RetryBlockedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Id, StringFormat='Reintentar {0}'}"/>
                                            <!-- A task whose agent asked waits for the answer: «Reintentar» would relaunch it without it, so it is not offered (ADR-0051). -->
                                            <Button Style="{StaticResource ToolbarPrimaryButton}" Content="{l:T Monitor_Question_Open}"
                                                    Visibility="{Binding HasQuestion, Converter={StaticResource Orchestrator.BoolToVisibility}}"
                                                    Command="{Binding DataContext.OpenQuestionOfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <DockPanel orchestratorViews:AdaptiveColumnsPanel.Weight="4" MinWidth="180">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="Actividad"/>
                <ListBox ItemsSource="{Binding Activity}" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Actividad de la ejecución">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type monitor:ActivityEntry}">
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap">
                                <Run Text="{Binding Time, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding Task, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
                                <Run Text="{Binding Text, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel orchestratorViews:AdaptiveColumnsPanel.Weight="3" MinWidth="160">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="Evidencias"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Evidence}" AutomationProperties.Name="Evidencias de la ejecución">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type monitor:EvidenceEntry}">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap">
                                        <Run Text="{Binding Task, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Title, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                                        <Run Text="{Binding Kind, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Origin, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding ShortHash, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding Tests}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </orchestratorViews:AdaptiveColumnsPanel>
    </Grid>
</UserControl>
