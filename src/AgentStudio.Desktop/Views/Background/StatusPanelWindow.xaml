<Window x:Class="AgentStudio.Desktop.Views.Background.StatusPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Background"
        xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
        Title="{l:T Background_Panel_WindowTitle}"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Background="{StaticResource SurfaceBrush}" UseLayoutRounding="True"
        AutomationProperties.Name="{l:T Background_Panel_WindowName}">
    <!-- The window of the panel next to the notification area (WindowStatusPanelPresenter). Esc hides it. -->
    <views:StatusPanelView/>
</Window>
