<Window x:Class="AgentStudio.Desktop.Views.Background.ExitPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Background"
        Title="Salir con trabajo en marcha · Agent Studio"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        Background="{StaticResource SurfaceBrush}" UseLayoutRounding="True"
        AutomationProperties.Name="Salir con trabajo en marcha">
    <!-- Modal window of WpfExitPrompt. Its DataContext is the question; the buttons close it through the view model. -->
    <views:ExitPromptView/>
</Window>
