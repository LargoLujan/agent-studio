<UserControl x:Class="AgentStudio.Desktop.Views.Background.UnattendedSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:background="clr-namespace:AgentStudio.Desktop.Background"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=background:UnattendedSettingsViewModel}"
             AutomationProperties.Name="{x:Static background:UnattendedSettingsViewModel.Title}">
    <!-- «Trabajo desatendido», a section of «Ajustes» (docs/16 D-14 and D-40): what closing the window does and keeping the
         computer awake while there is work. «Guardar» is the document's, for every section at once, and «Windows Hello y
         bloqueo» is a section of its own. Nothing changes until it is saved. Bindings only. -->
    <UserControl.Resources>
        <Style x:Key="Unattended.Choice" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static background:UnattendedSettingsViewModel.Title}"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                   Text="Qué pasa al cerrar la ventana con trabajo en marcha, y si el equipo se mantiene despierto mientras sigue."/>

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,2" Text="Al cerrar la ventana"/>
        <ItemsControl ItemsSource="{Binding CloseWindowChoices}" Focusable="False" AutomationProperties.Name="Al cerrar la ventana">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type background:CloseWindowChoice}">
                    <!-- A string as the content never wraps: a wrapping TextBlock does, and the name is set by hand. -->
                    <RadioButton Style="{StaticResource Unattended.Choice}" GroupName="Unattended.CloseWindow"
                                 IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Label}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding Label}"/>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="22,4,0,0" Text="{x:Static background:UnattendedSettingsViewModel.CloseWindowExplanation}"/>

        <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,16,0,0" IsChecked="{Binding PreventSleepWhileWorking}"
                  AutomationProperties.Name="Impedir la suspensión mientras hay trabajo"
                  AutomationProperties.HelpText="{x:Static background:UnattendedSettingsViewModel.PreventSleepExplanation}">
            <TextBlock TextWrapping="Wrap" Text="Impedir la suspensión mientras hay trabajo"/>
        </CheckBox>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="22,2,0,0" Text="{x:Static background:UnattendedSettingsViewModel.PreventSleepExplanation}"/>
    </StackPanel>
</UserControl>
