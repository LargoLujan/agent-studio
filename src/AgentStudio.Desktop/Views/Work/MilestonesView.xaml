<UserControl x:Class="AgentStudio.Desktop.Views.Work.MilestonesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:work="clr-namespace:AgentStudio.Desktop.Work"
             xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Work"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=work:MilestonesSection}">
    <!-- «Hitos» (docs/16 D-17, D-49 and D-50): open one with its frozen requirements and an optional budget, see its replayed state, link
         runs and debates, close it (an audit, with the same approval and consent as «Auditar proyecto completo») and reopen it, keeping
         the report before. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Work.BoolToVisibility"/>
        <orchestratorViews:FalseToVisibilityConverter x:Key="Work.InverseBoolToVisibility"/>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Text="{Binding Title}"/>
            <info:InfoButton InfoKey="Info_Work_Milestones" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <views:SectionNotices/>

        <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Milestone_New}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Milestone_NameLabel}"/>
                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{l:T Work_Milestone_NameLabel}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Milestone_ObjectiveLabel}"/>
                <TextBox Style="{StaticResource MultilineFieldTextBox}" MinHeight="54" Text="{Binding NewObjective, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{l:T Work_Milestone_ObjectiveLabel}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Milestone_PickRequirements}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Work_Milestone_NoBacklog}"
                           Visibility="{Binding HasBacklogChoices, Converter={StaticResource Work.InverseBoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding BacklogChoices}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type work:BacklogChoiceViewModel}">
                            <CheckBox Margin="0,2" IsChecked="{Binding IsIncluded}" AutomationProperties.Name="{Binding Statement}">
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Statement}"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Milestone_BudgetLabel}"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0" MinWidth="180">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Work_Budget_TokensLabel}"/>
                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding NewMaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{l:T Work_Budget_TokensLabel}"/>
                    </StackPanel>
                    <StackPanel MinWidth="180">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Work_Budget_RunsLabel}"/>
                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding NewMaxRuns, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{l:T Work_Budget_RunsLabel}"/>
                    </StackPanel>
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding OpenProblems}" Focusable="False" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource ProblemText}" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:T Work_Milestone_Open}"
                        Command="{Binding OpenCommand}"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0" Text="{l:T Work_Milestone_List}"/>
        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Work_Milestone_Empty}"
                   Visibility="{Binding HasItems, Converter={StaticResource Work.InverseBoolToVisibility}}"/>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" MaxHeight="200" Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="{l:T Work_Milestone_List}"
                 Visibility="{Binding HasItems, Converter={StaticResource Work.BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type work:MilestoneRow}">
                    <StackPanel Margin="2,3">
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StatusText}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding TargetsText}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0" Visibility="{Binding HasSelection, Converter={StaticResource Work.BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="{Binding SelectedItem.Name}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{Binding ObjectiveText}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding StatusText}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding RequirementsText}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding BudgetText}"/>
                <!-- Phase 10 (docs/21 section 7.4): «integrado» (by delivery or by pull request) and «desplegado», this one only when the platform reported a deployment. -->
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding IntegrationText}"
                           Visibility="{Binding HasIntegration, Converter={StaticResource Work.BoolToVisibility}}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding DeploymentText}"
                           Visibility="{Binding HasDeployment, Converter={StaticResource Work.BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding DetailProblems}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource ProblemText}" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{l:T Work_ViewChain}"
                        Command="{Binding ViewChainCommand}"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Milestone_Linked}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Work_Milestone_NothingLinked}"
                           Visibility="{Binding HasTargets, Converter={StaticResource Work.InverseBoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Targets}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,6,0,0">
                    <ComboBox ItemsSource="{Binding RunChoices}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Label" MinWidth="260" Margin="0,0,8,6"
                              AutomationProperties.Name="{l:T Work_Milestone_RunPick}"/>
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,16,6" Content="{l:T Work_Milestone_LinkRun}" Command="{Binding LinkRunCommand}"/>
                    <ComboBox ItemsSource="{Binding DebateChoices}" SelectedItem="{Binding SelectedDebate}" DisplayMemberPath="Label" MinWidth="260" Margin="0,0,8,6"
                              AutomationProperties.Name="{l:T Work_Milestone_DebatePick}"/>
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,0,6" Content="{l:T Work_Milestone_LinkDebate}" Command="{Binding LinkDebateCommand}"/>
                </WrapPanel>

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Milestone_Reports}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Work_Milestone_NoReports}"
                           Visibility="{Binding HasReports, Converter={StaticResource Work.InverseBoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Reports}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type work:ReportRow}">
                            <StackPanel Margin="0,2,0,6">
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding AuditText}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding CommitText}"/>
                                <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Content="{l:T Work_Report_Open}"
                                        Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource InnerCard}" Padding="8" Margin="0,6,0,0" Visibility="{Binding HasOpenedReport, Converter={StaticResource Work.BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding OpenedReport.Title}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding OpenedReport.Description}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding OpenedReport.HashText}"/>
                        <TextBox Style="{StaticResource MonoViewer}" TextWrapping="Wrap" MaxHeight="320" HorizontalScrollBarVisibility="Disabled"
                                 Text="{Binding OpenedReport.Text, Mode=OneWay, TargetNullValue=''}" AutomationProperties.Name="{l:T Work_Report_Text}"/>
                        <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{l:T Work_Close_Viewer}"
                                Command="{Binding CloseReportCommand}"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Close_Heading}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Work_Close_Explain}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Text="{l:T Work_Close_Judge}"/>
                <ComboBox ItemsSource="{Binding Judges}" SelectedItem="{Binding SelectedJudge}" MinWidth="260" HorizontalAlignment="Left"
                          AutomationProperties.Name="{l:T Work_Close_Judge}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Text="{l:T Work_Close_Authors}"/>
                <ItemsControl ItemsSource="{Binding Authors}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,2" IsChecked="{Binding IsDeclared}" Content="{Binding Name}" AutomationProperties.Name="{Binding Name}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:T Work_Close_Button}"
                        Command="{Binding CloseMilestoneCommand}"
                        IsEnabled="{Binding CanClose}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,4,0,0" Text="{Binding CloseStatus, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Reopen_Heading}"/>
                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding ReopenNote, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{l:T Work_Reopen_Note}"/>
                <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{l:T Work_Reopen_Button}"
                        Command="{Binding ReopenCommand}" IsEnabled="{Binding CanReopen}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
