<UserControl x:Class="AgentStudio.Desktop.Views.Work.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:work="clr-namespace:AgentStudio.Desktop.Work"
             xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Work"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=work:BoardSection}">
    <!-- «Tablero» (docs/16 D-19, F9-2): the seven columns of the milestone selected, as the verified log puts the cards. Nothing is
         dragged, and no card reaches «Hecho» without an approved verdict. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Work.BoolToVisibility"/>
        <orchestratorViews:FalseToVisibilityConverter x:Key="Work.InverseBoolToVisibility"/>
        <DataTemplate x:Key="Work.Card" DataType="{x:Type work:BoardCardViewModel}">
            <Border Style="{StaticResource InnerCard}" Padding="8" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding KindText}"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}"/>
                    <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding RunText, TargetNullValue=''}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding IntegratedByText, TargetNullValue=''}"
                               Visibility="{Binding HasIntegratedBy, Converter={StaticResource Work.BoolToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasReason, Converter={StaticResource Work.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"
                                   Text="{Binding ReasonText, TargetNullValue=''}"/>
                        <!-- Phase 10 (docs/21 section 7.4): «Fusionado con cambios que el juez no vio» says what it means in its ⓘ. -->
                        <info:InfoButton InfoKey="Info_Hosting_MergedUnjudged" Margin="6,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding HasUnjudgedReason, Converter={StaticResource Work.BoolToVisibility}}"/>
                    </StackPanel>
                    <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Content="{l:T Work_ViewChain}"
                            Command="{Binding ViewChainCommand}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Text="{Binding Title}"/>
            <info:InfoButton InfoKey="Info_Work_Board" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <views:SectionNotices/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Text="{Binding MilestoneText}"/>
        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding ReadText, TargetNullValue=''}"/>

        <ItemsControl ItemsSource="{Binding Columns}" Focusable="False" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type work:BoardColumnViewModel}">
                    <Border Style="{StaticResource Card}" Width="250" Padding="8" Margin="0,0,8,8" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Title}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,6" Text="{Binding CountText}"/>
                            <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" ItemTemplate="{StaticResource Work.Card}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Board_ProjectBacklog}"/>
        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Work_Board_ProjectBacklogEmpty}"
                   Visibility="{Binding HasProjectBacklog, Converter={StaticResource Work.InverseBoolToVisibility}}"/>
        <ItemsControl ItemsSource="{Binding ProjectBacklog}" Focusable="False" ItemTemplate="{StaticResource Work.Card}"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Rules_Heading}"/>
        <ItemsControl ItemsSource="{Binding Rules}" Focusable="False" Margin="4,2,0,0" AutomationProperties.Name="{l:T Work_Rules_Heading}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2" Text="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
