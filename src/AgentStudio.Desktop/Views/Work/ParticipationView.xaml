<UserControl x:Class="AgentStudio.Desktop.Views.Work.ParticipationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:work="clr-namespace:AgentStudio.Desktop.Work"
             xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Work"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=work:ParticipationSection}">
    <!-- «Participantes» (docs/16 D-32, F9-5): the six roles of a task, a run or a milestone. A role no source gives says «No consta».
         Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Work.BoolToVisibility"/>
        <orchestratorViews:FalseToVisibilityConverter x:Key="Work.InverseBoolToVisibility"/>
    </UserControl.Resources>

    <StackPanel>
        <views:SectionHeader/>
        <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,8,0,0" Text="{l:T Work_Participation_NoSubject}"
                   Visibility="{Binding HasSubjects, Converter={StaticResource Work.InverseBoolToVisibility}}"/>
        <StackPanel Visibility="{Binding HasSubjects, Converter={StaticResource Work.BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Participation_Subject}"/>
            <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" DisplayMemberPath="Label" MinWidth="280" HorizontalAlignment="Left"
                      AutomationProperties.Name="{l:T Work_Participation_Subject}"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Roles}" Focusable="False" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type work:ParticipationRowViewModel}">
                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding RoleText}"/>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding WhoText}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding DetailText, TargetNullValue=''}"
                                       Visibility="{Binding HasDetail, Converter={StaticResource Work.BoolToVisibility}}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding SourceText, TargetNullValue=''}"
                                       Visibility="{Binding HasSource, Converter={StaticResource Work.BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
