<UserControl x:Class="AgentStudio.Desktop.Views.Work.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:work="clr-namespace:AgentStudio.Desktop.Work"
             xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Work"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=work:LinksSection}">
    <!-- «Vínculos» (docs/16 D-29 and D-30, F9-3): the links in force around the node, and the suggestions the system infers, which count
         only when the person confirms them. A link is retired with a reason, never deleted. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Work.BoolToVisibility"/>
        <orchestratorViews:FalseToVisibilityConverter x:Key="Work.InverseBoolToVisibility"/>
    </UserControl.Resources>

    <StackPanel>
        <views:SectionHeader/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Text="{Binding NodeText}"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Link_InForce}"/>
        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Work_Link_None}"
                   Visibility="{Binding HasLinks, Converter={StaticResource Work.InverseBoolToVisibility}}"/>
        <ItemsControl ItemsSource="{Binding Links}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type work:TraceLinkRowViewModel}">
                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Line}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding AssertedText}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Reason}"/>
                            <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Content="{l:T Work_Link_Retract}"
                                    Command="{Binding RetractCommand}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Text="{l:T Work_Link_ReasonLabel}"
                   Visibility="{Binding HasLinks, Converter={StaticResource Work.BoolToVisibility}}"/>
        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding RetractReason, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{l:T Work_Link_ReasonLabel}" Visibility="{Binding HasLinks, Converter={StaticResource Work.BoolToVisibility}}"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Work_Link_Suggested}"/>
        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Work_Link_NoSuggestions}"
                   Visibility="{Binding HasSuggestions, Converter={StaticResource Work.InverseBoolToVisibility}}"/>
        <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type work:TraceSuggestionRowViewModel}">
                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Line}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding SourceText}"/>
                            <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Content="{l:T Work_Link_Confirm}"
                                    Command="{Binding ConfirmCommand}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
