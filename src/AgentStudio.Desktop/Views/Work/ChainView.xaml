<UserControl x:Class="AgentStudio.Desktop.Views.Work.ChainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:work="clr-namespace:AgentStudio.Desktop.Work"
             xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Work"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=work:ChainSection}">
    <!-- «Cadena» (docs/16 F9-4): requirement, milestone, task, attempt, change, verification, verdict and delivery, from the verified
         log. A node opens what the app already has (a saved proof, a verdict); one that has no way to be opened says so. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Work.BoolToVisibility"/>
        <orchestratorViews:FalseToVisibilityConverter x:Key="Work.InverseBoolToVisibility"/>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Text="{Binding Title}"/>
            <info:InfoButton InfoKey="Info_Work_Chain" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <views:SectionNotices/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Text="{Binding StartText}"/>
        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Work_Chain_Empty}"
                   Visibility="{Binding HasSteps, Converter={StaticResource Work.InverseBoolToVisibility}}"/>

        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type work:ChainStepViewModel}">
                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StageText}"/>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Title}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding NodeText}"/>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}" Text="{Binding SuggestedText, TargetNullValue=''}"
                                       Visibility="{Binding IsSuggested, Converter={StaticResource Work.BoolToVisibility}}"/>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Text="{Binding StandingText, TargetNullValue=''}"
                                       Visibility="{Binding HasStanding, Converter={StaticResource Work.BoolToVisibility}}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Work_Chain_NoLink}"
                                       Visibility="{Binding HasNoLink, Converter={StaticResource Work.BoolToVisibility}}"/>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,0" Content="{l:T Work_Chain_Open}" Command="{Binding OpenCommand}"
                                        Visibility="{Binding CanOpen, Converter={StaticResource Work.BoolToVisibility}}"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="{l:T Work_Chain_Center}" Command="{Binding CenterCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource InnerCard}" Padding="8" Margin="0,6,0,0" Visibility="{Binding HasOpenedProof, Converter={StaticResource Work.BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding OpenedProof.Title}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding OpenedProof.Description}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding OpenedProof.HashText}"/>
                <TextBox Style="{StaticResource MonoViewer}" TextWrapping="Wrap" MaxHeight="360" HorizontalScrollBarVisibility="Disabled"
                         Text="{Binding OpenedProof.Text, Mode=OneWay, TargetNullValue=''}" AutomationProperties.Name="{l:T Work_Chain_ProofText}"/>
                <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{l:T Work_Close_Viewer}" Command="{Binding CloseProofCommand}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource InnerCard}" Padding="8" Margin="0,6,0,0" Visibility="{Binding HasOpenedVerdict, Converter={StaticResource Work.BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding OpenedVerdict.Title}"/>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding OpenedVerdict.Decision}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding OpenedVerdict.Judge}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding OpenedVerdict.Validity}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{Binding OpenedVerdict.Summary}"/>
                <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{l:T Work_Close_Viewer}" Command="{Binding CloseVerdictCommand}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
