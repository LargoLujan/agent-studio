<Window x:Class="AgentStudio.Desktop.Views.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgentStudio.Desktop.Views"
        xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
        Title="{l:T UnsavedView_WindowTitle}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        Background="{StaticResource SurfaceBrush}" UseLayoutRounding="True"
        AutomationProperties.Name="{l:T UnsavedView_Name}">
    <!-- Modal window of WpfUnsavedChangesPrompt. Its DataContext is the question; the buttons close it through the view model. -->
    <views:UnsavedChangesView/>
</Window>
