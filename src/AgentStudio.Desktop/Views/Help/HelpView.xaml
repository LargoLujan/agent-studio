<UserControl x:Class="AgentStudio.Desktop.Views.Help.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:help="clr-namespace:AgentStudio.Desktop.Help"
             xmlns:markdown="clr-namespace:AgentStudio.Desktop.Markdown"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=help:HelpDocumentViewModel}"
             AutomationProperties.Name="{l:T Help_Title}">
    <!-- «Ayuda» (docs/17 D-55 to D-57, ADR-0056): the topics and a local search, free, then the article; below, «Preguntar a un agente»,
         with the card of what is sent and the OK of the person. What the agent answers is framed as text of an agent. -->
    <UserControl.Resources>
        <markdown:MarkdownToFlowDocumentConverter x:Key="Help.Markdown"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  SecondaryForeground="{StaticResource TextSecondaryBrush}"
                                                  CodeBackground="{StaticResource SurfaceRaisedBrush}"
                                                  FontFamily="{StaticResource UiFont}"
                                                  CodeFontFamily="{StaticResource MonoFont}"/>
        <BooleanToVisibilityConverter x:Key="Help.BoolToVisibility"/>
        <DataTemplate x:Key="Help.ArticleItem" DataType="{x:Type help:HelpArticleItemViewModel}">
            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Command="{Binding OpenCommand}"
                    AutomationProperties.Name="{Binding Title}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Excerpt}"
                               Visibility="{Binding HasExcerpt, Converter={StaticResource Help.BoolToVisibility}}"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <Style x:Key="Help.OptionalNotice" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The search and the topics. -->
        <DockPanel Grid.Column="0" Margin="16,12,8,12">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitleText}" Text="{l:T Help_Search_Heading}"/>
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,6,0,6" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{l:T Help_Search_Name}" ToolTip="{l:T Help_Search_Name}" MaxLength="200"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Style="{StaticResource Help.OptionalNotice}" Text="{Binding SearchNotice}" Margin="0,0,0,6"/>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Help_Results_Heading}"/>
                        <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource Help.ArticleItem}" Focusable="False"
                                      AutomationProperties.Name="{l:T Help_Results_Heading}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Help_Topics_Heading}" Margin="0,10,0,0"/>
                    <ItemsControl ItemsSource="{Binding Topics}" ItemTemplate="{StaticResource Help.ArticleItem}" Focusable="False"
                                  AutomationProperties.Name="{l:T Help_Topics_Heading}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- The article, and the agent. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="8,12,16,16">
                <TextBlock Style="{StaticResource TitleText}" Text="{Binding ArticleTitle}" TextWrapping="Wrap"
                           Visibility="{Binding HasArticle, Converter={StaticResource Help.BoolToVisibility}}"/>
                <TextBlock Style="{StaticResource Help.OptionalNotice}" Text="{Binding ArticleNotice}"/>
                <FlowDocumentScrollViewer Document="{Binding ArticleMarkdown, Converter={StaticResource Help.Markdown}}"
                                          VerticalScrollBarVisibility="Disabled" IsToolBarVisible="False" MinHeight="120"
                                          Visibility="{Binding HasArticle, Converter={StaticResource Help.BoolToVisibility}}"
                                          AutomationProperties.Name="{Binding ArticleTitle}"/>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Help_Ask_Heading}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{l:T Help_Ask_Intro}" Margin="0,4,0,8"/>
                        <TextBlock Style="{StaticResource Help.OptionalNotice}" Text="{Binding AgentUnavailableText}" Margin="0,0,0,8"/>
                        <StackPanel IsEnabled="{Binding AgentAvailable}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Help_Ask_Question}"/>
                            <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinLines="2" MaxLines="6" MaxLength="1000" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{l:T Help_Ask_Question}"/>
                            <TextBlock Style="{StaticResource ErrorText}" TextWrapping="Wrap" Text="{Binding QuestionNotice}" AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Visibility>
                                    <Binding Path="QuestionNotice">
                                        <Binding.Converter>
                                            <help:NotEmptyToVisibilityConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Visibility>
                            </TextBlock>
                            <CheckBox Margin="0,8,0,0" IsChecked="{Binding IncludeProjectData}" Content="{l:T Help_Ask_IncludeProject}"
                                      ToolTip="{l:T Help_Ask_IncludeProject_Hint}"/>
                            <CheckBox Margin="0,4,0,0" IsChecked="{Binding UseCodex}" Content="{l:T Help_Ask_UseCodex}"/>
                            <TextBlock Style="{StaticResource Help.OptionalNotice}" Text="{Binding CodexWarning}"/>
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Content="{l:T Help_Ask_Button}" Command="{Binding AskCommand}"/>
                        </StackPanel>

                        <!-- The card and the OK: nothing is sent until the person says yes. -->
                        <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0" Padding="10"
                                Visibility="{Binding Consent.IsOpen, Converter={StaticResource Help.BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Help_Card_Heading}"/>
                                <ItemsControl ItemsSource="{Binding CardLines}" Focusable="False" AutomationProperties.Name="{l:T Help_Card_Heading}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding}" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Consent.EstimateText}"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{l:T Help_Send}" Command="{Binding ConfirmCommand}"/>
                                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{l:T Help_Cancel}" Command="{Binding CancelCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Help.OptionalNotice}" Text="{Binding Status}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>

                        <!-- The answer: text of an agent, framed as such; the buttons are actions of the closed list. -->
                        <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0" Padding="10"
                                Visibility="{Binding HasReply, Converter={StaticResource Help.BoolToVisibility}}"
                                AutomationProperties.Name="{l:T Help_Reply_Heading}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Help_Reply_Heading}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{l:T Help_Reply_Notice}"/>
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding ReplyText}" Margin="0,8,0,0"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Help_Reply_Articles}" Margin="0,8,0,0"/>
                                <ItemsControl ItemsSource="{Binding ReplyArticles}" ItemTemplate="{StaticResource Help.ArticleItem}" Focusable="False"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Help_Reply_Actions}" Margin="0,8,0,0"/>
                                <ItemsControl ItemsSource="{Binding ReplyActions}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type help:HelpActionItemViewModel}">
                                            <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,4" Content="{Binding Label}" Command="{Binding RunCommand}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander Header="{l:T Help_Reply_Discarded}" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding ReplyDiscarded}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
