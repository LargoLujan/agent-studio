<UserControl x:Class="AgentStudio.Desktop.Views.Settings.LanguageSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=l:LanguageSettingsViewModel}"
             AutomationProperties.Name="{l:T Info_Language_Title}">
    <!-- «Idioma», a section of «Ajustes» (docs/17 D-49): the language of the interface, each one in its own language, or the one
         of Windows. It applies on restart, and the notice says so while the choice would change the language in use. «Guardar»
         is the document's, for every section at once. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Language.BoolToVisibility"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Info_Language_Title}"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{l:T Info_Language_What}"/>
        <ComboBox Margin="0,14,0,0" Width="320" HorizontalAlignment="Left" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}"
                  AutomationProperties.Name="{l:T Info_Language_Title}"/>
        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding RestartNotice}"
                   Visibility="{Binding HasRestartNotice, Converter={StaticResource Language.BoolToVisibility}}"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
