<UserControl x:Class="AgentStudio.Desktop.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:AgentStudio.Desktop.Settings"
             xmlns:observabilityViews="clr-namespace:AgentStudio.Desktop.Views.Observability"
             xmlns:backgroundViews="clr-namespace:AgentStudio.Desktop.Views.Background"
             xmlns:lockViews="clr-namespace:AgentStudio.Desktop.Views.Lock"
             xmlns:memoryViews="clr-namespace:AgentStudio.Desktop.Views.Memory"
             xmlns:local="clr-namespace:AgentStudio.Desktop.Views.Settings"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=settings:SettingsDocumentViewModel}"
             AutomationProperties.Name="Ajustes">
    <!-- «Ajustes» (docs/03 §5.2 and §2.1): one card per section, in one column that scrolls, and one «Guardar» for all of
         them in the bar below, which says what came of it. A section that was not composed is not shown. Bindings only. -->
    <UserControl.Resources>
        <orchestratorViews:NullToVisibilityConverter x:Key="Settings.NotNullToVisibility"/>

        <Style x:Key="Settings.Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="20,16,20,18"/>
        </Style>

        <!-- The column of the sections and of the bar of «Guardar»: one width, so the button ends where the sections do. -->
        <Style x:Key="Settings.Column" TargetType="FrameworkElement">
            <Setter Property="MaxWidth" Value="780"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14,24,12">
            <StackPanel Style="{StaticResource Settings.Column}">
                <TextBlock Style="{StaticResource TitleText}" FontSize="20" Text="Ajustes"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" Text="{x:Static settings:SettingsDocumentViewModel.ScopeText}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Style="{StaticResource Settings.Column}" Margin="24,18,24,4">
                <Border Style="{StaticResource Settings.Section}">
                    <observabilityViews:ObservabilitySettingsView DataContext="{Binding Context}"/>
                </Border>
                <Border Style="{StaticResource Settings.Section}" Visibility="{Binding Unattended, Converter={StaticResource Settings.NotNullToVisibility}}">
                    <backgroundViews:UnattendedSettingsView DataContext="{Binding Unattended}"/>
                </Border>
                <Border Style="{StaticResource Settings.Section}" Visibility="{Binding Lock, Converter={StaticResource Settings.NotNullToVisibility}}">
                    <lockViews:LockSettingsView DataContext="{Binding Lock}"/>
                </Border>
                <Border Style="{StaticResource Settings.Section}" Visibility="{Binding Memory, Converter={StaticResource Settings.NotNullToVisibility}}">
                    <memoryViews:MemorySettingsView DataContext="{Binding Memory}"/>
                </Border>
                <Border Style="{StaticResource Settings.Section}" Visibility="{Binding Language, Converter={StaticResource Settings.NotNullToVisibility}}">
                    <local:LanguageSettingsView DataContext="{Binding Language}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- The one «Guardar»: every section is checked first, and nothing is saved while one is wrong. -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel Style="{StaticResource Settings.Column}">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0" Content="Guardar"
                        Command="{Binding SaveCommand}" AutomationProperties.Name="Guardar los ajustes"
                        AutomationProperties.HelpText="{x:Static settings:SettingsDocumentViewModel.SaveExplanation}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive"/>
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource SuccessBrush}" Text="{Binding Notice}"
                               Visibility="{Binding Notice, Converter={StaticResource Settings.NotNullToVisibility}}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" Text="{x:Static settings:SettingsDocumentViewModel.SaveExplanation}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
