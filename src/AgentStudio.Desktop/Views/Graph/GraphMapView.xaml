<UserControl x:Class="AgentStudio.Desktop.Views.Graph.GraphMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:graph="clr-namespace:AgentStudio.Desktop.Graph"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=graph:GraphMapSection}">
    <!-- «Grafo» (docs/20 D-22, F6-3 to F6-5): the solution as a read-only canvas of Nodify (ADR-0015), a list that says the same for the keyboard and
         the screen reader, the legend, how much was read, and the actions on the node chosen. A relation an AI proposed is dashed, in another colour and
         labelled «IA»; its name for the screen reader says who proposed it. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Graph.BoolToVisibility"/>
        <orchestratorViews:FalseToVisibilityConverter x:Key="Graph.InverseBoolToVisibility"/>

        <GeometryDrawing x:Key="SmallGridGeometry" Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z"
                         Brush="{StaticResource NodifyEditor.SelectionRectangleBackgroundBrush}"/>
        <DrawingBrush x:Key="Graph.GridBrush" TileMode="Tile" ViewportUnits="Absolute" Viewport="0 0 20 20"
                      Transform="{Binding ViewportTransform, ElementName=Editor}"
                      Drawing="{StaticResource SmallGridGeometry}"/>

        <!-- The wires: a read one is plain; a proposed one is dashed, violet and labelled «IA» (the name of the wire says who proposed it too). -->
        <Style x:Key="Graph.Wire" TargetType="{x:Type nodify:Connection}" BasedOn="{StaticResource {x:Type nodify:Connection}}">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Text" Value="{Binding Label}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextBackground" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInferred}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource Status.AwaitingApprovalBrush}"/>
                    <Setter Property="Fill" Value="{StaticResource Status.AwaitingApprovalBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                    <Setter Property="StrokeDashArray" Value="4 3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Graph.WireTemplate" DataType="{x:Type graph:GraphWireItem}">
            <nodify:Connection Style="{StaticResource Graph.Wire}" Source="{Binding Source.Anchor}" Target="{Binding Target.Anchor}"/>
        </DataTemplate>

        <!-- A node: its kind, its name and, when it is partial, the word and a sign (not only the colour). -->
        <DataTemplate x:Key="Graph.NodeContent" DataType="{x:Type graph:GraphNodeItem}">
            <StackPanel MaxWidth="230">
                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsPartial, Converter={StaticResource Graph.BoolToVisibility}}">
                    <TextBlock Text="&#x25D0; " Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PartialText}" Style="{StaticResource SecondaryText}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="Graph.NodeShell" TargetType="{x:Type nodify:Node}" BasedOn="{StaticResource {x:Type nodify:Node}}">
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="ContentPadding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Header" Value="{Binding KindText}"/>
            <Setter Property="Content" Value="{Binding}"/>
            <Setter Property="ContentTemplate" Value="{StaticResource Graph.NodeContent}"/>
            <Setter Property="Input" Value="{Binding Input}"/>
            <Setter Property="Output" Value="{Binding Output}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type graph:GraphNodeItem}">
            <nodify:Node Style="{StaticResource Graph.NodeShell}"/>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Text="{Binding Title}"/>
                <info:InfoButton InfoKey="Info_Graph_Map" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,4,0,0" Text="{l:T Graph_Unavailable}"
                       Visibility="{Binding IsAvailable, Converter={StaticResource Graph.InverseBoolToVisibility}}"/>
            <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,4,0,0" Text="{Binding Status, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,4,0,0" Text="{Binding Message, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Style="{StaticResource ErrorText}" Margin="0,4,0,0" Text="{Binding Error, TargetNullValue=''}" AutomationProperties.LiveSetting="Assertive"/>
            <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,4,0,0" Text="{l:T Graph_Empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Graph.BoolToVisibility}}"/>

            <!-- The version it describes and what the section does. -->
            <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Content="{l:T Graph_Refresh}" ToolTip="{l:T Graph_Refresh_Hint}" Command="{Binding RefreshCommand}"/>
                <Button Style="{StaticResource ToolbarButton}" Content="{l:T Graph_Propose}" ToolTip="{l:T Graph_Propose_Hint}" Command="{Binding ProposeCommand}"
                        Visibility="{Binding HasProposer, Converter={StaticResource Graph.BoolToVisibility}}"/>
                <info:InfoButton InfoKey="Info_Graph_Propose" Margin="2,0,10,0" VerticalAlignment="Center"
                                 Visibility="{Binding HasProposer, Converter={StaticResource Graph.BoolToVisibility}}"/>
                <CheckBox Margin="6,0,12,0" VerticalAlignment="Center" IsChecked="{Binding ShowPackages}" Content="{l:T Graph_Show_Packages}"/>
                <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" IsChecked="{Binding ShowInferred}" Content="{l:T Graph_Show_Inferred}"
                          Visibility="{Binding HasInferred, Converter={StaticResource Graph.BoolToVisibility}}"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding VersionText}"/>

            <!-- «Proponer relaciones»: what would be sent and the estimate, and nothing starts until the person says yes. -->
            <Border Style="{StaticResource InnerCard}" Margin="0,8,0,0" Padding="10" Visibility="{Binding Consent.IsOpen, Converter={StaticResource Graph.BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Graph_Card_Heading}"/>
                    <ItemsControl ItemsSource="{Binding CardLines}" Focusable="False" AutomationProperties.Name="{l:T Graph_Card_Heading}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Consent.EstimateText}" AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{l:T Graph_Card_Send}" Command="{Binding ConfirmProposalCommand}" IsEnabled="{Binding Consent.IsReady}"/>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{l:T Graph_Card_Cancel}" Command="{Binding CancelProposalCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The canvas: read only. Nodify draws; the section owns the nodes and the wires. -->
            <Border Margin="0,10,0,0" Height="420" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{Binding HasGraph, Converter={StaticResource Graph.BoolToVisibility}}">
                <nodify:NodifyEditor x:Name="Editor"
                                     ItemsSource="{Binding Nodes}"
                                     Connections="{Binding Wires}"
                                     SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                     ConnectionTemplate="{StaticResource Graph.WireTemplate}"
                                     GridCellSize="10"
                                     Background="{StaticResource Graph.GridBrush}"
                                     Focusable="True" IsTabStop="True"
                                     AutomationProperties.Name="{l:T Graph_Canvas_Name}">
                    <nodify:NodifyEditor.ItemContainerStyle>
                        <Style TargetType="{x:Type nodify:ItemContainer}" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                            <Setter Property="Location" Value="{Binding Location, Mode=OneWay}"/>
                            <Setter Property="ActualSize" Value="{Binding Size, Mode=OneWayToSource}"/>
                            <Setter Property="IsDraggable" Value="False"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                        </Style>
                    </nodify:NodifyEditor.ItemContainerStyle>
                </nodify:NodifyEditor>
            </Border>

            <!-- The legend: what each look means. The one of the AI is there only when there is a relation that an AI proposed. -->
            <ItemsControl ItemsSource="{Binding Legend}" Margin="0,6,0,0" Focusable="False" AutomationProperties.Name="{l:T Graph_Legend_Name}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type graph:GraphLegendItem}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="&#x25D0; " Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Visibility="{Binding IsPartial, Converter={StaticResource Graph.BoolToVisibility}}"/>
                            <Line X1="0" X2="26" Y1="5" Y2="5" StrokeThickness="2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Line.Style>
                                    <Style TargetType="Line">
                                        <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDashed}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource Status.AwaitingApprovalBrush}"/>
                                                <Setter Property="StrokeDashArray" Value="4 3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Line.Style>
                            </Line>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- What the person can do with the node chosen: go to its file and to its work (F6-5). -->
            <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0" Padding="10">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding SelectedTitle}" AutomationProperties.LiveSetting="Polite"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Style="{StaticResource ToolbarButton}" Content="{l:T Graph_Expand}" Command="{Binding ToggleExpandCommand}"
                                Visibility="{Binding CanExpandSelected, Converter={StaticResource Graph.BoolToVisibility}}"/>
                        <Button Style="{StaticResource ToolbarButton}" Content="{l:T Graph_OpenProjectFile}" Command="{Binding OpenProjectFileCommand}"
                                Visibility="{Binding SelectedIsProject, Converter={StaticResource Graph.BoolToVisibility}}"/>
                    </WrapPanel>

                    <StackPanel Visibility="{Binding SelectedIsNamespace, Converter={StaticResource Graph.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Graph_Files_Heading}"/>
                        <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type graph:GraphFileRow}">
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{l:T Graph_Files_Open}"
                                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                CommandParameter="{Binding Path}" AutomationProperties.Name="{Binding Path}"/>
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedIsProject, Converter={StaticResource Graph.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Graph_Tasks_Heading}"/>
                        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Graph_Tasks_None}"
                                   Visibility="{Binding HasNoTasks, Converter={StaticResource Graph.BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding TaskRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type graph:GraphTaskRow}">
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{l:T Graph_Task_Button}"
                                                Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding AutomationName}"/>
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- How much was read, and what could not be (nothing partial is presented as complete). -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasGraph, Converter={StaticResource Graph.BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Graph_Gaps_Heading}" VerticalAlignment="Center"/>
                    <info:InfoButton InfoKey="Info_Graph_Coverage" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding CoverageText}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Graph_Gaps_None}"
                           Visibility="{Binding HasNoGaps, Converter={StaticResource Graph.BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Gaps}" Focusable="False" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type graph:GraphGapRow}">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding NodeName}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Text}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Where}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- The same graph as words, for the keyboard and the screen reader. -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasGraph, Converter={StaticResource Graph.BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T Graph_List_Heading}"/>
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" MaxHeight="220" AutomationProperties.Name="{l:T Graph_List_Name}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type graph:GraphRowItem}">
                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding Text}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
