<UserControl x:Class="AgentStudio.Desktop.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:vm="clr-namespace:AgentStudio.Desktop.ViewModels"
             xmlns:views="clr-namespace:AgentStudio.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ExplorerViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <views:TreeIndentConverter x:Key="Explorer.Indent" Step="16"/>

        <!-- The arrow of a folder: a glyph in the row, not a tab stop (Left and Right open and close folders). -->
        <Style x:Key="Explorer.Arrow" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Glyph" Data="M 6,4 L 10,8 L 6,12" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Data" Value="M 4,6 L 8,10 L 12,6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource SurfaceBrush}">
        <TextBlock Style="{StaticResource SecondaryText}" Margin="12" VerticalAlignment="Top"
                   Text="{l:T Explorer_NoFolder}"
                   Visibility="{Binding HasNoProject, Converter={StaticResource BoolToVisibility}}"/>

        <DockPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
            <Button DockPanel.Dock="Top" Style="{StaticResource GhostButton}" Margin="8" HorizontalAlignment="Left"
                    Content="{l:T Explorer_Refresh}" Command="{Binding RefreshCommand}"/>
            <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
                      VirtualizingPanel.IsVirtualizing="True" KeyDown="OnTreeKeyDown">
                <TreeView.ItemContainerStyle>
                    <!-- One row per node across the whole width of the tree: the click, the selection and the double click
                         take the full row, and the indent of the folders above it is drawn inside the row. Selected: Accent
                         while the tree has the focus, BorderStrong while it has not, under OnAccent (the selection of the
                         theme); the selected row is also where the keyboard is, so no ring is drawn around it. The lines
                         that only say something (an empty or unreadable folder) take no focus nor selection. -->
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <Border x:Name="Row" Background="Transparent" MinHeight="22" SnapsToDevicePixels="True">
                                            <DockPanel Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Explorer.Indent}}">
                                                <ToggleButton x:Name="Arrow" DockPanel.Dock="Left" Margin="4,0,2,0" VerticalAlignment="Center"
                                                              Style="{StaticResource Explorer.Arrow}" Foreground="{StaticResource TextSecondaryBrush}"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ItemsPresenter x:Name="ItemsHost"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Arrow" Property="Visibility" Value="Hidden"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition SourceName="Row" Property="IsMouseOver" Value="True"/>
                                                <Condition Property="Focusable" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                        </MultiTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource BorderStrongBrush}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMessage}" Value="True">
                                <Setter Property="Focusable" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNodeViewModel}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" Padding="2,2" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMessage}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>
    </Grid>
</UserControl>
