<Window x:Class="AgentStudio.Desktop.Views.Setup.SetupTrialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
        xmlns:setup="clr-namespace:AgentStudio.Desktop.Setup"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=setup:SetupTrialConfirmationViewModel}"
        Title="{l:T Setup_Trial_Window_Title}"
        SizeToContent="Height" Width="560" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}"
        AutomationProperties.Name="{l:T Setup_Trial_Window_Title}">
    <!-- The question of WpfSetupTrialConfirmation before «Probarla ahora» runs commands the person has not accepted yet: the exact
         commands, what they can reach, and «Ejecutar» or «Cancelar». «Cancelar» has the focus and is the default: Enter and Esc are a
         no. Bindings only; every text comes from SetupStrings. -->
    <Border Background="{StaticResource SurfaceBrush}" Padding="20,18">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" Text="{l:T Setup_Trial_Heading}"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:T Setup_Trial_What}"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:T Setup_Trial_Not_Accepted}"/>

            <Border Style="{StaticResource InnerCard}" Padding="12,8" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding Commands}" Focusable="False" AutomationProperties.Name="{l:T Setup_Trial_Commands_Name}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource BodyText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,2,0,0"
                                       TextWrapping="Wrap" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{l:T Setup_Trial_Run}" Command="{Binding RunCommand}"/>
                <Button x:Name="CancelButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{l:T Setup_Trial_Cancel}"
                        IsCancel="True" IsDefault="True" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
