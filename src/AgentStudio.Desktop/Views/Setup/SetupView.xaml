<UserControl x:Class="AgentStudio.Desktop.Views.Setup.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:setup="clr-namespace:AgentStudio.Desktop.Setup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=setup:SetupViewModel}"
             Background="{StaticResource BackgroundBrush}">
    <!-- The configurator of a project (docs/17 section 4.6, D-26 and D-27; ADR-0055): the list of steps on the left, the step on
         screen on the right and «Atrás», «Siguiente» and «Aplicar» at the bottom. Bindings only; every text comes from the
         resources (SetupStrings). It uses the tokens of Dark.xaml alone, so it renders with the base theme. A step that was
         skipped says so; nothing is written until «Aplicar», and the summary shows what changes with what is there now. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Setup.BoolToVisibility"/>

        <!-- Each step's panel shows only while its step is the one on screen. -->
        <Style x:Key="Setup.StepPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="Setup.ProjectPanel" TargetType="StackPanel" BasedOn="{StaticResource Setup.StepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="Project"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Setup.BriefPanel" TargetType="StackPanel" BasedOn="{StaticResource Setup.StepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="Brief"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Setup.TeamPanel" TargetType="StackPanel" BasedOn="{StaticResource Setup.StepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="Team"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Setup.ModelsPanel" TargetType="StackPanel" BasedOn="{StaticResource Setup.StepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="Models"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Setup.VerificationPanel" TargetType="StackPanel" BasedOn="{StaticResource Setup.StepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="Verification"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Setup.SkillsPanel" TargetType="StackPanel" BasedOn="{StaticResource Setup.StepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="Skills"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Setup.BudgetPanel" TargetType="StackPanel" BasedOn="{StaticResource Setup.StepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="Budget"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Setup.SummaryPanel" TargetType="StackPanel" BasedOn="{StaticResource Setup.StepPanel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="Summary"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Setup.Line" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="Setup.Hint" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Setup.OptionalText" TargetType="TextBlock" BasedOn="{StaticResource Setup.Line}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Setup.OptionalError" TargetType="TextBlock" BasedOn="{StaticResource ErrorText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Setup.CheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Setup.TextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- A step of the list: the current one is marked, a skipped one is dimmed. -->
        <Style x:Key="Setup.StepButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Setup.LineTemplate">
            <TextBlock Style="{StaticResource Setup.Line}" Text="{Binding}"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <info:InfoButton DockPanel.Dock="Right" InfoKey="Setup_Info"/>
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T Setup_Heading}" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0" Margin="0,0,16,0" ItemsSource="{Binding Steps}" Focusable="False"
                          AutomationProperties.Name="{l:T Setup_Steps_Label}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Setup.StepButton}" Content="{Binding Title}" AutomationProperties.Name="{Binding Title}"
                                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{Binding CurrentTitle}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Setup.OptionalError}" Text="{Binding ErrorMessage}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Setup.OptionalText}" Text="{Binding BusyText}"/>

                    <!-- 1 · Proyecto -->
                    <StackPanel Style="{StaticResource Setup.ProjectPanel}">
                        <ItemsControl ItemsSource="{Binding ProjectLines}" ItemTemplate="{StaticResource Setup.LineTemplate}" Focusable="False"/>
                    </StackPanel>

                    <!-- 2 · Ficha -->
                    <StackPanel Style="{StaticResource Setup.BriefPanel}">
                        <CheckBox Style="{StaticResource Setup.CheckBox}" Content="{l:T Setup_Include_Step}" IsChecked="{Binding Steps[1].IsIncluded}"/>
                        <TextBlock Style="{StaticResource Setup.Hint}" Text="{l:T Setup_Brief_Hint}"/>
                        <TextBox Style="{StaticResource Setup.TextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding BriefText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Steps[1].Title}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding BriefCharacters}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 3 · Equipo -->
                    <StackPanel Style="{StaticResource Setup.TeamPanel}">
                        <CheckBox Style="{StaticResource Setup.CheckBox}" Content="{l:T Setup_Include_Step}" IsChecked="{Binding Steps[2].IsIncluded}"/>
                        <TextBlock Style="{StaticResource Setup.Hint}" Text="{l:T Setup_Team_Hint}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Setup_Team_Size_Label}"/>
                        <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" HorizontalAlignment="Left" MinWidth="160" Margin="0,4,0,8"
                                  AutomationProperties.Name="{l:T Setup_Team_Size_Label}"/>
                        <ItemsControl ItemsSource="{Binding TeamRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Line}"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Kind}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Setup.Hint}" Text="{l:T Setup_Team_Never_Removes}"/>
                    </StackPanel>

                    <!-- 4 · Modelos -->
                    <StackPanel Style="{StaticResource Setup.ModelsPanel}">
                        <CheckBox Style="{StaticResource Setup.CheckBox}" Content="{l:T Setup_Include_Step}" IsChecked="{Binding Steps[3].IsIncluded}"/>
                        <TextBlock Style="{StaticResource Setup.Hint}" Text="{l:T Setup_Models_Hint}"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Content="{l:T Setup_Button_Use_All}"
                                Command="{Binding UseAllRecommendedCommand}" Visibility="{Binding HasRecommendations, Converter={StaticResource Setup.BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding ModelRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Current}"/>
                                        <TextBlock Style="{StaticResource Setup.OptionalText}" Text="{Binding Recommended}"/>
                                        <TextBlock Style="{StaticResource Setup.OptionalText}" Text="{Binding Why}"/>
                                        <TextBlock Style="{StaticResource Setup.OptionalText}" Text="{Binding Follows}"/>
                                        <CheckBox Style="{StaticResource Setup.CheckBox}" Margin="0,4,0,0" Content="{l:T Setup_Models_Accept}" IsChecked="{Binding IsAccepted}"
                                                  Visibility="{Binding CanAccept, Converter={StaticResource Setup.BoolToVisibility}}"
                                                  AutomationProperties.Name="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 5 · Pruebas -->
                    <StackPanel Style="{StaticResource Setup.VerificationPanel}">
                        <CheckBox Style="{StaticResource Setup.CheckBox}" Content="{l:T Setup_Include_Step}" IsChecked="{Binding Steps[4].IsIncluded}"/>
                        <TextBlock Style="{StaticResource Setup.Hint}" Text="{l:T Setup_Verification_Hint}"/>
                        <ItemsControl ItemsSource="{Binding VerificationLines}" ItemTemplate="{StaticResource Setup.LineTemplate}" Focusable="False"/>
                        <TextBlock Style="{StaticResource Setup.OptionalText}" Margin="0,8,0,0" Text="{Binding VerificationStatus}"/>
                    </StackPanel>

                    <!-- 6 · Skills -->
                    <StackPanel Style="{StaticResource Setup.SkillsPanel}">
                        <CheckBox Style="{StaticResource Setup.CheckBox}" Content="{l:T Setup_Include_Step}" IsChecked="{Binding Steps[5].IsIncluded}"/>
                        <TextBlock Style="{StaticResource Setup.Hint}" Text="{l:T Setup_Skills_Hint}"/>
                        <ItemsControl ItemsSource="{Binding SkillRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <CheckBox Style="{StaticResource Setup.CheckBox}" Margin="0" IsChecked="{Binding IsChosen}" IsEnabled="{Binding CanChoose}"
                                                  AutomationProperties.Name="{Binding SkillName}">
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding SkillName}"/>
                                        </CheckBox>
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding AgentName}"/>
                                        <TextBlock Style="{StaticResource Setup.OptionalText}" Text="{Binding Reasons}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 7 · Presupuesto -->
                    <StackPanel Style="{StaticResource Setup.BudgetPanel}">
                        <CheckBox Style="{StaticResource Setup.CheckBox}" Content="{l:T Setup_Include_Step}" IsChecked="{Binding Steps[6].IsIncluded}"/>
                        <TextBlock Style="{StaticResource Setup.Hint}" Text="{l:T Setup_Budget_Hint}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Setup_Budget_Runs}"/>
                        <TextBox Style="{StaticResource Setup.TextBox}" Width="100" HorizontalAlignment="Left" Margin="0,2,0,8"
                                 Text="{Binding MaxAgentRunsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Setup_Budget_Runs}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Setup_Budget_Parallel}"/>
                        <TextBox Style="{StaticResource Setup.TextBox}" Width="100" HorizontalAlignment="Left" Margin="0,2,0,8"
                                 Text="{Binding MaxParallelTasksText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Setup_Budget_Parallel}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Setup_Budget_Time}"/>
                        <TextBox Style="{StaticResource Setup.TextBox}" Width="100" HorizontalAlignment="Left" Margin="0,2,0,2"
                                 Text="{Binding TimeMinutesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Setup_Budget_Time}"/>
                        <TextBlock Style="{StaticResource Setup.Hint}" Text="{l:T Setup_Budget_Time_Hint}"/>
                        <TextBlock Style="{StaticResource Setup.OptionalError}" Text="{Binding BudgetProblem}"/>
                        <TextBlock Style="{StaticResource Setup.Hint}" Margin="0,8,0,0" Text="{l:T Setup_Budget_Unattended_Note}"/>
                    </StackPanel>

                    <!-- Resumen -->
                    <StackPanel Style="{StaticResource Setup.SummaryPanel}">
                        <TextBlock Style="{StaticResource Setup.Hint}" Text="{l:T Setup_Summary_Hint}"/>
                        <TextBlock Style="{StaticResource Setup.Hint}" Text="{l:T Setup_Summary_Empty}"
                                   Visibility="{Binding IsSummaryEmpty, Converter={StaticResource Setup.BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding SummaryLines}" ItemTemplate="{StaticResource Setup.LineTemplate}" Focusable="False"/>
                        <TextBlock Style="{StaticResource Setup.Hint}" Margin="0,8,0,0" Text="{l:T Setup_Summary_Hello}"
                                   Visibility="{Binding WillAskHello, Converter={StaticResource Setup.BoolToVisibility}}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,16,0,4" Text="{l:T Setup_Results_Heading}"
                               Visibility="{Binding HasResults, Converter={StaticResource Setup.BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding ResultLines}" ItemTemplate="{StaticResource Setup.LineTemplate}" Focusable="False"/>
                    <TextBlock Style="{StaticResource Setup.OptionalText}" Margin="0,8,0,0" Text="{Binding Notice}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{l:T Setup_Button_Back}" Command="{Binding BackCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource GhostButton}" Content="{l:T Setup_Button_Next}" Command="{Binding NextCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{l:T Setup_Button_Apply}" Command="{Binding ApplyCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
