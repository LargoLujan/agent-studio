<UserControl x:Class="AgentStudio.Desktop.Views.Observability.QuotaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:observability="clr-namespace:AgentStudio.Desktop.Observability"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             xmlns:controls="clr-namespace:AgentStudio.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=observability:QuotaViewModel}">
    <!-- The subscription quota of each provider (docs/14 D-14 to D-16): Claude from what its runs announce, with how old
         each window is; Codex only with the opt-in of the settings; Gemini «no expuesto». Bindings only. -->
    <UserControl.Resources>
        <orchestratorViews:NullToVisibilityConverter x:Key="Quota.NotNullToVisibility"/>

        <DataTemplate DataType="{x:Type observability:ProviderQuota}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Status}"/>
                <ItemsControl ItemsSource="{Binding Windows}" Focusable="False" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type observability:QuotaWindowRow}">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4"
                                    AutomationProperties.Name="{Binding Utilization.Text}">
                                <StackPanel>
                                    <!-- The window, and its utilization as a bar (docs/18 P3): the provider's own figure with its
                                         origin; a limit reached is critical. Then how old it is and when it resets. -->
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}"/>
                                    <controls:MetricBar Margin="0,3,0,2" ShowsLabel="False" TrackWidth="160" Reading="{Binding Bar}"
                                                        Visibility="{Binding Bar, Converter={StaticResource Quota.NotNullToVisibility}}"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Seen}"/>
                                    <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding Resets, TargetNullValue=''}"/>
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}" Text="{Binding Reached}"
                                               Visibility="{Binding Reached, Converter={StaticResource Quota.NotNullToVisibility}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Text="{l:T Observability_Quota_Title}"/>
            <info:InfoButton InfoKey="Info_Quota" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,8" Text="{l:T Observability_Quota_Intro}"/>
        <Border Style="{StaticResource InnerCard}" Padding="10,8">
            <ContentPresenter Content="{Binding Claude}" AutomationProperties.Name="{l:T Observability_Quota_ClaudeName}"/>
        </Border>
        <Border Style="{StaticResource InnerCard}" Padding="10,8">
            <StackPanel>
                <ContentPresenter Content="{Binding Codex}" AutomationProperties.Name="{l:T Observability_Quota_CodexName}"/>
                <Button Style="{StaticResource ToolbarButton}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="{l:T Observability_Quota_ReadCodex}"
                        Command="{Binding ReadCodexCommand}"
                        ToolTip="{l:T Observability_Quota_ReadCodexTip}"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource InnerCard}" Padding="10,8" Margin="0">
            <ContentPresenter Content="{Binding Gemini}" AutomationProperties.Name="{l:T Observability_Quota_GeminiName}"/>
        </Border>
    </StackPanel>
</UserControl>
