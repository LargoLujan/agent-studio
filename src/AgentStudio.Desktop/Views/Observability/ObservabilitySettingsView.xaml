<UserControl x:Class="AgentStudio.Desktop.Views.Observability.ObservabilitySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:observability="clr-namespace:AgentStudio.Desktop.Observability"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=observability:ObservabilitySettingsViewModel}"
             AutomationProperties.Name="{l:T Observability_Settings_Title}">
    <!-- «Contexto y cuota», a section of «Ajustes» (docs/14 D-11 and D-15): the global context thresholds and the Codex opt-in.
         «Guardar» is the document's, for every section at once; until then the previous ones stay in force. Bindings only. -->
    <UserControl.Resources>
        <Style x:Key="ContextSettings.Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,28,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Text="{l:T Observability_Settings_Title}"/>
            <info:InfoButton InfoKey="Info_ContextSettings" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" Text="{l:T Observability_Settings_Intro}"/>

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="{l:T Observability_Settings_Thresholds}"/>
        <WrapPanel>
            <StackPanel Style="{StaticResource ContextSettings.Field}">
                <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Observability_Settings_Warning}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox Style="{StaticResource FieldTextBox}" Width="64" Text="{Binding WarningText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{l:T Observability_Settings_WarningName}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="6,0,0,0" VerticalAlignment="Center" Text="%"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Style="{StaticResource ContextSettings.Field}">
                <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Observability_Settings_Compress}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox Style="{StaticResource FieldTextBox}" Width="64" Text="{Binding CompressText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{l:T Observability_Settings_CompressName}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="6,0,0,0" VerticalAlignment="Center" Text="%"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Style="{StaticResource ContextSettings.Field}">
                <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Observability_Settings_Critical}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox Style="{StaticResource FieldTextBox}" Width="64" Text="{Binding CriticalText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{l:T Observability_Settings_CriticalName}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="6,0,0,0" VerticalAlignment="Center" Text="%"/>
                </StackPanel>
            </StackPanel>
        </WrapPanel>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Text="{l:T Observability_Settings_Rule}"/>
        <TextBlock Style="{StaticResource ErrorText}" Margin="0,6,0,0" Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive"/>

        <!-- A string as the content of a check box never wraps: a wrapping TextBlock does, and the name is set by hand. -->
        <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,16,0,0" IsChecked="{Binding CodexQuotaReadEnabled}"
                  AutomationProperties.Name="{l:T Observability_Settings_CodexRead}"
                  AutomationProperties.HelpText="{l:T Observability_Settings_CodexExplanation}">
            <TextBlock TextWrapping="Wrap" Text="{l:T Observability_Settings_CodexRead}"/>
        </CheckBox>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="22,2,0,0" Text="{l:T Observability_Settings_CodexExplanation}"/>
    </StackPanel>
</UserControl>
