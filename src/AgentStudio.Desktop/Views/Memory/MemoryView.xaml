<UserControl x:Class="AgentStudio.Desktop.Views.Memory.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:memory="clr-namespace:AgentStudio.Desktop.Memory"
             xmlns:views="clr-namespace:AgentStudio.Desktop.Views.Memory"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=memory:MemoryViewModel}">
    <!-- «Memoria» (docs/14 F4-5, D-18 to D-22): every entry of the project's memory with its category, origin and trust.
         A person accepts or rejects what an agent proposed or what is in quarantine, and withdraws what is trusted; each
         decision goes to the decision log (queued while a run goes on). The Markdown export is never offered during a
         run. Phase 12 (docs/17 D-02 to D-06): «Buscar» goes by meaning and by words when the model is there, and says how it
         went; the texts of the log come with the results. On the right, the search by meaning (the model and its download,
         with the person's OK), the trust of the journal and the daily summary. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Memory.BoolToVisibility"/>
        <orchestratorViews:ToneToBrushConverter x:Key="Memory.ToneToBrush"/>
        <orchestratorViews:NullToVisibilityConverter x:Key="Memory.NotNullToVisibility"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="Exportar a Markdown" Command="{Binding ExportCommand}"
                            ToolTip="Escribe lo de confianza y lo aceptado en .agentstudio/memory/. Nunca durante una ejecución, y el Markdown nunca se lee de vuelta."/>
                    <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Margin="0,0,16,6" Text="Memoria del proyecto"/>
                </DockPanel>

                <!-- The search: a visible label (by meaning and by words, or by words), a hint inside the empty box, and Intro or
                     «Buscar» to apply it. -->
                <WrapPanel>
                    <TextBlock x:Name="SearchLabel" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,6" Text="{Binding SearchLabel}"/>
                    <Grid Width="280" Margin="0,0,16,6" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Style="{StaticResource FieldTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding SearchAutomationName}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}"
                                 AutomationProperties.HelpText="Lo que buscas en el contenido, el tema o la fuente de las entradas, con tus palabras. Intro o «Buscar» aplica la búsqueda.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="contenido, tema o fuente…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="KindLabel" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,6" Text="Categoría"/>
                    <ComboBox MinWidth="160" Margin="0,0,8,6" VerticalAlignment="Center" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Label"
                              AutomationProperties.Name="Categoría" AutomationProperties.LabeledBy="{Binding ElementName=KindLabel}"/>
                    <Button Style="{StaticResource ToolbarPrimaryButton}" VerticalAlignment="Center" Content="Buscar" Command="{Binding SearchCommand}"
                            AutomationProperties.Name="Buscar en la memoria"/>
                </WrapPanel>
                <!-- How the last search went: by meaning and by words, or by words only and why (F12-6). -->
                <TextBlock Style="{StaticResource OptionalSecondaryText}" TextWrapping="Wrap" Text="{Binding SearchNotice, TargetNullValue=''}"
                           AutomationProperties.Name="Cómo se ha buscado" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}" Text="{Binding ExportBlocked}"
                           Visibility="{Binding ExportBlocked, Converter={StaticResource Memory.NotNullToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding ExportStatus, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}" Text="{Binding ExportWarning}"
                           Visibility="{Binding ExportWarning, Converter={StaticResource Memory.NotNullToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding StatusMessage, TargetNullValue=''}"/>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                           Text="Solo lo de confianza llega a los prompts de los agentes con «Memoria del proyecto» activada; el juez nunca recibe memoria."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420"/>
                <ColumnDefinition Width="2*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Results}" Margin="12,10,12,12" Focusable="False" AutomationProperties.Name="Entradas de la memoria">
                    <ItemsControl.Resources>
                        <!-- An entry of the memory: its trust, what can be decided about it, and why a search found it. -->
                        <DataTemplate DataType="{x:Type memory:MemoryEntryViewModel}">
                            <Border Style="{StaticResource InnerCard}" Padding="10,8" AutomationProperties.Name="{Binding TrustLabel}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource ToolbarButton}" Content="Aceptar"
                                                    Visibility="{Binding CanBeAccepted, Converter={StaticResource Memory.BoolToVisibility}}"
                                                    Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Id, StringFormat='Aceptar {0}'}"/>
                                            <Button Style="{StaticResource ToolbarButton}" Content="Rechazar"
                                                    Visibility="{Binding CanBeAccepted, Converter={StaticResource Memory.BoolToVisibility}}"
                                                    Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Id, StringFormat='Rechazar {0}'}"/>
                                            <Button Style="{StaticResource ToolbarButton}" Content="Retirar"
                                                    Visibility="{Binding CanBeRetracted, Converter={StaticResource Memory.BoolToVisibility}}"
                                                    Command="{Binding DataContext.RetractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Id, StringFormat='Retirar {0}'}"/>
                                        </StackPanel>
                                        <!-- A dock, not a horizontal stack: a long trust wraps before the buttons instead of running under them. -->
                                        <DockPanel VerticalAlignment="Center">
                                            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding TrustTone, Converter={StaticResource Memory.ToneToBrush}}"/>
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" Text="{Binding TrustLabel}"/>
                                        </DockPanel>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Topic, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding OriginLabel, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Created, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Id, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{Binding Content}"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Source, StringFormat='Fuente: {0}'}"/>
                                    <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding Match, TargetNullValue=''}"/>
                                    <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding Superseded, TargetNullValue=''}"/>
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}" Text="{Binding Pending}"
                                               Visibility="{Binding Pending, Converter={StaticResource Memory.NotNullToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <!-- A text the system wrote from an entry of the verified log: trusted and read-only. -->
                        <DataTemplate DataType="{x:Type memory:LogFragmentViewModel}">
                            <Border Style="{StaticResource InnerCard}" Padding="10,8" AutomationProperties.Name="{Binding TrustLabel}">
                                <StackPanel>
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding TrustTone, Converter={StaticResource Memory.ToneToBrush}}"/>
                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding TrustLabel}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding OriginLabel, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Created, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Id, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{Binding Content}"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Source, StringFormat='Fuente: {0}'}"/>
                                    <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding Match}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="12,10,12,12">
                        <views:EmbeddingModelView DataContext="{Binding Model}"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                            <views:JournalTrustView DataContext="{Binding Journal}"/>
                        </Border>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                            <views:DailySummaryView DataContext="{Binding Summary}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
