<UserControl x:Class="AgentStudio.Desktop.Views.Memory.JournalTrustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:memory="clr-namespace:AgentStudio.Desktop.Memory"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=memory:JournalTrustViewModel}">
    <!-- «Bitácora» (docs/17 D-02): what Agent Studio wrote is trusted by its match with the log; the rest waits in quarantine
         until the person accepts it one by one (in the list), by days or for the whole project. Each decision goes to the
         log and can be withdrawn; during a run it waits in the queue. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Journal.BoolToVisibility"/>
        <orchestratorViews:ToneToBrushConverter x:Key="Journal.ToneToBrush"/>
        <orchestratorViews:NullToVisibilityConverter x:Key="Journal.NotNullToVisibility"/>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource SectionTitleText}" Text="Bitácora"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,6" TextWrapping="Wrap" Text="{x:Static memory:JournalTrustViewModel.Explanation}"/>
        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding StateText}"
                   AutomationProperties.Name="Confianza en la bitácora" AutomationProperties.LiveSetting="Polite"/>

        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsAvailable, Converter={StaticResource Journal.BoolToVisibility}}">
            <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Content="{Binding ProjectActionLabel}"
                    Command="{Binding ToggleProjectCommand}" AutomationProperties.Name="{Binding ProjectActionLabel}"
                    AutomationProperties.HelpText="{Binding ProjectActionHelp}"/>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding ProjectActionHelp}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,10,0,2" Text="Por días"
                   Visibility="{Binding HasDays, Converter={StaticResource Journal.BoolToVisibility}}"/>
        <ItemsControl ItemsSource="{Binding Days}" Focusable="False" AutomationProperties.Name="Días de la bitácora">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type memory:JournalDayViewModel}">
                    <DockPanel Margin="0,2,0,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{Binding ActionLabel}"
                                Command="{Binding DataContext.ToggleDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding ActionName}"/>
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Tone, Converter={StaticResource Journal.ToneToBrush}}"/>
                        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run Text="{Binding DayText, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="·"/>
                            <Run Text="{Binding Summary, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Text="{Binding Pending}"
                   Visibility="{Binding Pending, Converter={StaticResource Journal.NotNullToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Style="{StaticResource ErrorText}" TextWrapping="Wrap" Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
</UserControl>
