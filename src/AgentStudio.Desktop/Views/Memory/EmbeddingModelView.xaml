<UserControl x:Class="AgentStudio.Desktop.Views.Memory.EmbeddingModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:memory="clr-namespace:AgentStudio.Desktop.Memory"
             xmlns:orchestratorViews="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=memory:EmbeddingModelViewModel}">
    <!-- «Búsqueda por significado» (docs/17 D-03 and D-06, F12-6): the state of the local model and of the index of the
         project, and the download of the model. «Descargar el modelo de búsqueda» only opens the confirmation, which says
         what is downloaded, from where, its size, where it is kept and how it is checked; only «Descargar» there reaches the
         network. The download shows its progress and can be cancelled. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Model.BoolToVisibility"/>
        <orchestratorViews:ToneToBrushConverter x:Key="Model.ToneToBrush"/>
        <orchestratorViews:NullToVisibilityConverter x:Key="Model.NotNullToVisibility"/>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Memory_Model_Title}"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,6" TextWrapping="Wrap"
                   Text="{l:T Memory_Model_Intro}"/>
        <DockPanel>
            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,8,0" VerticalAlignment="Top"
                     Fill="{Binding StatusTone, Converter={StaticResource Model.ToneToBrush}}"/>
            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding StatusText}"
                       AutomationProperties.Name="{l:T Memory_Model_StateName}" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>

        <Button Style="{StaticResource ToolbarPrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                Content="{Binding DownloadLabel}" Command="{Binding AskDownloadCommand}"
                Visibility="{Binding CanDownload, Converter={StaticResource Model.BoolToVisibility}}"
                AutomationProperties.Name="{Binding DownloadLabel}"
                AutomationProperties.HelpText="{l:T Memory_Model_DownloadHelp}"/>

        <!-- The confirmation: nothing has been downloaded, and nothing will be until «Descargar». -->
        <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,8,0,0"
                Visibility="{Binding IsConfirming, Converter={StaticResource Model.BoolToVisibility}}"
                AutomationProperties.Name="{Binding ConfirmationTitle}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ConfirmationTitle}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding WhatText}"/>
                <ItemsControl Margin="8,4,0,0" ItemsSource="{Binding Files}" Focusable="False" AutomationProperties.Name="{l:T Memory_Model_FilesName}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type memory:ModelFileLine}">
                            <StackPanel Margin="0,2,0,2">
                                <TextBlock Style="{StaticResource BodyText}">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                    <Run Text="·"/>
                                    <Run Text="{Binding Size, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="11" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                                           Text="{Binding Source}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding TotalText}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding FromText}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding WhereText}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding CheckText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource ToolbarPrimaryButton}" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmDownloadCommand}"
                            AutomationProperties.Name="{Binding ConfirmLabel}"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{Binding DeclineLabel}" Command="{Binding DeclineDownloadCommand}"
                            AutomationProperties.Name="{Binding DeclineLabel}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The download, while it goes: how much has arrived, and how to stop it. -->
        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource Model.BoolToVisibility}}">
            <ProgressBar Style="{StaticResource AccentProgress}" IsIndeterminate="False" Height="6" Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}" AutomationProperties.Name="{l:T Memory_Model_ProgressName}"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding ProgressText}"
                       AutomationProperties.LiveSetting="Polite"/>
            <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{l:T Memory_Model_Cancel}"
                    Command="{Binding CancelDownloadCommand}" AutomationProperties.Name="{l:T Memory_Model_CancelName}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Outcome}"
                   Foreground="{Binding OutcomeTone, Converter={StaticResource Model.ToneToBrush}}"
                   Visibility="{Binding Outcome, Converter={StaticResource Model.NotNullToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
