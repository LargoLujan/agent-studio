<UserControl x:Class="AgentStudio.Desktop.Views.UnsavedChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:services="clr-namespace:AgentStudio.Desktop.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=services:UnsavedChangesPromptViewModel}"
             Width="520" UseLayoutRounding="True"
             AutomationProperties.Name="{l:T UnsavedView_Name}">
    <!-- The question about unsaved edits (WpfUnsavedChangesPrompt). Esc and Enter are «Cancelar» («Volver»): nothing changes.
         «Guardar» only when every document can be saved from here. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Unsaved.BoolToVisibility"/>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}" Padding="20,18">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Intro}"/>

            <Border Style="{StaticResource InnerCard}" Padding="12,8" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding Listed}" Focusable="False" AutomationProperties.Name="{l:T UnsavedView_ListName}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0" Text="{Binding Question}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{Binding SaveText}"
                        Visibility="{Binding CanSave, Converter={StaticResource Unsaved.BoolToVisibility}}"
                        Command="{Binding ChooseCommand}" CommandParameter="{x:Static services:UnsavedChangesChoice.Save}"/>
                <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{Binding DiscardText}"
                        Command="{Binding ChooseCommand}" CommandParameter="{x:Static services:UnsavedChangesChoice.Discard}"/>
                <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{Binding CancelText}" IsCancel="True" IsDefault="True"
                        Command="{Binding ChooseCommand}" CommandParameter="{x:Static services:UnsavedChangesChoice.Cancel}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
