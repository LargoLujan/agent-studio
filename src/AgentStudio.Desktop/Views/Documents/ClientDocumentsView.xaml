<UserControl x:Class="AgentStudio.Desktop.Views.Documents.ClientDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:documents="clr-namespace:AgentStudio.Desktop.Documents"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=documents:ClientDocumentsViewModel}">
    <!-- «Documentación para clientes» (docs/17 D-58 to D-60): milestone, language and formats; the preview in Markdown; the list of
         what goes out (secrets redacted, paths removed, parts written by agents, risks); and «Aprobar y exportar», which is only
         offered once the person approved what they reviewed. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Documents.BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource SurfaceBrush}">
        <StackPanel Margin="16">
            <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Documents_Title}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{l:T Documents_Intro}" Margin="0,0,0,12"/>

            <WrapPanel Margin="0,0,0,8">
                <StackPanel Margin="0,0,16,8" MinWidth="240">
                    <TextBlock x:Name="MilestoneLabel" Style="{StaticResource SecondaryText}" Text="{l:T Documents_Milestone_Label}"/>
                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Milestone, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{l:T Documents_Milestone_Hint}"
                             AutomationProperties.Name="{l:T Documents_Milestone_Label}" AutomationProperties.LabeledBy="{Binding ElementName=MilestoneLabel}"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,8" MinWidth="180">
                    <TextBlock x:Name="LanguageLabel" Style="{StaticResource SecondaryText}" Text="{l:T Documents_Language_Label}"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="NativeName"
                              AutomationProperties.Name="{l:T Documents_Language_Label}" AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{l:T Documents_Formats_Label}"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Margin="0,4,12,0" Content="{l:T Documents_Format_Markdown}" IsChecked="{Binding ExportMarkdown}"
                                  Visibility="{Binding HasMarkdown, Converter={StaticResource Documents.BoolToVisibility}}"/>
                        <CheckBox Margin="0,4,12,0" Content="{l:T Documents_Format_Html}" IsChecked="{Binding ExportHtml}"
                                  Visibility="{Binding HasHtml, Converter={StaticResource Documents.BoolToVisibility}}"/>
                        <CheckBox Margin="0,4,12,0" Content="{l:T Documents_Format_Pdf}" IsChecked="{Binding ExportPdf}"
                                  Visibility="{Binding HasPdf, Converter={StaticResource Documents.BoolToVisibility}}"/>
                        <CheckBox Margin="0,4,12,0" Content="{l:T Documents_Format_Word}" IsChecked="{Binding ExportWord}"
                                  Visibility="{Binding HasWord, Converter={StaticResource Documents.BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>

            <DockPanel Margin="0,0,0,12" LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Content="{l:T Documents_Destination_Choose}"
                        Command="{Binding ChooseFolderCommand}"/>
                <TextBlock x:Name="DestinationLabel" DockPanel.Dock="Top" Style="{StaticResource SecondaryText}" Text="{l:T Documents_Destination_Label}"/>
                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{l:T Documents_Destination_Label}" AutomationProperties.LabeledBy="{Binding ElementName=DestinationLabel}"/>
            </DockPanel>

            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12" Content="{l:T Documents_Generate}"
                    Command="{Binding GenerateCommand}"/>

            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding StatusMessage, TargetNullValue=''}"/>
            <TextBlock Style="{StaticResource ErrorText}" TextWrapping="Wrap" Text="{Binding ErrorMessage, TargetNullValue=''}" Margin="0,0,0,8"/>

            <Border Style="{StaticResource Card}" Padding="12" Margin="0,8,0,12"
                    Visibility="{Binding HasPreview, Converter={StaticResource Documents.BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Documents_Disclosure_Heading}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding SecretsText}"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding PathsText}"/>
                    <ItemsControl ItemsSource="{Binding PathsRemoved}" Margin="12,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding AgentsText}"/>
                    <ItemsControl ItemsSource="{Binding AgentParts}" Margin="12,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding RisksText}"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding ConsumptionText}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{l:T Documents_NotIncluded}"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Documents_Preview_Heading}" Margin="0,0,0,6"/>
            <TextBox Style="{StaticResource MonoViewer}" Text="{Binding Preview, Mode=OneWay}" TextWrapping="Wrap" MinHeight="260" MaxHeight="520"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{l:T Documents_Preview_Heading}"/>

            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0" Text="{l:T Documents_Status_Approval}"
                       Visibility="{Binding HasPreview, Converter={StaticResource Documents.BoolToVisibility}}"/>
            <CheckBox Margin="0,4,0,8" Content="{l:T Documents_Approve_Label}" IsChecked="{Binding Approved}"
                      Visibility="{Binding HasPreview, Converter={StaticResource Documents.BoolToVisibility}}"/>
            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Content="{l:T Documents_Export}"
                    Command="{Binding ExportCommand}"/>
            <ItemsControl ItemsSource="{Binding ExportedFiles}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
