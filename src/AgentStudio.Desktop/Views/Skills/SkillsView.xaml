<UserControl x:Class="AgentStudio.Desktop.Views.Skills.SkillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:skills="clr-namespace:AgentStudio.Desktop.Skills"
             xmlns:layout="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=skills:SkillsDocumentViewModel}"
             Background="{StaticResource BackgroundBrush}">
  <!-- The «Skills» document (docs/14 D-26 and D-29, docs/10 section 8): the tree of sectors, the card of the selected skill
       with its switches, health and cost, and the two recommendations. Bindings only; it uses the tokens of Dark.xaml and
       defines here what else it needs, so it renders with the base theme alone. -->
  <UserControl.Resources>
    <Style x:Key="Skills.OptionalText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
        <Trigger Property="Text" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Skills.WarningText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
      <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>

    <Style x:Key="Skills.OptionalWarningText" TargetType="TextBlock" BasedOn="{StaticResource Skills.WarningText}">
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
        <Trigger Property="Text" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <BooleanToVisibilityConverter x:Key="Skills.BoolToVisibility"/>

    <!-- «Ver el detalle»: a toggle with the look of the secondary buttons, from the tokens of Dark.xaml only. -->
    <Style x:Key="Skills.DetailToggle" TargetType="ToggleButton">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource {x:Static SystemParameters.FocusVisualStyleKey}}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Skills.SectionText" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleText}">
      <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>

    <!-- The health of a skill: green (sana), amber (aviso), red (crítico), grey (sin comprobar). -->
    <Style x:Key="Skills.HealthDot" TargetType="Ellipse">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Height" Value="9"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Fill" Value="{StaticResource BorderStrongBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding HealthStatus}" Value="Healthy">
          <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding HealthStatus}" Value="Warning">
          <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding HealthStatus}" Value="Critical">
          <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Skills.CheckDot" TargetType="Ellipse" BasedOn="{StaticResource Skills.HealthDot}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Healthy">
          <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Warning">
          <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Critical">
          <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Skills.Field" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource {x:Static SystemParameters.FocusVisualStyleKey}}"/>
    </Style>

    <!-- The box of the access key of GitHub: it shows dots, and what is typed is read once, by the click of «Guardar», and emptied. -->
    <Style x:Key="Skills.PasswordField" TargetType="PasswordBox">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource {x:Static SystemParameters.FocusVisualStyleKey}}"/>
    </Style>

    <Style x:Key="Skills.Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A recommended skill: the whole row shows it in the tree. -->
    <Style x:Key="Skills.ItemButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource {x:Static SystemParameters.FocusVisualStyleKey}}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,6">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="Skills.RecommendationTemplate" DataType="{x:Type skills:SkillRecommendationItemViewModel}">
      <Button Style="{StaticResource Skills.ItemButton}" Command="{Binding ShowCommand}"
              AutomationProperties.Name="{Binding Name}" ToolTip="{l:T Skills_View_ShowCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}"/>
          <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Detail}"/>
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="Skills.WarningTemplate">
      <TextBlock Style="{StaticResource Skills.WarningText}" Text="{Binding}"/>
    </DataTemplate>

    <!-- The card of the selected skill. -->
    <DataTemplate DataType="{x:Type skills:SkillDetailViewModel}">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="{l:T Skills_View_HealthName}">
            <Ellipse Style="{StaticResource Skills.HealthDot}" Margin="0,0,6,0"/>
            <TextBlock Style="{StaticResource BodyText}" Text="{Binding HealthLabel}"/>
          </StackPanel>
          <TextBlock Style="{StaticResource TitleText}" FontSize="18" Text="{Binding Name}"/>
        </DockPanel>
        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding SectorTitle}"/>
        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0" Text="{Binding Summary}"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" FontFamily="{StaticResource MonoFont}" Text="{Binding SourceText}"
                   AutomationProperties.Name="{l:T Skills_View_SourceName}"/>
        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding ModeText}"/>
        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" Text="{Binding TagsText}" AutomationProperties.Name="{l:T Skills_View_Tags}"/>
        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource Skills.WarningTemplate}" Focusable="False"/>

        <TextBlock Style="{StaticResource Skills.SectionText}" Text="{l:T Skills_View_Activation}"/>
        <ItemsControl ItemsSource="{Binding Scopes}" Focusable="False" AutomationProperties.Name="{l:T Skills_View_ActivationName}">
          <ItemsControl.ItemTemplate>
            <!-- One line when the card is wide; narrower, what is in effect goes under it instead of in a sliver (V29). -->
            <DataTemplate DataType="{x:Type skills:SkillScopeViewModel}">
              <WrapPanel Margin="0,0,0,6">
                <CheckBox MinWidth="190" Style="{StaticResource Skills.Switch}" Content="{Binding Title}"
                          IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding CanToggle}" Command="{Binding ToggleCommand}"
                          AutomationProperties.Name="{Binding Title}"
                          AutomationProperties.HelpText="{l:T Skills_View_ActivationHelp}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Width="96" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding DecisionText}"/>
                <TextBlock Style="{StaticResource Skills.OptionalText}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding EffectiveText}"/>
              </WrapPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource SecondaryText}"
                   Text="{l:T Skills_View_ActivationNote}"/>

        <TextBlock Style="{StaticResource Skills.SectionText}" Text="{l:T Skills_View_Cost}"/>
        <TextBlock Style="{StaticResource BodyText}" Text="{Binding CostText}" AutomationProperties.Name="{l:T Skills_View_CostName}"/>

        <TextBlock Style="{StaticResource Skills.SectionText}" Text="{l:T Skills_View_Health}"/>
        <ItemsControl ItemsSource="{Binding Checks}" Focusable="False" AutomationProperties.Name="{l:T Skills_View_HealthChecks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type skills:SkillCheckViewModel}">
              <DockPanel Margin="0,0,0,4">
                <Ellipse DockPanel.Dock="Left" Style="{StaticResource Skills.CheckDot}" Margin="0,4,8,0" VerticalAlignment="Top"/>
                <WrapPanel>
                  <TextBlock Style="{StaticResource BodyText}" Width="150" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource SecondaryText}" Width="96" Text="{Binding StatusLabel}"/>
                  <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Message}"/>
                </WrapPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The scripts of the skill (docs/20 D-14): the list, and the mark that keeps their fingerprint. None is ever run. -->
        <StackPanel Visibility="{Binding HasScripts, Converter={StaticResource Skills.BoolToVisibility}}">
          <TextBlock Style="{StaticResource Skills.SectionText}" Text="{l:T Skills_Scripts_Title}"/>
          <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{l:T Skills_Scripts_Files}"/>
          <!-- As plain text when the screen cannot open a file; as links «abrir» (the file opens in the editor of the app) when it can. -->
          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" Text="{Binding ScriptFilesText}"
                     AutomationProperties.Name="{l:T Skills_Scripts_FilesName}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasScriptLinks}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ScriptLinks}" Focusable="False" AutomationProperties.Name="{l:T Skills_Scripts_FilesName}"
                        Visibility="{Binding HasScriptLinks, Converter={StaticResource Skills.BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type skills:SkillScriptLink}">
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,2" FontFamily="{StaticResource MonoFont}" Content="{Binding Path}"
                        Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding AutomationName}" ToolTip="{l:T Skills_Scripts_OpenTip}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:T Skills_Scripts_Mark}"
                  Command="{Binding MarkScriptsReviewedCommand}" Visibility="{Binding CanMarkScripts, Converter={StaticResource Skills.BoolToVisibility}}"
                  AutomationProperties.Name="{l:T Skills_Scripts_MarkName}"/>
          <TextBlock Style="{StaticResource Skills.OptionalText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ScriptsReviewedText}"/>
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{l:T Skills_Scripts_Note}"/>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <!-- Title, summary and search. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Content="{l:T Skills_View_Reload}" Command="{Binding RefreshCommand}"
                AutomationProperties.Name="{l:T Skills_View_ReloadName}" ToolTip="{l:T Skills_View_ReloadTip}"/>
        <TextBox DockPanel.Dock="Right" Width="300" Style="{StaticResource Skills.Field}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{l:T Skills_View_SearchName}" ToolTip="{l:T Skills_View_SearchTip}"/>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="0,0,8,0" VerticalAlignment="Center" Text="{l:T Skills_View_Search}"/>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Text="{l:T Skills_View_Title}"/>
            <info:InfoButton InfoKey="Info_Skills" Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Summary}" AutomationProperties.Name="{l:T Skills_View_SummaryName}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- What is missing and what the catalog warns about: the few notices in full; the warnings of the index about its entries
         (often dozens) in one line with their count, and their detail on demand in a box of limited height, so the catalog
         below stays in view. -->
    <StackPanel DockPanel.Dock="Top" Margin="16,8,16,0">
      <ItemsControl ItemsSource="{Binding Notices}" ItemTemplate="{StaticResource Skills.WarningTemplate}"
                    Focusable="False" AutomationProperties.Name="{l:T Skills_View_NoticesName}"/>
      <DockPanel>
        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Skills.DetailToggle}" Content="{Binding CatalogWarningsToggleText}"
                      IsChecked="{Binding ShowCatalogWarnings}"
                      Visibility="{Binding HasCatalogWarningDetail, Converter={StaticResource Skills.BoolToVisibility}}"
                      AutomationProperties.Name="{l:T Skills_View_WarningsDetailName}"
                      AutomationProperties.HelpText="{l:T Skills_View_WarningsToggleHelp}"/>
        <TextBlock Style="{StaticResource Skills.OptionalWarningText}" VerticalAlignment="Center" Text="{Binding CatalogWarningsSummary}"
                   AutomationProperties.Name="{l:T Skills_View_WarningsSummaryName}"/>
      </DockPanel>
      <Border Margin="0,4,0,0" Padding="10,6" CornerRadius="6" BorderThickness="1" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}" Visibility="{Binding ShowCatalogWarnings, Converter={StaticResource Skills.BoolToVisibility}}">
        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ItemsControl ItemsSource="{Binding CatalogWarnings}" Focusable="False" AutomationProperties.Name="{l:T Skills_View_WarningsName}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,1" Text="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </StackPanel>

    <!-- V29: three fixed columns (300 + 360 + 380) were cut on the right in a window of 1280 px. The tree takes a share of the
         width between 220 and 320 px; the card and the recommendations go side by side when both get their minimum, and the
         recommendations under the card when not (AdaptiveColumnsPanel): never cut, never a horizontal scroll bar. -->
    <Grid Margin="16,10,16,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="220" MaxWidth="320"/>
        <ColumnDefinition Width="5*"/>
      </Grid.ColumnDefinitions>

      <!-- The tree of sectors. -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
        <TreeView ItemsSource="{Binding Sectors}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{l:T Skills_View_TreeName}">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
              <Setter Property="Padding" Value="2,3"/>
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type skills:SkillSectorNodeViewModel}" ItemsSource="{Binding Skills}">
              <HierarchicalDataTemplate.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                  <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                  <Setter Property="Padding" Value="2,2"/>
                </Style>
              </HierarchicalDataTemplate.ItemContainerStyle>
              <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="NoWrap" Text="{Binding Header}"/>
            </HierarchicalDataTemplate>
            <DataTemplate DataType="{x:Type skills:SkillItemViewModel}">
              <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}">
                <Ellipse Style="{StaticResource Skills.HealthDot}" Margin="0,0,6,0"/>
                <TextBlock Style="{StaticResource BodyText}" TextWrapping="NoWrap" Text="{Binding Name}"/>
                <!-- Where it is active, as a pill that reads on the selection highlight too. -->
                <Border Margin="8,0,0,0" Padding="5,0" VerticalAlignment="Center" CornerRadius="4" BorderThickness="1"
                        Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AccentBrush}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveBadge}" Value="">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Style="{StaticResource BodyText}" FontSize="11" TextWrapping="NoWrap" Text="{Binding ActiveBadge}"/>
                </Border>
              </StackPanel>
            </DataTemplate>
          </TreeView.Resources>
        </TreeView>
      </Border>

      <layout:AdaptiveColumnsPanel x:Name="CardAndRecommendations" Grid.Column="1" Margin="12,0,0,0" FillHeight="True" ColumnSpacing="12" RowSpacing="12">
        <!-- The card of the selected skill. -->
        <Border Style="{StaticResource Card}" MinWidth="320" layout:AdaptiveColumnsPanel.Weight="2" layout:AdaptiveColumnsPanel.RowWeight="3">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
              <TextBlock Text="{l:T Skills_View_Pick}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ContentControl Content="{Binding Detail}" Focusable="False"/>
            </Grid>
          </ScrollViewer>
        </Border>

        <!-- The recommendations and the cost of each agent. -->
        <Border x:Name="RecommendationsCard" Style="{StaticResource Card}" MinWidth="300" layout:AdaptiveColumnsPanel.Weight="1" layout:AdaptiveColumnsPanel.RowWeight="2">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Skills_View_Recommend}"/>
              <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,6" Text="{Binding StackText, StringFormat={l:T Skills_View_Stack}}"
                         AutomationProperties.Name="{l:T Skills_View_StackName}"/>
              <TextBox Style="{StaticResource Skills.Field}" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                       Text="{Binding TaskText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Skills_View_TaskName}"/>
              <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                      Command="{Binding RecommendCommand}" AutomationProperties.Name="{l:T Skills_View_RecommendName}">
                <TextBlock TextWrapping="Wrap" Text="{l:T Skills_View_RecommendButton}"/>
              </Button>
              <TextBlock Style="{StaticResource Skills.OptionalText}" Margin="0,6,0,0" Text="{Binding RecommendationStatus}"/>
              <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Recommendations}" ItemTemplate="{StaticResource Skills.RecommendationTemplate}"
                            Focusable="False" AutomationProperties.Name="{l:T Skills_View_DeterministicName}"/>

              <TextBlock Style="{StaticResource Skills.SectionText}" Text="{l:T Skills_View_Ask}"/>
              <CheckBox Style="{StaticResource Skills.Switch}" IsChecked="{Binding IsAssistedAllowed}" AutomationProperties.Name="{l:T Skills_View_AllowName}">
                <TextBlock TextWrapping="Wrap" Text="{l:T Skills_View_Allow}"/>
              </CheckBox>
              <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                         Text="{l:T Skills_View_AskNote}"/>
              <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:T Skills_View_Ask}"
                      Command="{Binding AskAgentCommand}" AutomationProperties.Name="{l:T Skills_View_Ask}"/>
              <TextBlock Style="{StaticResource Skills.OptionalText}" Margin="0,6,0,0" Text="{Binding AssistedStatus}" AutomationProperties.Name="{l:T Skills_View_AskStatusName}"/>
              <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding AssistedRecommendations}" ItemTemplate="{StaticResource Skills.RecommendationTemplate}"
                            Focusable="False" AutomationProperties.Name="{l:T Skills_View_AssistedName}"/>
              <ItemsControl ItemsSource="{Binding AssistedWarnings}" ItemTemplate="{StaticResource Skills.WarningTemplate}" Focusable="False"/>

              <TextBlock Style="{StaticResource Skills.SectionText}" Text="{l:T Skills_View_PerAgent}"/>
              <ItemsControl ItemsSource="{Binding AgentCosts}" Focusable="False" AutomationProperties.Name="{l:T Skills_View_CostPerAgent}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type skills:AgentCostViewModel}">
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,3" Text="{Binding Text}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource ErrorText}" Margin="0,6,0,0" Text="{Binding ActivationProblem}"/>

              <!-- «Comprobar en GitHub» (docs/20 D-13 to D-15): the only road to the network. Off until the person allows it; it says where it connects and
                   what it sends before the button is pressed. -->
              <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                <TextBlock Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Text="{l:T Skills_Doctor_Title}"/>
                <info:InfoButton InfoKey="Info_SkillsDoctor" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <CheckBox Style="{StaticResource Skills.Switch}" IsChecked="{Binding IsNetworkAllowed}" IsEnabled="{Binding CanChangeNetwork}"
                        AutomationProperties.Name="{l:T Skills_Doctor_AllowName}">
                <TextBlock TextWrapping="Wrap" Text="{l:T Skills_Doctor_Allow}"/>
              </CheckBox>
              <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{l:T Skills_Doctor_Sends}"/>
              <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Content="{l:T Skills_Doctor_Button}"
                        Command="{Binding CheckOnGitHubCommand}" AutomationProperties.Name="{l:T Skills_Doctor_ButtonName}" ToolTip="{l:T Skills_Doctor_ButtonTip}"/>
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding CancelCheckCommand}" AutomationProperties.Name="{l:T Skills_Doctor_CancelName}" ToolTip="{l:T Skills_Doctor_CancelTip}">
                  <TextBlock TextWrapping="Wrap" Text="{l:T Skills_Doctor_Cancel}"/>
                </Button>
              </WrapPanel>
              <TextBlock Style="{StaticResource Skills.OptionalText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding DoctorUnavailable}"/>
              <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding DoctorStatus}"
                         AutomationProperties.Name="{l:T Skills_Doctor_StatusName}"/>

              <StackPanel Visibility="{Binding CanManageToken, Converter={StaticResource Skills.BoolToVisibility}}">
                <TextBlock Style="{StaticResource Skills.SectionText}" Text="{l:T Skills_Token_Title}"/>
                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{l:T Skills_Token_Explain}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{l:T Skills_Token_Hello}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{l:T Skills_Token_Protects}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding TokenStoredText}"
                           AutomationProperties.Name="{l:T Skills_Token_StatusName}"/>
                <PasswordBox x:Name="TokenBox" Style="{StaticResource Skills.PasswordField}" Margin="0,6,0,0" MaxLength="255"
                             AutomationProperties.Name="{l:T Skills_Token_FieldName}" ToolTip="{l:T Skills_Token_FieldTip}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Style="{StaticResource GhostButton}" Content="{l:T Skills_Token_Save}" Click="OnSaveTokenClick"
                          AutomationProperties.Name="{l:T Skills_Token_SaveName}"/>
                  <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{l:T Skills_Token_Delete}" Command="{Binding DeleteTokenCommand}"
                          AutomationProperties.Name="{l:T Skills_Token_DeleteName}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Skills.OptionalText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding TokenStatus}"
                           AutomationProperties.Name="{l:T Skills_Token_StatusName}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </layout:AdaptiveColumnsPanel>
    </Grid>
  </DockPanel>
</UserControl>
