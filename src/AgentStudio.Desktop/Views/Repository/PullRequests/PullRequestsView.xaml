<UserControl x:Class="AgentStudio.Desktop.Views.Repository.PullRequests.PullRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:pr="clr-namespace:AgentStudio.Desktop.Repository.PullRequests"
             xmlns:policies="clr-namespace:AgentStudio.Desktop.Repository.Policies"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pr:PullRequestsViewModel}">
    <!-- «Repositorio y cambios › Peticiones de fusión (PR)» (docs/21 section 7.1 and 7.2): the remote and the session, what is pending, the pull requests the log follows,
         the detail of one with its actions, the cards that say what an action does before its button, and the permissions of publication. An action has a button only when its
         capability is declared and the state admits it. What the remote wrote (a title, a check, an environment) is drawn as data in a text block: never a link, never formatting.
         Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Pr.BoolToVisibility"/>

        <Style x:Key="Pr.Warning" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="Pr.CardLine" DataType="{x:Type pr:CardLine}">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- The parts every card shares: heading, lines, the fixed notice of Windows Hello, an error, and the two buttons. -->
        <DataTemplate x:Key="Pr.CardBody" DataType="{x:Type pr:HostingCardViewModel}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Heading}"/>
                <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource Pr.CardLine}" Focusable="False" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Pr.CardFooter" DataType="{x:Type pr:HostingCardViewModel}">
            <StackPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Pr.Warning}" Text="{Binding HelloNotice, TargetNullValue=''}"
                           Visibility="{Binding HasHelloNotice, Converter={StaticResource Pr.BoolToVisibility}}"/>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error, TargetNullValue=''}" AutomationProperties.LiveSetting="Assertive"
                           Visibility="{Binding HasError, Converter={StaticResource Pr.BoolToVisibility}}"/>
                <WrapPanel Margin="0,6,0,0">
                    <Button Style="{StaticResource ToolbarPrimaryButton}" Margin="0,0,8,0" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                            Visibility="{Binding ShowsConfirm, Converter={StaticResource Pr.BoolToVisibility}}"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{l:T Hosting_Card_Cancel}" Command="{Binding CancelCommand}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type pr:ActionCardViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pr.CardBody}" Focusable="False"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pr.CardFooter}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type pr:ReviewersCardViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pr.CardBody}" Focusable="False"/>
                <TextBlock x:Name="LoginsLabel" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="{l:T Hosting_Reviewers_Logins}"/>
                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding LoginsText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{l:T Hosting_Reviewers_Logins}" AutomationProperties.LabeledBy="{Binding ElementName=LoginsLabel}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pr.CardFooter}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type pr:MergeCardViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pr.CardBody}" Focusable="False"/>
                <TextBlock x:Name="MethodLabel" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="{l:T Hosting_Merge_Method}"/>
                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" HorizontalAlignment="Left" MinWidth="200"
                          AutomationProperties.Name="{l:T Hosting_Merge_Method}" AutomationProperties.LabeledBy="{Binding ElementName=MethodLabel}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pr.CardFooter}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type pr:PublishCardViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pr.CardBody}" Focusable="False"/>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,6,0,0" Text="{Binding CoverageText}"/>
                <TextBlock x:Name="PrTitleLabel" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="{l:T Hosting_Publish_TitleLabel}"/>
                <TextBox Style="{StaticResource FieldTextBox}" MaxLength="256" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{l:T Hosting_Publish_TitleLabel}" AutomationProperties.LabeledBy="{Binding ElementName=PrTitleLabel}"/>
                <TextBlock x:Name="PrBodyLabel" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="{l:T Hosting_Publish_BodyLabel}"/>
                <TextBox Style="{StaticResource FieldTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                         Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{l:T Hosting_Publish_BodyLabel}" AutomationProperties.LabeledBy="{Binding ElementName=PrBodyLabel}"/>
                <CheckBox Margin="0,6,0,0" Content="{l:T Hosting_Publish_Draft}" IsChecked="{Binding OpenAsDraft}"
                          Visibility="{Binding CanOpenAsDraft, Converter={StaticResource Pr.BoolToVisibility}}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pr.CardFooter}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel>
            <info:InfoButton DockPanel.Dock="Right" InfoKey="Info_Hosting_PullRequests" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Hosting_Section_PullRequests}"/>
        </DockPanel>

        <!-- The remote, the session and the last good sync, with «Sincronizar ahora» and «Comprobar la conexión». -->
        <Border Style="{StaticResource InnerCard}" Padding="10,8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding RepositoryText, TargetNullValue=''}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding SessionText, TargetNullValue=''}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding LastSyncText, TargetNullValue=''}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding SyncPolicyText, TargetNullValue=''}"/>
                <StackPanel Visibility="{Binding HasSyncSwitch, Converter={StaticResource Pr.BoolToVisibility}}">
                    <CheckBox Margin="0,4,0,0" Content="{l:T Hosting_Sync_Permission}" IsChecked="{Binding SyncEnabled}" IsEnabled="{Binding HasProject}"
                              AutomationProperties.Name="{l:T Hosting_Sync_Permission}" AutomationProperties.HelpText="{l:T Hosting_Sync_Permission_What}"/>
                    <!-- What switching it on sends out is said in plain sight, not only in a tooltip. -->
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="22,0,0,0" Text="{l:T Hosting_Sync_Permission_What}"/>
                </StackPanel>
                <WrapPanel Margin="0,6,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,0" Content="{l:T Hosting_Header_SyncNow}" Command="{Binding SyncNowCommand}"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{l:T Hosting_Header_Check}" Command="{Binding CheckConnectionCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Pr.Warning}" Margin="0,8,0,0" Text="{Binding GuideText, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding HasGuide, Converter={StaticResource Pr.BoolToVisibility}}"/>
        <TextBlock Style="{StaticResource Pr.Warning}" Margin="0,4,0,0" Text="{Binding OtherRepositoryText, TargetNullValue=''}"
                   Visibility="{Binding HasOtherRepository, Converter={StaticResource Pr.BoolToVisibility}}"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding Message, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding HasMessage, Converter={StaticResource Pr.BoolToVisibility}}"/>
        <TextBlock Style="{StaticResource ErrorText}" Margin="0,4,0,0" Text="{Binding Error, TargetNullValue=''}" AutomationProperties.LiveSetting="Assertive"
                   Visibility="{Binding HasError, Converter={StaticResource Pr.BoolToVisibility}}"/>

        <!-- What waits to be synchronised, with its reason. -->
        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasPending, Converter={StaticResource Pr.BoolToVisibility}}">
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:T Hosting_Pending_Title}"/>
            <ItemsControl ItemsSource="{Binding Pending}" Focusable="False" AutomationProperties.Name="{l:T Hosting_Pending_Title}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pr:PendingLine}">
                        <TextBlock Style="{StaticResource Pr.Warning}" Text="{Binding Text}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Runs with a branch and no pull request: each can be published. -->
        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasPublishableRuns, Converter={StaticResource Pr.BoolToVisibility}}">
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:T Hosting_Runs_Title}"/>
            <ItemsControl ItemsSource="{Binding PublishableRuns}" Focusable="False" AutomationProperties.Name="{l:T Hosting_Runs_Title}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pr:PublishableRunRow}">
                        <DockPanel Margin="0,2,0,2">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{l:T Hosting_Publish_Open}" AutomationProperties.Name="{Binding ButtonName}"
                                    Command="{Binding DataContext.OpenPublishCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    ToolTip="{l:T Hosting_Publish_Button}"/>
                            <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" Text="{Binding Run}"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- The card of an action that is open: it shows what the action does before its button. -->
        <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0" Visibility="{Binding HasCard, Converter={StaticResource Pr.BoolToVisibility}}">
            <ContentControl Content="{Binding Card}" Focusable="False"/>
        </Border>

        <!-- The pull requests the log follows. -->
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Margin="0,10,0,0" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{l:T Hosting_List_Name}" Visibility="{Binding HasRows, Converter={StaticResource Pr.BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type pr:PullRequestRow}">
                    <StackPanel Margin="0,2">
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap">
                            <Run Text="{Binding NumberText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                            <Run Text="{Binding StateText, Mode=OneWay}"/> · <Run Text="{Binding VerdictText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding OriginText}"/>
                        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding MilestoneText}"/>
                        <TextBlock Text="{Binding PublishedText}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalSecondaryText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PublishedIsStale}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding JudgedText}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalSecondaryText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HeadMoved}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding ChecksText}"/>
                        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding ReviewsText}"/>
                        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding DeploymentText}"/>
                        <TextBlock Style="{StaticResource OptionalSecondaryText}" FontFamily="{StaticResource MonoFont}" Text="{Binding EnvironmentText}"/>
                        <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding SyncText}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The detail of the selected pull request, and its actions. -->
        <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0" Visibility="{Binding HasSelection, Converter={StaticResource Pr.BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Detail.Heading, FallbackValue=''}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{Binding Detail.BaseText, FallbackValue=''}"/>
                <ItemsControl ItemsSource="{Binding Detail.Rules}" ItemTemplate="{StaticResource Pr.CardLine}" Focusable="False" Margin="0,4,0,0"/>
                <ItemsControl ItemsSource="{Binding Detail.Notes}" ItemTemplate="{StaticResource Pr.CardLine}" Focusable="False"/>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,6,0,0" Text="{l:T Hosting_Detail_FailingChecks}"
                           Visibility="{Binding Detail.HasFailingChecks, FallbackValue={x:Static Visibility.Collapsed}, Converter={StaticResource Pr.BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Detail.FailingChecks}" Focusable="False" AutomationProperties.Name="{l:T Hosting_Detail_FailingChecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SecondaryText}" FontFamily="{StaticResource MonoFont}" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Text="{Binding Detail.OriginalsText, FallbackValue=''}"/>
                <TextBlock Style="{StaticResource OptionalSecondaryText}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Text="{Binding Detail.ResultsText, FallbackValue=''}"/>

                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,6" Content="{l:T Hosting_Action_Chain}" Command="{Binding ShowChainCommand}"
                            Visibility="{Binding CanOpenChain, Converter={StaticResource Pr.BoolToVisibility}}"/>
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,6" Content="{l:T Hosting_Action_Verdict}" Command="{Binding OpenVerdictCardCommand}"
                            Visibility="{Binding Detail.CanPublishVerdict, FallbackValue={x:Static Visibility.Collapsed}, Converter={StaticResource Pr.BoolToVisibility}}"/>
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,6" Content="{l:T Hosting_Action_Update}" Command="{Binding OpenUpdateCardCommand}"
                            Visibility="{Binding Detail.CanUpdate, FallbackValue={x:Static Visibility.Collapsed}, Converter={StaticResource Pr.BoolToVisibility}}"/>
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,6" Content="{l:T Hosting_Action_Reviewers}" Command="{Binding OpenReviewersCardCommand}"
                            Visibility="{Binding Detail.CanRequestReviewers, FallbackValue={x:Static Visibility.Collapsed}, Converter={StaticResource Pr.BoolToVisibility}}"/>
                    <Button Style="{StaticResource ToolbarPrimaryButton}" Margin="0,0,8,6" Content="{l:T Hosting_Action_Merge}" Command="{Binding OpenMergeCardCommand}"
                            Visibility="{Binding Detail.CanMerge, FallbackValue={x:Static Visibility.Collapsed}, Converter={StaticResource Pr.BoolToVisibility}}"/>
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,6" Content="{l:T Hosting_Action_Close}" Command="{Binding OpenCloseCardCommand}"
                            Visibility="{Binding Detail.CanClose, FallbackValue={x:Static Visibility.Collapsed}, Converter={StaticResource Pr.BoolToVisibility}}"/>
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,6" Content="{l:T Hosting_Action_DeleteBranch}" Command="{Binding OpenDeleteBranchCardCommand}"
                            Visibility="{Binding Detail.CanDeleteBranch, FallbackValue={x:Static Visibility.Collapsed}, Converter={StaticResource Pr.BoolToVisibility}}"/>
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,6" Content="{l:T Hosting_Action_Browser}" Command="{Binding OpenInBrowserCommand}"
                            Visibility="{Binding Detail.CanOpenInBrowser, FallbackValue={x:Static Visibility.Collapsed}, Converter={StaticResource Pr.BoolToVisibility}}"/>
                    <Button Style="{StaticResource ToolbarButton}" Margin="0,0,8,6" Content="{l:T Hosting_Action_Unfollow}" Command="{Binding UnfollowCommand}"
                            Visibility="{Binding Detail.CanUnfollow, FallbackValue={x:Static Visibility.Collapsed}, Converter={StaticResource Pr.BoolToVisibility}}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- «Permisos de publicación»: the standing permissions of this project. -->
        <StackPanel Margin="0,12,0,0" Visibility="{Binding Permissions.IsAvailable, Converter={StaticResource Pr.BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="PermissionsToggle" VerticalAlignment="Center" Padding="10,4" Content="{l:T Hosting_Permissions_Title}"/>
                <info:InfoButton InfoKey="Info_Hosting_Permissions" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel DataContext="{Binding Permissions}" Margin="0,6,0,0" Visibility="{Binding IsChecked, ElementName=PermissionsToggle, Converter={StaticResource Pr.BoolToVisibility}}">
                <TextBlock Style="{StaticResource OptionalSecondaryText}" Text="{l:T Hosting_Permissions_Explain}"/>
                <ItemsControl ItemsSource="{Binding Grants}" Focusable="False" AutomationProperties.Name="{l:T Hosting_Permissions_Title}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pr:GrantRow}">
                            <Border Style="{StaticResource InnerCard}" Padding="10,6" Margin="0,4,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{l:T Hosting_Permissions_Revoke}" AutomationProperties.Name="{Binding RevokeName}"
                                            Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding ClassText}"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding WhereText}"/>
                                        <TextBlock Style="{StaticResource SecondaryText}"><Run Text="{Binding WhoText, Mode=OneWay}"/> · <Run Text="{Binding WhenText, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding CanGrant, Converter={StaticResource Pr.BoolToVisibility}}" Margin="0,8,0,0">
                    <TextBlock x:Name="ClassLabel" Style="{StaticResource FieldLabel}" Text="{l:T Hosting_Permissions_Class}"/>
                    <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" HorizontalAlignment="Left" MinWidth="240"
                              AutomationProperties.Name="{l:T Hosting_Permissions_Class}" AutomationProperties.LabeledBy="{Binding ElementName=ClassLabel}"/>
                    <TextBlock x:Name="BaseLabel" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="{l:T Hosting_Permissions_Base}"/>
                    <TextBox Style="{StaticResource FieldTextBox}" HorizontalAlignment="Left" Width="240" Text="{Binding BaseBranchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{l:T Hosting_Permissions_Base}" AutomationProperties.LabeledBy="{Binding ElementName=BaseLabel}"/>
                    <Button Style="{StaticResource ToolbarPrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:T Hosting_Permissions_Give}" Command="{Binding GrantCommand}"/>
                    <TextBlock Style="{StaticResource OptionalSecondaryText}" Margin="0,4,0,0" Text="{l:T Hosting_Merge_Hello_What}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Text="{Binding Note, TargetNullValue=''}" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding HasNote, Converter={StaticResource Pr.BoolToVisibility}}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
