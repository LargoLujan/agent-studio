<UserControl x:Class="AgentStudio.Desktop.Views.Lock.LockScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lock="clr-namespace:AgentStudio.Desktop.Lock"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:orchestrator="clr-namespace:AgentStudio.Desktop.Views.Orchestrator"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=lock:LockScreenViewModel}"
             AutomationProperties.Name="{l:T Lock_Screen_Title}">
    <!-- The lock screen (docs/16 D-13, F8-10). Opaque, so nothing of the interface shows through it; MainWindow puts it in
         place of the content while LockScreenViewModel.IsLocked (the editor and the terminal are WebView2 windows, which no
         WPF layer covers: the content is hidden, not only covered). It says what goes on and what waits, never the content.
         Bindings only. -->
    <UserControl.Resources>
        <orchestrator:NullToVisibilityConverter x:Key="Lock.NotNullToVisibility"/>
        <orchestrator:ToneToBrushConverter x:Key="Lock.ToneToBrush"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="28,24" Margin="24" MinWidth="420" MaxWidth="560"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{StaticResource AccentBrush}"
                           Text="&#xE72E;" AutomationProperties.Name="{l:T Lock_Screen_Icon}"/>
                <TextBlock Style="{StaticResource TitleText}" Margin="0,10,0,0" Text="{l:T Lock_Screen_Title}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding LockedText}"/>

                <TextBlock Style="{StaticResource BodyText}" Margin="0,18,0,0" Text="{Binding RunningText}"
                           AutomationProperties.Name="{l:T Lock_Screen_RunningName}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0" Text="{Binding WaitingText}"
                           AutomationProperties.Name="{l:T Lock_Screen_WaitingName}"/>
                <ItemsControl ItemsSource="{Binding WaitingItems}" Margin="14,4,0,0" Focusable="False"
                              AutomationProperties.Name="{l:T Lock_Screen_ItemsName}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SecondaryText}" FontFamily="{StaticResource MonoFont}" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,18,0,0" Text="{l:T Lock_Screen_Assurance}"/>

                <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource WarningBrush}"
                        Visibility="{Binding HelloAbsentText, Converter={StaticResource Lock.NotNullToVisibility}}">
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource WarningBrush}" Text="{Binding HelloAbsentText}"/>
                </Border>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0" Text="{Binding Message}"
                           Foreground="{Binding MessageTone, Converter={StaticResource Lock.ToneToBrush}}"
                           Visibility="{Binding Message, Converter={StaticResource Lock.NotNullToVisibility}}"
                           AutomationProperties.LiveSetting="Assertive"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="{l:T Lock_Screen_LockWindows}" Command="{Binding LockWindowsCommand}"
                            ToolTip="{l:T Lock_Screen_LockWindowsTip}"/>
                    <Button x:Name="UnlockButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True"
                            Content="{l:T Lock_Screen_Unlock}" Command="{Binding UnlockCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
