<UserControl x:Class="AgentStudio.Desktop.Views.Lock.LockSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lock="clr-namespace:AgentStudio.Desktop.Lock"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=lock:LockSettingsViewModel}"
             AutomationProperties.Name="{x:Static lock:LockSettingsViewModel.Title}">
    <!-- «Windows Hello y bloqueo», a section of «Ajustes» (docs/16 D-13): Hello in the critical approvals and the idle lock.
         Checked before anything is saved, by the «Guardar» of the document; until then the previous ones stay in force.
         Bindings only. -->
    <StackPanel>
        <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static lock:LockSettingsViewModel.Title}"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                   Text="Cuándo confirma Windows Hello que eres tú, y si la interfaz se bloquea sola cuando no la usas."/>

        <!-- A string as the content of a check box never wraps: a wrapping TextBlock does, and the name is set by hand. -->
        <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,14,0,0" IsChecked="{Binding HelloForCriticalApprovals}"
                  AutomationProperties.Name="Pedir Windows Hello en las aprobaciones críticas"
                  AutomationProperties.HelpText="{x:Static lock:LockSettingsViewModel.HelloExplanation}">
            <TextBlock TextWrapping="Wrap" Text="Pedir Windows Hello en las aprobaciones críticas"/>
        </CheckBox>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="22,2,0,0" Text="{x:Static lock:LockSettingsViewModel.HelloExplanation}"/>

        <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,16,0,0" IsChecked="{Binding IdleLockEnabled}"
                  AutomationProperties.Name="Bloquear la interfaz tras un tiempo sin actividad"
                  AutomationProperties.HelpText="{x:Static lock:LockSettingsViewModel.IdleExplanation}">
            <TextBlock TextWrapping="Wrap" Text="Bloquear la interfaz tras un tiempo sin actividad"/>
        </CheckBox>
        <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
            <TextBox Style="{StaticResource FieldTextBox}" Width="70" Text="{Binding IdleLockMinutesText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Minutos sin actividad antes de bloquear"/>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="8,0,0,0" VerticalAlignment="Center" Text="minutos (de 1 a 1440)"/>
        </StackPanel>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="22,4,0,0" Text="{x:Static lock:LockSettingsViewModel.IdleExplanation}"/>

        <TextBlock Style="{StaticResource ErrorText}" Margin="0,10,0,0" Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
</UserControl>
