<UserControl x:Class="AgentStudio.Desktop.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:vm="clr-namespace:AgentStudio.Desktop.ViewModels"
             xmlns:markdown="clr-namespace:AgentStudio.Desktop.Markdown"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:JournalViewModel}">
    <UserControl.Resources>
        <!-- V31: the journal is Markdown; it is shown read (titles, lists, bold, code, no escapes), never as its raw text. -->
        <markdown:MarkdownToFlowDocumentConverter x:Key="Journal.Markdown"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  SecondaryForeground="{StaticResource TextSecondaryBrush}"
                                                  CodeBackground="{StaticResource SurfaceRaisedBrush}"
                                                  FontFamily="{StaticResource UiFont}"
                                                  CodeFontFamily="{StaticResource MonoFont}"/>
        <BooleanToVisibilityConverter x:Key="Journal.BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{l:T Journal_Refresh}" Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- A long day draws only its latest entries (the layout runs on the UI thread); all of it, as plain text, on demand.
             With «Ver todo» on, a day read again by itself waits for «Recargar» (V32): loading a long day costs about a second. -->
        <StackPanel Grid.Row="1" Margin="12,0,12,8">
            <DockPanel Visibility="{Binding IsTrimmed, Converter={StaticResource Journal.BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{Binding ToggleText}"
                        Command="{Binding TogglePlainTextCommand}"/>
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Text="{Binding TrimNote}"
                           AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
            <DockPanel x:Name="NewEntries" Margin="0,4,0,0" Visibility="{Binding HasNewEntries, Converter={StaticResource Journal.BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{l:T Journal_Reload}"
                        Command="{Binding ReloadPlainTextCommand}" AutomationProperties.Name="{l:T Journal_Reload_Name}"/>
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding NewEntriesNote}"
                           AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </StackPanel>

        <!-- Read-only, with a reading caret like the plain viewer. It prints and finds nothing: Ctrl+P (go to file) and Ctrl+F
             go on to the window. -->
        <RichTextBox x:Name="JournalDocument" Grid.Row="2" Style="{StaticResource ReadingViewer}"
                     markdown:RichTextDocument.Scope="{Binding ReadScope}"
                     markdown:RichTextDocument.Document="{Binding RenderedText, Converter={StaticResource Journal.Markdown}}"
                     Visibility="{Binding ShowReadable, Converter={StaticResource Journal.BoolToVisibility}}"
                     AutomationProperties.Name="{l:T Main_Panel_Journal}">
            <RichTextBox.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Print" CanExecute="LetTheWindowHaveIt"/>
                <CommandBinding Command="ApplicationCommands.Find" CanExecute="LetTheWindowHaveIt"/>
            </RichTextBox.CommandBindings>
        </RichTextBox>

        <TextBox x:Name="JournalText" Grid.Row="2" Style="{StaticResource MonoViewer}" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled"
                 Text="{Binding PlainText, Mode=OneWay}"
                 Visibility="{Binding ShowPlainText, Converter={StaticResource Journal.BoolToVisibility}}"
                 AutomationProperties.Name="{l:T Journal_PlainName}"/>
    </Grid>
</UserControl>
