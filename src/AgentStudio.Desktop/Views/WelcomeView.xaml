<UserControl x:Class="AgentStudio.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:vm="clr-namespace:AgentStudio.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WelcomeDocumentViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Welcome.BoolToVisibility"/>

        <!-- A row of a list that is a button. GhostButton centres its content; a row keeps it to the left, across the row. -->
        <Style x:Key="ListRowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shown only without a project, and only with one. -->
        <Style x:Key="WithoutProject" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProject}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WithProject" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProject}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundBrush}">
        <StackPanel Margin="40,32" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T App_Name}"/>

            <!-- Without a project: open one. -->
            <StackPanel x:Name="StartPanel" Style="{StaticResource WithoutProject}">
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,24" TextWrapping="Wrap"
                           Text="{l:T Welcome_Intro}"/>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Content="{l:T Main_OpenFolder}" Command="{Binding OpenFolderCommand}"/>
            </StackPanel>

            <!-- With a project: its next step (docs/24 §3.2), one button chosen from what the shell reads of it. The ways into
                 each screen are in the activity bar, with their names: this page does not repeat them. -->
            <StackPanel x:Name="ProjectPanel" Style="{StaticResource WithProject}">
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{l:T Welcome_ProjectOpen}"/>
                <TextBlock x:Name="ProjectNameText" Style="{StaticResource SectionTitleText}" Margin="0,2,0,0" Text="{Binding ProjectName}"
                           AutomationProperties.Name="{Binding ProjectName, StringFormat={l:T Main_Project_OpenNamed}}"/>
                <TextBlock Style="{StaticResource SecondaryText}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"
                           Text="{Binding ProjectPathDisplay}"/>

                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,16,0,0" TextWrapping="Wrap" Text="{Binding SetupSuggestion}"
                           Visibility="{Binding HasSetupSuggestion, Converter={StaticResource Welcome.BoolToVisibility}}"
                           AutomationProperties.LiveSetting="Polite"/>

                <Border x:Name="NextStepCard" Style="{StaticResource Card}" Margin="0,24,0,0" DataContext="{Binding NextStep}"
                        Visibility="{Binding DataContext.HasNextStep, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Welcome.BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Welcome_NextStep}"/>
                        <TextBlock x:Name="NextStepReason" Style="{StaticResource BodyText}" Margin="0,6,0,12" Text="{Binding Reason}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="NextStepButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Content="{Binding Action}" Command="{Binding Command}"
                                AutomationProperties.Name="{Binding Action}" AutomationProperties.HelpText="{Binding Reason}"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,16,0,0"
                        Content="{l:T Welcome_OpenOther}" Command="{Binding OpenFolderCommand}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,32,0,12" Text="{l:T Welcome_Recent}"/>
            <TextBlock Text="{l:T Welcome_NoRecent}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentProjects.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl x:Name="RecentProjectsList" ItemsSource="{Binding RecentProjects}" Focusable="False">
                <!-- A screen reader names each entry by its project, not by the type (nor the record) behind it. -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RecentProjectItem}">
                        <Button Style="{StaticResource ListRowButton}"
                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Path}"
                                AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding DisplayPath}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" FontFamily="{StaticResource MonoFont}"
                                           Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
