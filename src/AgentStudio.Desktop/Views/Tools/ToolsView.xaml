<UserControl x:Class="AgentStudio.Desktop.Views.Tools.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:AgentStudio.Desktop.Localization"
             xmlns:info="clr-namespace:AgentStudio.Desktop.Controls.Info"
             xmlns:tools="clr-namespace:AgentStudio.Desktop.Tools"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=tools:ToolsViewModel}"
             AutomationProperties.Name="{l:T Tools_Title}">
    <!-- «Herramientas» (docs/17 D-46, F13-18): what each agent may use, with the risk of each tool, and whether giving it asks Windows Hello.
         It is worked out from the arguments of the real launch. «Dar a un agente…» leads to the inspector, never to another door. -->
    <DockPanel Background="{StaticResource SurfaceBrush}">
        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,4">
            <info:InfoButton DockPanel.Dock="Right" InfoKey="Info_Tools" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="{l:T Tools_Title}"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SecondaryText}" Margin="16,0,16,8" Text="{l:T Tools_Empty}"
                   Visibility="{Binding HasAgents, Converter={StaticResource Orchestrator.FalseToVisibility}}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Groups}" Margin="16,0,16,12" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type tools:ToolGroup}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Title}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Note}"/>
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="{Binding Title}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type tools:ToolRow}">
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6"
                                                AutomationProperties.Name="{Binding AccessibleName}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" VerticalAlignment="Top" Margin="8,0,0,0"
                                                        Content="{l:T Tools_GiveToAgent}"
                                                        Command="{Binding DataContext.GiveToAgentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding GiveName}"
                                                        Visibility="{Binding CanBeGiven, Converter={StaticResource Orchestrator.BoolToVisibility}}"/>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Text="{Binding Name}"/>
                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" TextWrapping="Wrap" Text="{Binding Description}"/>
                                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                                                        <Run Text="{Binding RiskText, Mode=OneWay}"/>
                                                        <Run Text="·"/>
                                                        <Run Text="{Binding HelloText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding AgentsText}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
