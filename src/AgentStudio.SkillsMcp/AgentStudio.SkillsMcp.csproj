<Project Sdk="Microsoft.NET.Sdk">

  <!-- The local, read-only MCP server of the assisted skill recommender (docs/14 D-30). It is the twelfth project and a
       second entry point: Claude Code launches it over stdio from an auxiliary read-only run, and Agent Studio never runs
       it in-process. Like the modules of ADR-0002 it depends only on Application (and, through it, on Domain); no module
       references it. Tests reference it to drive the server over in-memory streams, and Desktop references it only so
       the executable ships next to the app (the Phase 4 integration). Phase 4 P0 owns this file; WP4 owns the rest of
       the folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgentStudio.SkillsMcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentStudio.Application\AgentStudio.Application.csproj" />
  </ItemGroup>

  <!-- The tools of the server are tested directly and over in-memory streams (docs/14 section 8, F4-8). -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentStudio.Tests" />
  </ItemGroup>

</Project>
