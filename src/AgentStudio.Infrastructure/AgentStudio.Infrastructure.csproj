<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgentStudio.Infrastructure</RootNamespace>
    <!-- Required by the LibraryImport source generator (Job Object and ConPTY P/Invoke). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentStudio.Application\AgentStudio.Application.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!-- The local embeddings of the semantic index (Phase 12, docs/17 D-03; ADR-0047): ONNX Runtime and the SentencePiece
       tokenizer, used only by Embeddings/Onnx (WP2). The model itself is never part of the build: it is downloaded once,
       with the user's OK, to %LOCALAPPDATA%\AgentStudio\models. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
  </ItemGroup>

  <!-- Word (.docx) of the documents for clients (Phase 14, docs/17 D-59; ADR-0057): the Open XML SDK, MIT, used only by Documents/Docx. -->
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <!-- DPAPI of the token of GitHub (Phase 6, docs/20 D-15; ADR-0063): the vault of WP-S, MIT, used only by Security/DpapiCredentialVault. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <!-- The seam of the tests of the remote executor of git (Phase 10, docs/21 D-06): RemoteTransport and the constructor of RemoteGitRunner that takes one are internal. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentStudio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Schema\*.sql" LogicalName="AgentStudio.Schema.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
