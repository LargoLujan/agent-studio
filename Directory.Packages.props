<Project>
  <!-- Central package versions. Versions verified on nuget.org on 2026-10-15
       (see docs/investigacion/2026-10-15-proveedores-y-stack.md). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Dirkster.AvalonDock" Version="5.0.1" />
    <PackageVersion Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!-- Test-only fakes (FakeTimeProvider). Latest stable on nuget.org on 2026-10-15; license MIT (nuspec expression). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- MCP server of the assisted skill recommender (Phase 4, docs/14 D-30). Verified on nuget.org on 2026-10-18: 2.2.0 is
         the latest stable (listed, published 2026-08-13, no deprecation nor known vulnerability); license Apache-2.0
         (nuspec expression), same for ModelContextProtocol.Core; assets for netstandard2.0, net8.0, net9.0 and net10.0.
         On net10.0 it only brings ModelContextProtocol.Core 2.2.0, Microsoft.Extensions.AI.Abstractions 10.8.3 (MIT) and
         Microsoft.Extensions.{Caching,Hosting,Logging}.Abstractions 10.0.10, below the pins above. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <!-- Local embeddings of the semantic index (Phase 12, docs/17 D-03; ADR-0047). Verified on nuget.org on 2026-10-30:
         Microsoft.ML.OnnxRuntime 1.31.1 is the latest stable (listed, published 2026-10-28, no deprecation nor known
         vulnerability); its license is the MIT text shipped in the package (LICENSE, a file, not an SPDX expression),
         like its only dependency Microsoft.ML.OnnxRuntime.Managed 1.31.1 (net8.0 asset; brings System.Numerics.Tensors
         9.0.0, MIT). The package carries the native onnxruntime.dll of every runtime it supports.
         Microsoft.ML.Tokenizers 2.0.1 is the latest stable (published 2026-10-15; 3.0 is a preview); license MIT
         (nuspec expression); net8.0 asset; on net10.0 it only brings Google.Protobuf 3.30.2 (BSD-3-Clause). -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <!-- Node editor canvas (Phase 3, WP6). Latest stable on nuget.org on 2026-10-15; license MIT (nuspec expression);
         ships a net10.0-windows7.0 asset group. -->
    <PackageVersion Include="Nodify" Version="7.3.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- Word (.docx) of the documents for clients (Phase 14, docs/17 D-59; ADR-0057). Verified on nuget.org on 2026-11-11:
         3.5.1 is the latest stable (listed, published 2026-03-18, no later stable version, no deprecation in its catalog
         entry); license MIT (nuspec expression), by Microsoft (github.com/dotnet/Open-XML-SDK). It has net10.0 and net8.0
         asset groups and, on net10.0, only brings DocumentFormat.OpenXml.Framework 3.5.1 (MIT) and System.IO.Packaging
         10.0.2. The vulnerability feed of nuget.org of that day has no advisory for any of the three (those of
         System.IO.Packaging stop at 6.0.0, 8.0.0 and 9.0.0-rc.1). Only the version is pinned here: the project that writes the
         .docx (Infrastructure, WP-14D) references it. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
