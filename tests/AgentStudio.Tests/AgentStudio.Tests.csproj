<Project Sdk="Microsoft.NET.Sdk">

  <!-- The same Windows SDK as AgentStudio.Desktop (docs/16 D-13): a project cannot reference one that targets a later
       version of the platform. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>AgentStudio.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real CLI outputs used by the provider adapter tests (see Providers/Fixtures/README.md). -->
    <None Include="Providers/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Phase 3 fixtures (real TRX/JUnit reports, git scenarios): Orchestration/Fixtures and Orchestration/<area>/Fixtures. -->
    <None Include="Orchestration/**/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Phase 4 fixtures (docs/14 section 8): sample journals and golden exports of memory, usage and the MCP server,
         in a Fixtures folder anywhere under each area, so no package of the phase has to touch this file. -->
    <None Include="Application/**/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Memory/**/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Observability/**/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SkillsMcp/**/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Phase 12 fixtures (docs/17 section 9.2): the question set of the hybrid search, sample journals and the reference
         vectors of the embedder, so no package of the phase has to touch this file. -->
    <None Include="Domain/**/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Infrastructure/**/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Integration/**/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Phase 6 fixtures (docs/20 section 9.2): the sample solution of Auto Graph, the sample repositories of the declared
         environment and the recorded outputs of the doctor, in a Fixtures folder under GraphWorker, Infrastructure and Domain
         (the last two are copied above). The sample solution has C# that must never be compiled with the tests: no .cs file
         under a Fixtures folder of those three areas is part of the compilation (none exists there today). -->
    <None Include="GraphWorker/**/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="GraphWorker/**/Fixtures/**/*.cs;Infrastructure/**/Fixtures/**/*.cs;Domain/**/Fixtures/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentStudio.Desktop\AgentStudio.Desktop.csproj" />
    <!-- The MCP server is a second entry point that Desktop does not compose (docs/14 D-30): its tools are tested here. -->
    <ProjectReference Include="..\..\src\AgentStudio.SkillsMcp\AgentStudio.SkillsMcp.csproj" />
    <!-- The analysis process of Auto Graph is another entry point that Desktop does not compose (docs/20 D-18): it is tested here. -->
    <ProjectReference Include="..\..\src\AgentStudio.GraphWorker\AgentStudio.GraphWorker.csproj" />
  </ItemGroup>

</Project>
